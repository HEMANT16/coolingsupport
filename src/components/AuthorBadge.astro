---
// src/components/AuthorBadge.astro
interface Props {
  name: string;
  role: string;
  image: string;
  date: string;
}

const { name, role, image, date } = Astro.props;
---

<div class="not-prose flex items-center justify-between py-4 border-y border-slate-200 dark:border-slate-800 my-6 bg-slate-50 dark:bg-slate-900/50 px-4 rounded-xl print:hidden">
  <div class="flex items-center gap-3">
    <img 
      src={image} 
      alt={`Photo of ${name}`} 
      class="w-12 h-12 rounded-full object-cover shadow-sm border-2 border-white dark:border-slate-800"
    />
    <div>
      <div class="flex items-center gap-2">
        <a href="/about-us/" class="font-bold text-slate-900 dark:text-white hover:text-blue-600 dark:hover:text-blue-400 transition-colors">
          {name}
        </a>
        <span class="bg-blue-100 text-blue-800 dark:bg-blue-900/30 dark:text-blue-300 text-xs px-2 py-0.5 rounded-full font-medium">
          Expert Review
        </span>
      </div>
      <p class="text-sm text-slate-500 dark:text-slate-400 font-medium">{role}</p>
    </div>
  </div>
  <div class="hidden sm:block text-right">
    <p class="text-xs text-slate-500 dark:text-slate-400">Last Edited</p>
    <p class="text-sm font-semibold text-slate-700 dark:text-slate-300">{date}</p>
  </div>
</div>
