---
import Layout from '../layouts/Layout.astro';
import SEO from '../components/SEO.astro';

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "Cooling Support",
    "url": "https://coolingsupport.com",
    "description": "Provider of professional HVAC, refrigeration, and business calculators.",
    "founder": [
      {
        "@type": "Person",
        "name": "Hemant"
      },
      {
        "@type": "Person",
        "name": "Mike Reynolds"
      }
    ]
  }
];
---

<Layout title="About Us">
  <SEO 
    slot="head"
    title="About Us | Cooling Support"
    description="Meet the expert team behind Cooling Support. Learn about our mission to provide accurate, transparent HVAC and business calculators for contractors and homeowners."
    schema={schema}
  />

  <div class="min-h-screen bg-slate-50 dark:bg-slate-900 pb-20 border-t border-slate-200 dark:border-slate-800">
    
    <!-- Hero Section -->
    <div class="bg-slate-900 text-white py-20 px-4 sm:px-6 lg:px-8 border-b border-slate-800">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-4xl font-bold tracking-tight sm:text-5xl mb-6 text-slate-50">
          About Cooling Support
        </h1>
        <p class="text-lg text-slate-300 max-w-2xl mx-auto leading-relaxed">
          Our mission is to provide the HVAC industry with accurate, transparent, and seamlessly designed digital tools. No rules of thumb, just solid engineering math.
        </p>
      </div>
    </div>

    <div class="max-w-4xl mx-auto px-4 pt-16 sm:px-6 lg:px-8">

      <!-- Mission Box -->
      <div class="mb-16 bg-white dark:bg-slate-800 p-8 md:p-10 rounded-none border-l-4 border-blue-600 shadow-sm">
        <h2 class="text-2xl font-bold text-slate-900 dark:text-white mb-4 flex items-center gap-3 uppercase tracking-wider text-sm">
          <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
          Our Mission
        </h2>
        <div class="prose prose-blue dark:prose-invert max-w-none text-slate-700 dark:text-slate-300">
          <p>
            The HVAC industry has historically relied on "rules of thumb", handwritten quotes, and guesswork. Whether you are sizing a 5-ton commercial rooftop unit or calculating the true labor burden of a new hire, the math must be accurate.
          </p>
          <p>
            We built Cooling Support to bridge the gap between complex engineering formulas (like ACCA Manual J and ASHRAE standards) and the technician standing in a 130-degree attic. Every calculator on this site is designed to be fast, accurate, and completely free to use.
          </p>
        </div>
      </div>

      <!-- Team Section -->
      <div class="mb-12 border-b border-slate-200 dark:border-slate-700 pb-4">
        <h2 class="text-2xl font-bold text-slate-900 dark:text-white">Our Team</h2>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-20">
        
        <!-- Mike Reynolds (Expert) -->
        <div class="flex flex-col bg-white dark:bg-slate-800 rounded-none shadow-sm border border-slate-200 dark:border-slate-700 transition-all hover:border-blue-400">
          <div class="relative h-64 border-b border-slate-200 dark:border-slate-700">
            <img 
              src="/images/mike-reynolds.png" 
              alt="Mike Reynolds - HVAC Expert" 
              class="w-full h-full object-cover"
            />
          </div>
          <div class="p-6 flex-grow flex flex-col justify-between">
            <div>
              <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-1">Mike Reynolds</h3>
              <p class="text-blue-600 dark:text-blue-400 font-semibold text-sm uppercase tracking-wider mb-4">HVAC Expert</p>
              
              <div class="inline-block bg-slate-100 dark:bg-slate-700 text-slate-700 dark:text-slate-300 text-xs px-2 py-1 border border-slate-200 dark:border-slate-600 font-medium mb-4">
                EPA Section 608 Universal
              </div>
              
              <p class="text-slate-600 dark:text-slate-300 leading-relaxed mb-4 text-sm">
                Mike brings over 7 years of hands-on HVAC/R field experience to Cooling Support. Having spent 5 years working in the United States and 2 years on heavy commercial refrigeration systems in India, Mike deeply understands the global challenges of the trade.
              </p>
              <p class="text-slate-600 dark:text-slate-300 leading-relaxed text-sm">
                He serves as the primary technical advisor. Every formula and calculator on Cooling Support passes through Mike's rigorous verification process to ensure strict compliance with USA codes (ACCA, EPA, and ASHRAE).
              </p>
            </div>
          </div>
        </div>

        <!-- Hemant (Web Developer) -->
        <div class="flex flex-col bg-white dark:bg-slate-800 rounded-none shadow-sm border border-slate-200 dark:border-slate-700 transition-all hover:border-blue-400">
          <div class="relative h-64 border-b border-slate-200 dark:border-slate-700">
            <img 
              src="/images/hemant.png" 
              alt="Hemant - Lead Web Developer" 
              class="w-full h-full object-cover grayscale opacity-90"
            />
          </div>
          <div class="p-6 flex-grow flex flex-col justify-between">
            <div>
              <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-1">Hemant</h3>
              <p class="text-slate-500 dark:text-slate-400 font-semibold text-sm uppercase tracking-wider mb-4">Lead Web Developer</p>
              
              <div class="inline-block bg-slate-100 dark:bg-slate-700 text-slate-700 dark:text-slate-300 text-xs px-2 py-1 border border-slate-200 dark:border-slate-600 font-medium mb-4">
                Full Stack & UI/UX Engineer
              </div>
              
              <p class="text-slate-600 dark:text-slate-300 leading-relaxed mb-4 text-sm">
                Hemant is the technical architect behind the performance of Cooling Support. Specializing in modern web frameworks and static site generation, Hemant ensures that every calculator loads instantly—even on a 3G mobile connection out in the field.
              </p>
              <p class="text-slate-600 dark:text-slate-300 leading-relaxed text-sm">
                By combining complex mathematical algorithms with intuitive, functional interfaces, Hemant has transformed raw HVAC equations into professional-grade digital instruments.
              </p>
            </div>
          </div>
        </div>

      </div>
      
      <!-- Footer Note -->
      <div class="pt-8 border-t border-slate-200 dark:border-slate-800">
        <p class="text-slate-500 dark:text-slate-400 text-xs font-medium uppercase tracking-wider">
          Cooling Support is committed to privacy and security. Calculators process data locally.
        </p>
      </div>

    </div>
  </div>
</Layout>
