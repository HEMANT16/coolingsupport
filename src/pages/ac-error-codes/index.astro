                >
                  {brand.name}
                </button>
              ))}
            </div>

            <!-- Severity Pills -->
            <div class="flex flex-wrap gap-2 items-center">
              <span class="text-xs font-bold text-zinc-500 uppercase tracking-wide mr-2">Severity:</span>
              <button class="filter-severity-btn text-xs font-bold px-4 py-2 rounded-full transition-all cursor-pointer bg-zinc-900 text-white" data-severity="all">All</button>
              <button class="filter-severity-btn text-xs font-bold px-4 py-2 rounded-full transition-all cursor-pointer bg-white text-zinc-600 border border-zinc-200 hover:border-emerald-400" data-severity="diy">DIY Safe</button>
              <button class="filter-severity-btn text-xs font-bold px-4 py-2 rounded-full transition-all cursor-pointer bg-white text-zinc-600 border border-zinc-200 hover:border-amber-400" data-severity="technician">Technician Advised</button>
              <button class="filter-severity-btn text-xs font-bold px-4 py-2 rounded-full transition-all cursor-pointer bg-white text-zinc-600 border border-zinc-200 hover:border-rose-400" data-severity="danger">Danger / Urgent</button>
            </div>
          </div>

          <div class="flex items-center justify-between border-t border-zinc-100 pt-4">
