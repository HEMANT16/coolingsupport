                  <span class={`w-1.5 h-1.5 rounded-full ${
                    item.color === 'emerald' ? 'bg-emerald-500' :
                    item.color === 'amber' ? 'bg-amber-500' :
                    item.color === 'orange' ? 'bg-orange-500' :
                    'bg-rose-600'
