  { code: "CH02", brand: "LG", category: "Sensor", severity: "technician", severityText: "Technician Advised", color: "amber", desc: "Indoor coil temperature sensor fault", cause: "Evaporator coil NTC thermistor failed, broken, or disconnected.", action: "Replace evaporator coil sensor. Estimated cost: ₹300 – ₹500 / $25 – $45." },
