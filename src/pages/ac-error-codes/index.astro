  { code: "E1", brand: "Haier", category: "Sensor", severity: "technician", severityText: "Technician Advised", color: "amber", desc: "Room temperature sensor failure", cause: "NTC sensor failed or unplugged from PCB.", action: "Replace room air sensor: ₹300 – ₹500 / $20 – $35." },
  { code: "E7", brand: "Haier", category: "Communication", severity: "technician", severityText: "Call Technician", color: "orange", desc: "Communication fault between indoor & outdoor units", cause: "Signal wire disconnected or damaged outdoor board.", action: "Test interconnecting line voltages. Replace communication wire or outdoor board: ₹2,500 – ₹6,000 / $150 – $300." },
  { code: "E14", brand: "Haier", category: "Motor", severity: "technician", severityText: "Technician Advised", color: "amber", desc: "Indoor fan motor feedback fault", cause: "Blower motor locked, hall sensor failed, or board connection loose.", action: "Inspect blower fan. Replace indoor fan motor: ₹1,500 – ₹3,500 / $95 – $180." },
  { code: "F11 / F12", brand: "Haier", category: "Electrical", severity: "danger", severityText: "Stop AC — Danger", color: "red", desc: "Compressor startup failure or module protection", cause: "IPM power module overcurrent on outdoor board, or locked compressor rotor.", action: "Turn off power. Measure compressor terminal resistances. Swap outdoor PCB or compressor: ₹5,000 – ₹9,500 / $280 – $550." }
];

// Brand list and their corresponding display colors and counts
const brands = [
  { name: "LG", bg: "bg-red-50 text-red-700 border-red-100", count: errorCodes.filter(c => c.brand === "LG").length },
  { name: "Mitsubishi", bg: "bg-blue-50 text-blue-700 border-blue-100", count: errorCodes.filter(c => c.brand === "Mitsubishi").length },
  { name: "Daikin", bg: "bg-blue-50 text-blue-700 border-blue-100", count: errorCodes.filter(c => c.brand === "Daikin").length },
  { name: "Voltas", bg: "bg-orange-50 text-orange-700 border-orange-100", count: errorCodes.filter(c => c.brand === "Voltas").length },
  { name: "Samsung", bg: "bg-sky-50 text-sky-700 border-sky-100", count: errorCodes.filter(c => c.brand === "Samsung").length },
  { name: "Panasonic", bg: "bg-indigo-50 text-indigo-700 border-indigo-100", count: errorCodes.filter(c => c.brand === "Panasonic").length },
  { name: "Blue Star", bg: "bg-cyan-50 text-cyan-700 border-cyan-100", count: errorCodes.filter(c => c.brand === "Blue Star").length },
  { name: "Carrier", bg: "bg-emerald-50 text-emerald-700 border-emerald-100", count: errorCodes.filter(c => c.brand === "Carrier").length },
  { name: "Trane", bg: "bg-slate-50 text-slate-700 border-slate-200", count: errorCodes.filter(c => c.brand === "Trane").length },
  { name: "Goodman", bg: "bg-amber-50 text-amber-700 border-amber-100", count: errorCodes.filter(c => c.brand === "Goodman").length },
  { name: "Lennox", bg: "bg-lime-50 text-lime-700 border-lime-100", count: errorCodes.filter(c => c.brand === "Lennox").length },
  { name: "Fujitsu", bg: "bg-teal-50 text-teal-700 border-teal-100", count: errorCodes.filter(c => c.brand === "Fujitsu").length },
  { name: "Lloyd", bg: "bg-violet-50 text-violet-700 border-violet-100", count: errorCodes.filter(c => c.brand === "Lloyd").length },
  { name: "Whirlpool", bg: "bg-pink-50 text-pink-700 border-pink-100", count: errorCodes.filter(c => c.brand === "Whirlpool").length },
  { name: "Godrej", bg: "bg-rose-50 text-rose-700 border-rose-100", count: errorCodes.filter(c => c.brand === "Godrej").length },
  { name: "Hitachi", bg: "bg-yellow-50 text-yellow-700 border-yellow-100", count: errorCodes.filter(c => c.brand === "Hitachi").length },
  { name: "Haier", bg: "bg-fuchsia-50 text-fuchsia-700 border-fuchsia-100", count: errorCodes.filter(c => c.brand === "Haier").length }
];

// JSON-LD Dataset and FAQ Schemas
const schemaData = [
  {
    "@context": "https://schema.org",
    "@type": "Dataset",
    "name": "Universal AC Error Code & Fault Directory",
    "description": "Comprehensive fault code lookup database for major air conditioner brands including Daikin, LG, Voltas, Carrier, Trane, Samsung, Panasonic, Lloyd, Rheem, Lennox, Fujitsu, and Gree.",
    "url": "https://coolingsupport.com/ac-error-codes",
    "license": "https://coolingsupport.com/privacy",
    "creator": {
      "@type": "Organization",
      "name": "Cooling Support"
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "What is the most common reason for an AC error code?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "The most common AC error codes are triggered by dirty air filters blocking airflow (causing coil freezing or pressure faults) or loose inter-unit communication wires between the indoor head and outdoor condenser."
        }
      },
      {
        "@type": "Question",
        "name": "How do I reset my AC error code?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "To reset an AC error code, perform a hard power cycle: turn off the main circuit breaker (MCB) or unplug the stabilizer for 3 to 5 minutes. This drains control board capacitors and clears transient system faults."
        }
      },
      {
        "@type": "Question",
        "name": "What does EC mean on an AC digital display?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "The EC fault code indicates refrigerant leakage detection. The system pressure switch has detected a drop in gas charge. Turn off the AC immediately to prevent compressor burnout, and call a technician to repair the leak and recharge."
        }
      }
    ]
  }
];
