<Layout title="AC Error Codes: Air Conditioner Diagnostic Directory">
  <SEO
    slot="head"
    title="AC Error Codes: Air Conditioner Diagnostic Directory | Cooling Support"
    description="Decode error codes on Daikin, LG, Carrier, Trane, Samsung, and 10+ brands instantly. Get likely diagnostic causes, DIY resets, and repair cost guides."
    type="WebApplication"
    schema={schemaData}
  />

  <!-- Hero Section -->
  <section class="relative bg-zinc-950 pt-24 pb-20 border-b border-zinc-800 overflow-hidden">
    <!-- Blue Glow Effect -->
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[900px] h-[400px] opacity-10 pointer-events-none">
      <div class="absolute inset-0 bg-gradient-to-b from-cyan-400 to-transparent blur-[120px] rounded-full"></div>
    </div>
    
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
      <div class="inline-flex items-center gap-2 bg-cyan-500/10 border border-cyan-500/25 text-cyan-400 text-xs font-semibold px-5 py-2 rounded-full mb-6 font-mono">
        🛠️ Live Diagnostic Database · 2026
      </div>
      <h1 class="text-4xl md:text-6xl font-extrabold text-white tracking-tight leading-tight mb-6">
        Universal AC Error Codes <br />
        <span class="text-cyan-400">&amp; Fault Diagnostic Directory</span>
      </h1>
      <p class="text-xl text-zinc-400 max-w-2xl mx-auto leading-relaxed mb-8">
        Search your error code and get the meaning, likely cause, and exact action in seconds. Covers Daikin, LG, Voltas, Samsung, Panasonic, Blue Star, Carrier, and Trane.
      </p>
    </div>
  </section>

  <!-- Main Content Container -->
  <div class="bg-zinc-50 min-h-screen py-12">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      
      <!-- Brand Selection Grid -->
      <div class="bg-white rounded-3xl border border-zinc-200 shadow-sm p-6 sm:p-8">
        <p class="text-xs font-bold text-zinc-500 uppercase tracking-wider mb-5">Jump to Brand Directory</p>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
          {brands.map((brand) => (
            <button
              class={`brand-btn flex items-center justify-between px-4 py-3.5 rounded-2xl border text-sm font-extrabold transition-all hover:shadow-sm cursor-pointer ${brand.bg}`}
              data-brand={brand.name}
            >
              <span>{brand.name}</span>
              <span class="text-xs font-mono font-medium opacity-65 bg-white/50 px-2 py-0.5 rounded-lg">{brand.count} codes</span>
            </button>
          ))}
        </div>
      </div>

      <!-- Severity Explanation Bar -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 bg-white rounded-3xl border border-zinc-200 shadow-sm p-6">
        <div class="flex items-start gap-3 p-4 bg-emerald-50 rounded-2xl border border-emerald-100">
          <span class="w-8 h-8 flex items-center justify-center rounded-xl bg-emerald-500 text-white shrink-0">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path></svg>
          </span>
          <div>
            <p class="font-bold text-emerald-800 text-sm mb-1">DIY Safe</p>
            <p class="text-xs text-emerald-700 leading-relaxed">Clean filters, replace remote batteries, clear drain clog, or perform MCB resets. No tools needed.</p>
          </div>
        </div>

        <div class="flex items-start gap-3 p-4 bg-amber-50 rounded-2xl border border-amber-100">
          <span class="w-8 h-8 flex items-center justify-center rounded-xl bg-amber-500 text-white shrink-0">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
          </span>
          <div>
            <p class="font-bold text-amber-800 text-sm mb-1">Technician Advised</p>
            <p class="text-xs text-amber-700 leading-relaxed">Sensor swap, blower fan issues, PCB capacitor faults. Requires multimeters and components.</p>
