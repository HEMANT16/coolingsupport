      <!-- Collapsible Brand Reset Instructions -->
      <section class="bg-white rounded-3xl border border-zinc-200 shadow-sm p-6 sm:p-8 space-y-6">
        <h2 class="text-2xl font-bold text-zinc-900">How to Manually Reset Your AC</h2>
        <p class="text-sm text-zinc-500">
          Many error codes are caused by temporary voltage sags or chip glitches. Before paying a technician, try a hard reset. Below are brand-specific steps.
        </p>

        <div class="space-y-4">
          <!-- Daikin Reset -->
          <details class="group border border-zinc-100 rounded-2xl p-5 hover:border-zinc-200 transition-all">
            <summary class="flex items-center justify-between font-bold text-zinc-950 cursor-pointer list-none">
              <span class="flex items-center gap-3">
                <span class="w-2.5 h-2.5 rounded-full bg-blue-500"></span>
                Daikin AC Reset Steps
              </span>
              <span class="transition-transform group-open:rotate-180">
                <svg class="w-5 h-5 text-zinc-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
              </span>
            </summary>
            <div class="mt-4 pl-5 text-sm text-zinc-600 space-y-2 leading-relaxed">
              <p>1. <strong>Hard Power Cycle</strong>: Turn off the AC's main circuit breaker (MCB) for exactly 3 minutes.</p>
              <p>2. <strong>Remote Reset</strong>: Point the remote at the unit and press the <strong>CANCEL</strong> button for 5 seconds until you hear a continuous beep.</p>
              <p>3. Restore MCB power and turn the unit ON. Temporary sensor locks should clear.</p>
            </div>
          </details>

          <!-- Mitsubishi Reset -->
          <details class="group border border-zinc-100 rounded-2xl p-5 hover:border-zinc-200 transition-all">
            <summary class="flex items-center justify-between font-bold text-zinc-950 cursor-pointer list-none">
              <span class="flex items-center gap-3">
                <span class="w-2.5 h-2.5 rounded-full bg-blue-500"></span>
                Mitsubishi AC Reset Steps
              </span>
              <span class="transition-transform group-open:rotate-180">
                <svg class="w-5 h-5 text-zinc-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
              </span>
            </summary>
            <div class="mt-4 pl-5 text-sm text-zinc-600 space-y-2 leading-relaxed">
              <p>1. <strong>Isolation Switch / MCB</strong>: Turn off the power switch located near the outdoor unit or flip the AC breaker off.</p>
              <p>2. Keep the power shut off for 3 to 5 minutes to ensure all capacitors discharge completely.</p>
              <p>3. Point the remote control at the indoor unit and press the <strong>POWER</strong> button to turn it off.</p>
              <p>4. Turn the power breaker back on, wait for a beep, then turn the unit ON using the remote control.</p>
            </div>
          </details>

          <!-- LG Reset -->
          <details class="group border border-zinc-100 rounded-2xl p-5 hover:border-zinc-200 transition-all">
            <summary class="flex items-center justify-between font-bold text-zinc-950 cursor-pointer list-none">
              <span class="flex items-center gap-3">
                <span class="w-2.5 h-2.5 rounded-full bg-red-500"></span>
                LG AC Reset Steps
              </span>
              <span class="transition-transform group-open:rotate-180">
                <svg class="w-5 h-5 text-zinc-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
              </span>
            </summary>
            <div class="mt-4 pl-5 text-sm text-zinc-600 space-y-2 leading-relaxed">
              <p>1. Locate your AC stabilizer or MCB and power it off completely.</p>
              <p>2. Keep the power shut for 5 minutes to allow the main capacitor on the outdoor board to drain completely.</p>
              <p>3. Press and hold the power button on the indoor unit's right panel for 5 seconds while power is off.</p>
              <p>4. Turn the breaker back on and start the system with your remote.</p>
            </div>
          </details>

          <!-- Voltas Reset -->
          <details class="group border border-zinc-100 rounded-2xl p-5 hover:border-zinc-200 transition-all">
            <summary class="flex items-center justify-between font-bold text-zinc-950 cursor-pointer list-none">
              <span class="flex items-center gap-3">
                <span class="w-2.5 h-2.5 rounded-full bg-orange-500"></span>
                Voltas AC Reset Steps
              </span>
              <span class="transition-transform group-open:rotate-180">
                <svg class="w-5 h-5 text-zinc-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
              </span>
            </summary>
            <div class="mt-4 pl-5 text-sm text-zinc-600 space-y-2 leading-relaxed">
              <p>1. Unplug the AC power cord or trip the dedicated MCB switch.</p>
              <p>2. Remove the AA batteries from your Voltas remote control for 1 minute to reset the remote's transmitter chip.</p>
              <p>3. Reinsert batteries, restore stabilizer power, and switch on the AC.</p>
            </div>
          </details>

          <!-- Carrier & Trane Reset -->
          <details class="group border border-zinc-100 rounded-2xl p-5 hover:border-zinc-200 transition-all">
            <summary class="flex items-center justify-between font-bold text-zinc-950 cursor-pointer list-none">
              <span class="flex items-center gap-3">
                <span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span>
                Carrier / Trane Furnace Reset Steps
              </span>
              <span class="transition-transform group-open:rotate-180">
                <svg class="w-5 h-5 text-zinc-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
              </span>
            </summary>
            <div class="mt-4 pl-5 text-sm text-zinc-600 space-y-2 leading-relaxed">
              <p>1. <strong>Furnace Board Reset</strong>: Switch off the power toggle switch on the side of the indoor furnace cabinet.</p>
              <p>2. Turn your wall thermostat settings to <strong>OFF</strong>.</p>
              <p>3. Wait 60 seconds, turn the furnace power switch back <strong>ON</strong>, and set your thermostat to Heat/Cool. This clears active lockouts (like Code 13 or 2 Flashes).</p>
            </div>
          </details>

          <!-- Goodman & Lennox Reset -->
          <details class="group border border-zinc-100 rounded-2xl p-5 hover:border-zinc-200 transition-all">
            <summary class="flex items-center justify-between font-bold text-zinc-950 cursor-pointer list-none">
              <span class="flex items-center gap-3">
                <span class="w-2.5 h-2.5 rounded-full bg-amber-500"></span>
                Goodman &amp; Lennox Reset Steps
              </span>
              <span class="transition-transform group-open:rotate-180">
                <svg class="w-5 h-5 text-zinc-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
              </span>
            </summary>
            <div class="mt-4 pl-5 text-sm text-zinc-600 space-y-2 leading-relaxed">
              <p>1. <strong>Goodman</strong>: Flip the power switch on the side of the furnace unit to OFF, or switch off the furnace breaker. Wait 60 seconds, then restore power to clear locks like 1 or 3 Flashes.</p>
              <p>2. <strong>Lennox</strong>: Turn your home thermostat to OFF. Go to your breaker panel and shut off the breakers for both the indoor unit and outdoor unit. Wait 5 minutes to clear control board volatile memory, then power them back on and restart your thermostat.</p>
            </div>
          </details>

          <!-- Fujitsu Reset -->
          <details class="group border border-zinc-100 rounded-2xl p-5 hover:border-zinc-200 transition-all">
            <summary class="flex items-center justify-between font-bold text-zinc-950 cursor-pointer list-none">
              <span class="flex items-center gap-3">
                <span class="w-2.5 h-2.5 rounded-full bg-teal-500"></span>
                Fujitsu AC Reset Steps
              </span>
              <span class="transition-transform group-open:rotate-180">
                <svg class="w-5 h-5 text-zinc-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
              </span>
            </summary>
            <div class="mt-4 pl-5 text-sm text-zinc-600 space-y-2 leading-relaxed">
              <p>1. Power down the AC using the remote control.</p>
              <p>2. Locate the outdoor isolator switch next to the condenser or switch off the dedicated outdoor unit circuit breaker.</p>
              <p>3. Leave the power off for at least 5 minutes. This drains the PCB communication capacitors and resets the inter-unit serial connection.</p>
              <p>4. Turn the power back on and start the AC using the remote control.</p>
            </div>
          </details>

          <!-- Lloyd, Godrej & Whirlpool Reset -->
          <details class="group border border-zinc-100 rounded-2xl p-5 hover:border-zinc-200 transition-all">
            <summary class="flex items-center justify-between font-bold text-zinc-950 cursor-pointer list-none">
              <span class="flex items-center gap-3">
                <span class="w-2.5 h-2.5 rounded-full bg-violet-500"></span>
                Lloyd, Godrej &amp; Whirlpool Reset Steps
              </span>
              <span class="transition-transform group-open:rotate-180">
                <svg class="w-5 h-5 text-zinc-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
              </span>
            </summary>
            <div class="mt-4 pl-5 text-sm text-zinc-600 space-y-2 leading-relaxed">
              <p>1. Switch off the AC main power socket switch or stabilizer switch.</p>
              <p>2. Remove the AA/AAA batteries from your AC remote controller for 2 full minutes to let its internal IC drain and clear settings.</p>
              <p>3. Reinsert remote batteries. Restore stabilizer power, and switch the AC on.</p>
            </div>
          </details>

          <!-- Hitachi & Haier Reset -->
          <details class="group border border-zinc-100 rounded-2xl p-5 hover:border-zinc-200 transition-all">
            <summary class="flex items-center justify-between font-bold text-zinc-950 cursor-pointer list-none">
              <span class="flex items-center gap-3">
                <span class="w-2.5 h-2.5 rounded-full bg-fuchsia-500"></span>
                Hitachi &amp; Haier Reset Steps
              </span>
              <span class="transition-transform group-open:rotate-180">
                <svg class="w-5 h-5 text-zinc-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
              </span>
            </summary>
            <div class="mt-4 pl-5 text-sm text-zinc-600 space-y-2 leading-relaxed">
              <p>1. Power off the system with your remote control.</p>
              <p>2. Trip the main MCB power switch for the air conditioner for 3 minutes.</p>
              <p>3. **Note for Hitachi Float Switch Tripping**: If you see error `01`, simply rebooting will not clear it permanently. You must locate the indoor unit drain line, clean it out, and ensure the drain pan is fully empty before restarting.</p>
              <p>4. Turn the breaker back on and restart the unit.</p>
            </div>
          </details>
        </div>
      </section>

    </div>
  </div>
</Layout>

<script>
  let activeBrand = 'all';
  let activeSeverity = 'all';

  const searchInput = document.getElementById('search-input') as HTMLInputElement | null;
  if (searchInput) {
    const cards = document.querySelectorAll<HTMLElement>('.error-card');
    const showingCountText = document.getElementById('showing-count');
    const noResultsDiv = document.getElementById('no-results');

    // Brand quick jump buttons (header)
    const brandJumpBtns = document.querySelectorAll('.brand-btn');
    brandJumpBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const brand = btn.getAttribute('data-brand');
        if (brand) {
          // Update Brand filter pill state
          const brandPill = document.querySelector(`.filter-brand-btn[data-brand="${brand}"]`) as HTMLElement | null;
          if (brandPill) {
            triggerBrandFilter(brandPill, brand);
          }
          // Scroll down to search section
          document.getElementById('search-section')?.scrollIntoView({ behavior: 'smooth' });
        }
      });
    });

    // Brand filter pills (double filter bar)
    const brandPills = document.querySelectorAll('.filter-brand-btn');
    brandPills.forEach(pill => {
      pill.addEventListener('click', () => {
        const brand = pill.getAttribute('data-brand');
        if (brand) {
          triggerBrandFilter(pill as HTMLElement, brand);
        }
      });
    });

    // Severity filter pills (double filter bar)
    const severityPills = document.querySelectorAll('.filter-severity-btn');
    severityPills.forEach(pill => {
      pill.addEventListener('click', () => {
        const severity = pill.getAttribute('data-severity');
        if (severity) {
          // Remove active class from other severity pills
          severityPills.forEach(p => {
            p.className = 'filter-severity-btn text-xs font-bold px-4 py-2 rounded-full transition-all cursor-pointer bg-white text-zinc-600 border border-zinc-200';
          });

          // Set active class on clicked pill
          if (severity === 'all') {
            pill.className = 'filter-severity-btn text-xs font-bold px-4 py-2 rounded-full transition-all cursor-pointer bg-zinc-900 text-white';
          } else if (severity === 'diy') {
            pill.className = 'filter-severity-btn text-xs font-bold px-4 py-2 rounded-full transition-all cursor-pointer bg-emerald-500 text-white';
          } else if (severity === 'technician') {
            pill.className = 'filter-severity-btn text-xs font-bold px-4 py-2 rounded-full transition-all cursor-pointer bg-amber-500 text-white';
          } else if (severity === 'danger') {
            pill.className = 'filter-severity-btn text-xs font-bold px-4 py-2 rounded-full transition-all cursor-pointer bg-rose-600 text-white';
          }

          activeSeverity = severity;
          filterCards();
        }
      });
    });

    // Search input keyup
    searchInput.addEventListener('input', filterCards);

    function triggerBrandFilter(pillElement: HTMLElement, brand: string) {
      brandPills.forEach(p => {
        p.className = 'filter-brand-btn text-xs font-bold px-4 py-2 rounded-full transition-all cursor-pointer bg-zinc-100 text-zinc-600 border border-zinc-200 hover:border-zinc-400';
      });
      pillElement.className = 'filter-brand-btn text-xs font-bold px-4 py-2 rounded-full transition-all cursor-pointer bg-zinc-900 text-white';
      activeBrand = brand;
      filterCards();
    }

    function filterCards() {
      const query = searchInput ? searchInput.value.toLowerCase().trim() : '';
      let matches = 0;

      cards.forEach(card => {
        const cardBrand = card.getAttribute('data-brand') || '';
        const cardSeverity = card.getAttribute('data-severity') || '';
        const code = card.getAttribute('data-code') || '';
        const desc = card.getAttribute('data-desc') || '';
        const cause = card.getAttribute('data-cause') || '';

        // Check search query matches
        const matchesQuery = query === '' || 
          code.includes(query) || 
          desc.includes(query) || 
          cause.includes(query);

        // Check brand filters
        const matchesBrand = activeBrand === 'all' || cardBrand === activeBrand;

        // Check severity filters
        let matchesSeverity = activeSeverity === 'all';
        if (activeSeverity === 'diy' && cardSeverity === 'diy') matchesSeverity = true;
        if (activeSeverity === 'technician' && (cardSeverity === 'technician' || cardSeverity === 'orange')) matchesSeverity = true;
        if (activeSeverity === 'danger' && cardSeverity === 'danger') matchesSeverity = true;

        if (matchesQuery && matchesBrand && matchesSeverity) {
          card.style.display = 'flex';
          matches++;
        } else {
          card.style.display = 'none';
        }
      });

      if (showingCountText) showingCountText.textContent = String(matches);
      if (noResultsDiv) {
        if (matches === 0) {
          (noResultsDiv as HTMLElement).style.display = 'block';
        } else {
          (noResultsDiv as HTMLElement).style.display = 'none';
        }
      }
    }
  }
</script>
