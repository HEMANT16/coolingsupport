  { code: "08", brand: "Hitachi", category: "Refrigerant", severity: "danger", severityText: "Stop AC — Danger", color: "red", desc: "Abnormal compressor discharge temperature (Overheat)", cause: "Severe refrigerant leak, blocked expansion capillary, or compressor valve failure.", action: "Stop using the AC. A technician must check for gas leaks and expansion device blockages." },

