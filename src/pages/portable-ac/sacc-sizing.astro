---
import Layout from '../../layouts/Layout.astro';
import SEO from '../../components/SEO.astro';

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "Portable AC SACC Sizing Calculator",
    "description": "Calculate the real-world DOE SACC BTU rating your portable air conditioner needs. Accounts for room size, ceiling height, sun exposure, floor level, and single vs dual-hose efficiency penalties.",
    "applicationCategory": "UtilitiesApplication",
    "browserRequirements": "Requires JavaScript",
    "softwareVersion": "1.0",
    "operatingSystem": "All"
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "What is the difference between SACC and ASHRAE BTU ratings for portable ACs?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "ASHRAE is the older standard that only measured the cooling output of the compressor in ideal lab conditions. SACC (Seasonally Adjusted Cooling Capacity) is the new DOE standard that accounts for heat generated by the exhaust hose, heat gain from infiltration air, and real-world operating conditions. A 14,000 BTU ASHRAE unit typically rates around 8,000–10,000 BTU SACC."
        }
      },
      {
        "@type": "Question",
        "name": "Why do portable ACs need different sizing than window units?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Portable ACs sit inside the room, so their compressor and hot exhaust hose radiate heat back into the space. Single-hose models also create negative air pressure, drawing warm unconditioned air into the room through gaps. Window units sit partially outside and exhaust heat directly outdoors, so they don't suffer these efficiency penalties."
        }
      },
      {
        "@type": "Question",
        "name": "What is the negative pressure problem with single-hose portable ACs?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "A single-hose portable AC takes room air, cools part of it, and exhausts the rest outside. This creates a vacuum (negative pressure) in the room, which forces hot outdoor air to seep in through door gaps, window seals, and wall cracks. This infiltration air can offset 25–40% of the cooling output, making the unit work much harder."
        }
      }
    ]
  }
];
---

<Layout title="Portable Air Conditioner Room Size Calculator — SACC BTU Sizer">
  <SEO
    slot="head"
    title="Portable Air Conditioner Room Size Calculator — What SACC BTU Do You Need? | Cooling Support"
    description="What size portable air conditioner do you need for your room? Enter your room size, ceiling height, and sun exposure to calculate the exact DOE SACC BTU rating. Covers single-hose vs dual-hose sizing for apartments."
    schema={schema}
  />

  <!-- ===== DARK HERO SECTION ===== -->
  <div class="relative bg-slate-900 pt-16 pb-20 border-b border-slate-800 text-center overflow-hidden">
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[1000px] h-[350px] opacity-20 pointer-events-none">
      <div class="absolute inset-0 bg-gradient-to-b from-cyan-500 via-blue-600 to-transparent blur-[120px] rounded-full"></div>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <!-- Breadcrumb -->
      <nav class="flex justify-center items-center gap-2 text-xs text-slate-400 mb-8 font-medium">
        <a class="hover:text-blue-400 transition-colors cursor-pointer" href="/">Home</a>
        <svg class="w-3 h-3 text-slate-650" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        <a class="hover:text-blue-400 transition-colors cursor-pointer" href="/portable-ac/"">Portable AC Hub</a>
        <svg class="w-3 h-3 text-slate-650" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        <span class="text-slate-300">SACC Sizing Calculator</span>
      </nav>

      <!-- Badge -->
      <div class="inline-flex items-center gap-2 bg-blue-500/10 border border-blue-500/25 text-blue-300 text-xs font-bold px-4 py-1.5 rounded-full mb-5 tracking-widest uppercase font-mono">
        <svg class="w-3.5 h-3.5 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
        DOE SACC Standard
      </div>

      <!-- Title -->
      <h1 class="text-4xl md:text-6xl font-extrabold text-white tracking-tight leading-tight mb-4 max-w-4xl mx-auto">
        Portable Air Conditioner <span class="text-blue-300">Room Size</span> Calculator
      </h1>

      <!-- Subtitle -->
      <p class="text-lg md:text-xl text-slate-400 max-w-2xl mx-auto leading-relaxed font-light mb-8">
        What size portable air conditioner fits your room? Enter your square footage below and we'll calculate the exact DOE SACC BTU rating you need — not the misleading old ASHRAE number.
      </p>
    </div>
  </div>

  <!-- ===== CALCULATOR CARD ===== -->
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16 -mt-12 relative z-20">
    <div class="bg-white rounded-3xl shadow-2xl shadow-slate-200/50 border border-slate-100 overflow-hidden">

      <!-- Blue Gradient Header -->
      <div class="bg-gradient-to-r from-blue-50 to-indigo-50 border-b border-blue-100 p-8 text-center">
        <h2 class="text-2xl font-bold text-slate-900 mb-2">Calculate Your SACC BTU Requirement</h2>
        <p class="text-slate-600">Enter your room details below. We'll calculate the DOE SACC rating you should look for on the box — not the inflated ASHRAE number.</p>
      </div>

      <!-- Form Inputs -->
      <div class="p-8 space-y-8">

        <!-- Room Dimensions -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div>
            <label class="block text-sm font-semibold text-slate-700 mb-2">Room Length (ft)</label>
            <div class="relative">
              <input type="number" id="roomLength" value="15" min="1" max="100" class="block w-full pl-4 pr-12 py-3 bg-slate-50 border border-slate-200 rounded-xl text-slate-900 font-medium focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-all outline-none" />
              <div class="absolute inset-y-0 right-0 pr-4 flex items-center pointer-events-none">
                <span class="text-slate-400 font-medium text-sm">ft</span>
              </div>
            </div>
          </div>
          <div>
            <label class="block text-sm font-semibold text-slate-700 mb-2">Room Width (ft)</label>
            <div class="relative">
              <input type="number" id="roomWidth" value="12" min="1" max="100" class="block w-full pl-4 pr-12 py-3 bg-slate-50 border border-slate-200 rounded-xl text-slate-900 font-medium focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-all outline-none" />
              <div class="absolute inset-y-0 right-0 pr-4 flex items-center pointer-events-none">
                <span class="text-slate-400 font-medium text-sm">ft</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Ceiling Height & Sun Exposure -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div>
            <label class="block text-sm font-semibold text-slate-700 mb-2">Ceiling Height</label>
            <select id="ceilingHeight" class="block w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-slate-900 font-medium focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-all outline-none appearance-none">
              <option value="8">8 ft — Standard</option>
              <option value="9">9 ft — Tall (+10%)</option>
              <option value="10">10 ft — Vaulted (+20%)</option>
            </select>
          </div>
          <div>
            <label class="block text-sm font-semibold text-slate-700 mb-2">Sun Exposure</label>
            <select id="sunExposure" class="block w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-slate-900 font-medium focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-all outline-none appearance-none">
              <option value="normal">Normal (Average Sun)</option>
              <option value="shaded">Shaded (-10%)</option>
              <option value="sunny">Very Sunny (+10%)</option>
            </select>
          </div>
        </div>

        <!-- Floor Level & Hose Type -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div>
            <label class="block text-sm font-semibold text-slate-700 mb-2">Floor Level</label>
            <select id="floorLevel" class="block w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-slate-900 font-medium focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-all outline-none appearance-none">
              <option value="ground">Ground Floor</option>
              <option value="middle">Middle Floor</option>
              <option value="top">Top Floor (+5%)</option>
            </select>
          </div>
          <div>
            <label class="block text-sm font-semibold text-slate-700 mb-2">Portable AC Type</label>
            <select id="hoseType" class="block w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-slate-900 font-medium focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-all outline-none appearance-none">
              <option value="dual">Dual-Hose (Recommended)</option>
              <option value="single">Single-Hose (+25% Penalty)</option>
            </select>
          </div>
        </div>

        <!-- Calculate Button -->
        <button id="calculateBtn" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-bold py-4 px-8 rounded-xl shadow-lg shadow-blue-500/30 transition-all transform hover:-translate-y-0.5 cursor-pointer">
          Calculate Required SACC Rating
        </button>

        <!-- Results Area -->
        <div id="resultsArea" class="hidden mt-8 pt-8 border-t border-slate-100">
          <div class="bg-gradient-to-br from-slate-900 to-blue-900 rounded-2xl p-8 text-center shadow-xl relative overflow-hidden">
            <div class="absolute top-0 right-0 w-32 h-32 bg-white/5 rounded-bl-full pointer-events-none"></div>

            <h3 class="text-slate-300 font-medium mb-2">Required SACC Cooling Capacity</h3>
            <div class="flex items-end justify-center gap-2 mb-6">
              <span id="saccResult" class="text-5xl md:text-6xl font-extrabold text-white tracking-tight"></span>
              <span class="text-xl text-blue-300 font-medium pb-2">BTU (SACC)</span>
            </div>

            <!-- Stats Grid -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">
              <div class="bg-slate-800/50 rounded-xl p-4 border border-slate-700/50 backdrop-blur-sm">
                <div class="text-xs text-slate-400 uppercase tracking-wider font-semibold mb-1">Old ASHRAE Equivalent</div>
                <div class="text-2xl font-bold text-white">~<span id="ashraeResult"></span> <span class="text-sm text-slate-400 font-normal">BTU</span></div>
              </div>
              <div class="bg-slate-800/50 rounded-xl p-4 border border-slate-700/50 backdrop-blur-sm">
                <div class="text-xs text-slate-400 uppercase tracking-wider font-semibold mb-1">Room Area</div>
                <div class="text-2xl font-bold text-white"><span id="areaResult"></span> <span class="text-sm text-slate-400 font-normal">sq ft</span></div>
              </div>
            </div>

            <!-- Recommendation -->
            <div class="bg-blue-500/15 rounded-xl p-4 border border-blue-400/30 backdrop-blur-sm">
              <div class="flex items-start gap-3 text-left">
                <svg class="w-5 h-5 text-blue-400 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                <p id="recommendationText" class="text-sm text-blue-200 leading-relaxed"></p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- ===== EDUCATIONAL SECTIONS ===== -->
    <div class="mt-16 bg-white rounded-3xl p-8 md:p-12 shadow-lg shadow-slate-200/50 border border-slate-100">
      <h2 class="text-3xl font-extrabold text-slate-900 mb-8">Understanding Portable AC Sizing</h2>

      <div class="space-y-6">
        <!-- Section 1: SACC vs ASHRAE -->
        <div class="bg-slate-50 rounded-2xl p-6 border border-slate-100">
          <h3 class="text-lg font-bold text-slate-900 mb-3 flex items-center gap-2">
            <span class="inline-flex items-center justify-center w-7 h-7 rounded-full bg-blue-100 text-blue-600 text-sm font-extrabold">1</span>
            What is SACC vs ASHRAE?
          </h3>
          <p class="text-slate-600 leading-relaxed mb-3">
            For years, portable AC manufacturers used the <strong>ASHRAE rating</strong> — a lab measurement of raw compressor cooling output under ideal conditions. It made units look powerful on paper, but users consistently found their rooms weren't getting as cool as promised.
          </p>
          <p class="text-slate-600 leading-relaxed mb-3">
            In 2017, the Department of Energy introduced <strong>SACC (Seasonally Adjusted Cooling Capacity)</strong>. This standard measures how much cooling <em>actually stays in the room</em> after accounting for:
          </p>
          <ul class="list-disc list-inside text-slate-600 space-y-1 ml-2 mb-3">
            <li>Heat radiated from the exhaust hose back into the room</li>
            <li>Heat generated by the compressor sitting inside the room</li>
            <li>Warm infiltration air drawn in through gaps (especially with single-hose units)</li>
          </ul>
          <div class="bg-blue-50 rounded-xl p-4 border border-blue-100">
            <p class="text-sm text-blue-800 font-medium">
              💡 <strong>Example:</strong> A portable AC rated at <strong>14,000 BTU ASHRAE</strong> is typically only about <strong>8,000–10,000 BTU SACC</strong>. That's 30–40% less real cooling than the old number implied.
            </p>
          </div>
        </div>

        <!-- Section 2: Why different sizing than window units -->
        <div class="bg-slate-50 rounded-2xl p-6 border border-slate-100">
          <h3 class="text-lg font-bold text-slate-900 mb-3 flex items-center gap-2">
            <span class="inline-flex items-center justify-center w-7 h-7 rounded-full bg-blue-100 text-blue-600 text-sm font-extrabold">2</span>
            Why Portable ACs Need Different Sizing Than Window Units
          </h3>
          <p class="text-slate-600 leading-relaxed mb-3">
            A <strong>window unit</strong> hangs half-outside. Its compressor heat, condenser heat, and hot exhaust are all dumped directly outdoors. What you see on the BTU label is very close to what you get.
          </p>
          <p class="text-slate-600 leading-relaxed mb-3">
            A <strong>portable AC</strong> sits entirely inside your room. Every component — compressor, condenser coils, exhaust hose — radiates heat back into the space you're trying to cool. The hot exhaust hose alone can reach 120–140°F, acting like a radiant heater running alongside your AC.
          </p>
          <p class="text-slate-600 leading-relaxed">
            This is why you can't simply match the BTU rating of a window unit when shopping for a portable. A 10,000 BTU window unit will outperform a 10,000 BTU ASHRAE portable by a wide margin. <strong>Always use the SACC rating</strong> for portable ACs and add at least a 20–25% buffer compared to an equivalent window unit recommendation.
          </p>
        </div>

        <!-- Section 3: Negative pressure problem -->
        <div class="bg-slate-50 rounded-2xl p-6 border border-slate-100">
          <h3 class="text-lg font-bold text-slate-900 mb-3 flex items-center gap-2">
            <span class="inline-flex items-center justify-center w-7 h-7 rounded-full bg-blue-100 text-blue-600 text-sm font-extrabold">3</span>
            The Negative Pressure Problem with Single-Hose Units
          </h3>
          <p class="text-slate-600 leading-relaxed mb-3">
            A <strong>single-hose</strong> portable AC pulls room air across the condenser coils and exhausts it out the window. But every cubic foot of air blown outside must be replaced — and that replacement air comes from the path of least resistance: under your door, through window seals, from the hallway, or from the unconditioned attic.
          </p>
          <p class="text-slate-600 leading-relaxed mb-3">
            This is called <strong>negative pressure infiltration</strong>. Your room becomes a slight vacuum, and hot, humid outdoor air is constantly being sucked in to replace what the AC exhausts. Studies show this can reduce effective cooling by <strong>25–40%</strong>.
          </p>
          <div class="bg-amber-50 rounded-xl p-4 border border-amber-200 mb-3">
            <p class="text-sm text-amber-800 font-medium">
              ⚠️ <strong>The irony:</strong> The harder a single-hose unit runs, the more hot air it sucks back into the room. It's literally fighting itself.
            </p>
          </div>
          <p class="text-slate-600 leading-relaxed mb-3">
            A <strong>dual-hose</strong> unit solves this by using a separate intake hose to pull air from outside for cooling the condenser. Room air is never exhausted, so pressure stays neutral. The result is significantly faster cooling and lower energy bills.
          </p>
          <div class="bg-emerald-50 rounded-xl p-4 border border-emerald-200">
            <p class="text-sm text-emerald-800 font-medium">
              ✅ <strong>Our recommendation:</strong> Always choose a dual-hose unit if available. If you must go single-hose, our calculator automatically adds a 25% penalty factor to account for the infiltration loss — so the SACC number it gives you is what you <em>actually</em> need.
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- Related Tools -->
    <div class="mt-12">
      <h2 class="text-2xl font-bold text-slate-900 mb-6">Related Tools & Resources</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <a href="/portable-ac/"" class="group bg-white p-6 rounded-2xl border border-slate-200 shadow-sm hover:shadow-md transition-all hover:border-blue-300">
          <div class="flex items-center gap-4">
            <div class="w-12 h-12 bg-blue-50 text-blue-600 rounded-xl flex items-center justify-center text-xl group-hover:scale-110 transition-transform">
              🧊
            </div>
            <div>
              <h3 class="font-bold text-slate-900 group-hover:text-blue-600 transition-colors">Portable AC Hub</h3>
              <p class="text-sm text-slate-500 mt-1">Full portable AC sizing, breaker calculator, and buyer's guide.</p>
            </div>
          </div>
        </a>

        <a href="/tools/room-btu-calculator/"" class="group bg-white p-6 rounded-2xl border border-slate-200 shadow-sm hover:shadow-md transition-all hover:border-blue-300">
          <div class="flex items-center gap-4">
            <div class="w-12 h-12 bg-cyan-50 text-cyan-600 rounded-xl flex items-center justify-center text-xl group-hover:scale-110 transition-transform">
              📐
            </div>
            <div>
              <h3 class="font-bold text-slate-900 group-hover:text-cyan-600 transition-colors">Room BTU Calculator</h3>
              <p class="text-sm text-slate-500 mt-1">General BTU sizing for all AC types — window, split, and central.</p>
            </div>
          </div>
        </a>

        <a href="/tools/window-venting-builder/"" class="group bg-white p-6 rounded-2xl border border-slate-200 shadow-sm hover:shadow-md transition-all hover:border-blue-300">
          <div class="flex items-center gap-4">
            <div class="w-12 h-12 bg-indigo-50 text-indigo-600 rounded-xl flex items-center justify-center text-xl group-hover:scale-110 transition-transform">
              🪟
            </div>
            <div>
              <h3 class="font-bold text-slate-900 group-hover:text-indigo-600 transition-colors">Window Venting Builder</h3>
              <p class="text-sm text-slate-500 mt-1">Figure out how to vent your portable AC through any window type.</p>
            </div>
          </div>
        </a>

        <a href="/tools/ac-running-cost/"" class="group bg-white p-6 rounded-2xl border border-slate-200 shadow-sm hover:shadow-md transition-all hover:border-emerald-300">
          <div class="flex items-center gap-4">
            <div class="w-12 h-12 bg-emerald-50 text-emerald-600 rounded-xl flex items-center justify-center text-xl group-hover:scale-110 transition-transform">
              ⚡
            </div>
            <div>
              <h3 class="font-bold text-slate-900 group-hover:text-emerald-600 transition-colors">AC Running Cost Estimator</h3>
              <p class="text-sm text-slate-500 mt-1">Calculate how much electricity your portable AC uses per month.</p>
            </div>
          </div>
        </a>
      </div>
    </div>
  </div>

  <!-- ===== CALCULATOR SCRIPT ===== -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', function() {

      var calculateBtn = document.getElementById('calculateBtn');

      if (calculateBtn) {
        calculateBtn.addEventListener('click', function() {
          var length = parseFloat(document.getElementById('roomLength').value) || 0;
          var width = parseFloat(document.getElementById('roomWidth').value) || 0;
          var ceilingHeight = document.getElementById('ceilingHeight').value;
          var sunExposure = document.getElementById('sunExposure').value;
          var floorLevel = document.getElementById('floorLevel').value;
          var hoseType = document.getElementById('hoseType').value;

          // Calculate area
          var area = length * width;

          // Base BTU = area * 20
          var baseBtu = area * 20;

          // Ceiling height multiplier
          if (ceilingHeight === '9') {
            baseBtu = baseBtu * 1.1;
          } else if (ceilingHeight === '10') {
            baseBtu = baseBtu * 1.2;
          }

          // Sun exposure adjustment
          if (sunExposure === 'sunny') {
            baseBtu = baseBtu * 1.10;
          } else if (sunExposure === 'shaded') {
            baseBtu = baseBtu * 0.90;
          }

          // Floor level adjustment
          if (floorLevel === 'top') {
            baseBtu = baseBtu * 1.05;
          }

          // Safety buffer
          baseBtu = baseBtu + 1000;

          // Single-hose penalty
          var saccRequired = baseBtu;
          if (hoseType === 'single') {
            saccRequired = saccRequired * 1.25;
          }

          // Round to nearest 500
          saccRequired = Math.ceil(saccRequired / 500) * 500;

          // ASHRAE equivalent = SACC * 1.35, rounded to 500
          var ashraeEquivalent = Math.round((saccRequired * 1.35) / 500) * 500;

          // Update the DOM
          document.getElementById('saccResult').textContent = saccRequired.toLocaleString();
          document.getElementById('ashraeResult').textContent = ashraeEquivalent.toLocaleString();
          document.getElementById('areaResult').textContent = area.toLocaleString();

          // Build recommendation text
          var saccThousands = (saccRequired / 1000).toFixed(0);
          var recommendationEl = document.getElementById('recommendationText');
          var hoseNote = hoseType === 'single'
            ? ' (includes a 25% penalty for single-hose infiltration losses)'
            : '';
          recommendationEl.textContent = 'Look for units rated at least ' + saccThousands + ',000 BTU SACC on the DOE label' + hoseNote + '. Ignore the larger ASHRAE number — it does not reflect real-world cooling in your room.';

          // Show results
          var resultsArea = document.getElementById('resultsArea');
          resultsArea.classList.remove('hidden');

          // Smooth scroll to results
          resultsArea.scrollIntoView({ behavior: 'smooth', block: 'center' });
        });
      }

    });
  </script>
</Layout>
