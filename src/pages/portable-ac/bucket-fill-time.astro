---
import Layout from '../../layouts/Layout.astro';
import SEO from '../../components/SEO.astro';

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "Portable AC Bucket Fill Time Estimator",
    "description": "Estimate how quickly your portable air conditioner's internal water tank will fill up based on dehumidification rate, tank size, and room humidity. Find out if you need a continuous drain hose.",
    "applicationCategory": "UtilitiesApplication",
    "browserRequirements": "Requires JavaScript",
    "softwareVersion": "1.0",
    "operatingSystem": "All"
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Why does my portable AC collect water?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Portable ACs remove humidity from the air as part of the cooling process. Warm air passes over the cold evaporator coil, and moisture condenses into liquid water — just like a cold glass on a humid day. This condensate collects in an internal tank that must be emptied periodically or drained continuously."
        }
      },
      {
        "@type": "Question",
        "name": "How do I set up a gravity drain on my portable AC?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Most portable ACs have a threaded drain port on the back or bottom. Attach a standard garden hose or the drain hose included with your unit, and route it to a floor drain, bucket, or out a window. The drain must go downhill from the unit — gravity does all the work. No pump is needed if the path slopes downward."
        }
      },
      {
        "@type": "Question",
        "name": "How often do I need to empty my portable AC water tank?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "It depends on room humidity and your unit's dehumidification rate. In high humidity (55-70%), a typical 14-pint tank with a 2.5 pint/hr extraction rate will fill in about 5.6 hours. In very humid climates, you may need to empty it 2-3 times per day or connect a continuous drain hose."
        }
      }
    ]
  }
];
---

<Layout title="Why Does My Portable AC Keep Filling Up With Water? | Bucket Fill Time Estimator">
  <SEO
    slot="head"
    title="Why Does My Portable AC Keep Filling Up With Water? | Bucket Fill Time Estimator"
    description="Wondering 'why does my portable ac keep filling up with water'? Estimate how fast your portable AC's water tank will fill up and learn how to clean the water tank."
    schema={schema}
  />

  <!-- ===== DARK HERO SECTION ===== -->
  <div class="relative bg-slate-900 pt-16 pb-20 border-b border-slate-800 text-center overflow-hidden">
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[1000px] h-[350px] opacity-20 pointer-events-none">
      <div class="absolute inset-0 bg-gradient-to-b from-teal-500 via-cyan-600 to-transparent blur-[120px] rounded-full"></div>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <!-- Breadcrumb -->
      <nav class="flex justify-center items-center gap-2 text-xs text-slate-400 mb-8 font-medium">
        <a class="hover:text-teal-400 transition-colors cursor-pointer" href="/">Home</a>
        <svg class="w-3 h-3 text-slate-650" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        <a class="hover:text-teal-400 transition-colors cursor-pointer" href="/portable-ac/"">Portable AC Hub</a>
        <svg class="w-3 h-3 text-slate-650" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        <span class="text-slate-300">Bucket Fill Time</span>
      </nav>

      <!-- Badge -->
      <div class="inline-flex items-center gap-2 bg-teal-500/10 border border-teal-500/25 text-teal-300 text-xs font-bold px-4 py-1.5 rounded-full mb-5 tracking-widest uppercase font-mono">
        <svg class="w-3.5 h-3.5 text-teal-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z"/></svg>
        Humidity Tool
      </div>

      <!-- Title -->
      <h1 class="text-4xl md:text-6xl font-extrabold text-white tracking-tight leading-tight mb-4 max-w-3xl mx-auto">
        Why Does My Portable AC Keep Filling Up With Water?
      </h1>

      <!-- Subtitle -->
      <p class="text-lg md:text-xl text-slate-400 max-w-2xl mx-auto leading-relaxed font-light mb-8">
        Estimate how fast your internal water tank will fill up and learn how to clean it.
      </p>
    </div>
  </div>

  <!-- ===== CALCULATOR CARD ===== -->
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16 -mt-12 relative z-20">
    <div class="bg-white rounded-3xl shadow-2xl shadow-slate-200/50 border border-slate-100 overflow-hidden">

      <!-- Teal/Cyan Gradient Header -->
      <div class="bg-gradient-to-r from-teal-50 to-cyan-50 border-b border-teal-100 p-8 text-center">
        <h2 class="text-2xl font-bold text-slate-900 mb-2">💧 Bucket Fill Time Calculator</h2>
        <p class="text-slate-600">Enter your portable AC specs and room conditions to estimate how fast the tank fills.</p>
      </div>

      <!-- Form Inputs -->
      <div class="p-8 space-y-8">

        <!-- Row 1: Dehumidification Rate + Tank Size -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div>
            <label for="dehumRate" class="block text-sm font-semibold text-slate-700 mb-2">Your AC's Dehumidification Rate</label>
            <select id="dehumRate" class="block w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-slate-900 font-medium focus:ring-2 focus:ring-teal-500 focus:border-teal-500 transition-all outline-none appearance-none">
              <option value="1.5">1.5 pints/hr</option>
              <option value="2.0">2.0 pints/hr</option>
              <option value="2.5" selected>2.5 pints/hr</option>
              <option value="3.0">3.0 pints/hr</option>
              <option value="3.5">3.5 pints/hr</option>
            </select>
          </div>
          <div>
            <label for="tankSize" class="block text-sm font-semibold text-slate-700 mb-2">Internal Tank Size</label>
            <select id="tankSize" class="block w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-slate-900 font-medium focus:ring-2 focus:ring-teal-500 focus:border-teal-500 transition-all outline-none appearance-none">
              <option value="10">Small (10 pints)</option>
              <option value="14" selected>Medium (14 pints)</option>
              <option value="18">Large (18 pints)</option>
              <option value="24">Extra Large (24 pints)</option>
            </select>
          </div>
        </div>

        <!-- Row 2: Humidity Level + Hours of Use -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div>
            <label for="humidityLevel" class="block text-sm font-semibold text-slate-700 mb-2">Room Humidity Level</label>
            <select id="humidityLevel" class="block w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-slate-900 font-medium focus:ring-2 focus:ring-teal-500 focus:border-teal-500 transition-all outline-none appearance-none">
              <option value="0.5">Low (30–40%)</option>
              <option value="0.75">Moderate (40–55%)</option>
              <option value="1.0" selected>High (55–70%)</option>
              <option value="1.25">Very High (70%+)</option>
            </select>
          </div>
          <div>
            <label for="hoursUse" class="block text-sm font-semibold text-slate-700 mb-2">Hours of Continuous Use per Day</label>
            <div class="relative">
              <input type="number" id="hoursUse" value="8" min="1" max="24" class="block w-full pl-4 pr-14 py-3 bg-slate-50 border border-slate-200 rounded-xl text-slate-900 font-medium focus:ring-2 focus:ring-teal-500 focus:border-teal-500 transition-all outline-none" />
              <div class="absolute inset-y-0 right-0 pr-4 flex items-center pointer-events-none">
                <span class="text-slate-400 font-medium text-sm">hrs</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Calculate Button -->
        <button id="calculateBtn" class="w-full bg-teal-600 hover:bg-teal-700 text-white font-bold py-4 px-8 rounded-xl shadow-lg shadow-teal-500/30 transition-all transform hover:-translate-y-0.5 cursor-pointer">
          Estimate Fill Time
        </button>

        <!-- ===== RESULTS AREA ===== -->
        <div id="resultsArea" class="hidden mt-8 pt-8 border-t border-slate-100">
          <div class="bg-gradient-to-br from-slate-900 to-teal-900 rounded-2xl p-8 text-center shadow-xl relative overflow-hidden">
            <div class="absolute top-0 right-0 w-32 h-32 bg-white/5 rounded-bl-full pointer-events-none"></div>

            <!-- Primary Stat: Fill Time -->
            <h3 class="text-slate-300 font-medium mb-2">Time Until Tank Is Full</h3>
            <div class="flex items-end justify-center gap-2 mb-4">
              <span id="fillTimeResult" class="text-5xl md:text-6xl font-extrabold text-white tracking-tight"></span>
              <span class="text-xl text-teal-300 font-medium pb-2">hours</span>
            </div>

            <!-- Secondary Stat: Fills Per Day -->
            <div class="bg-slate-800/50 rounded-xl p-4 border border-slate-700/50 backdrop-blur-sm mb-6">
              <div class="text-sm text-slate-300">
                <span class="font-bold text-white">Fills per day:</span> <span id="fillsPerDayResult" class="text-teal-300 font-bold text-lg"></span>
                <span class="text-xs text-slate-400 mt-1 block">Based on <span id="hoursUsedDisplay"></span> hours of continuous use per day</span>
              </div>
            </div>

            <!-- Verdict -->
            <div id="verdictArea" class="rounded-2xl p-6 text-center"></div>
          </div>
        </div>

      </div>
    </div>

    <!-- ===== EDUCATIONAL SECTIONS ===== -->
    <div class="mt-16 bg-white rounded-3xl p-8 md:p-12 shadow-lg shadow-slate-200/50 border border-slate-100">
      <h2 class="text-3xl font-extrabold text-slate-900 mb-6">Understanding Portable AC Condensation</h2>

      <div class="space-y-6">
        <!-- Section 1: Why Portable ACs Collect Water -->
        <div class="bg-slate-50 rounded-2xl p-6 border border-slate-100">
          <h3 class="text-lg font-bold text-slate-900 mb-2 flex items-center gap-2">
            <span class="text-teal-500">1.</span> Why Portable ACs Collect Water
          </h3>
          <p class="text-slate-600 leading-relaxed">
            Every portable air conditioner is also a <strong>dehumidifier</strong>. As warm, humid room air is drawn over the ice-cold evaporator coil, the moisture in the air condenses into liquid water — exactly like how a cold glass of water "sweats" on a humid summer day.
            <br><br>
            This condensate has to go somewhere. Most portable ACs collect it in an <strong>internal drip tray or tank</strong>. When the tank is full, the unit triggers a safety float switch and <strong>shuts itself off</strong> until you manually empty it. In dry climates this isn't a big deal — you might empty the tray once a week. But in humid regions (the Southeast US, Gulf Coast, or tropical climates), the tank can fill in just a few hours, causing the AC to shut off repeatedly in the middle of the night.
          </p>
        </div>

        <!-- Section 2: How to Set Up a Gravity Drain -->
        <div class="bg-slate-50 rounded-2xl p-6 border border-slate-100">
          <h3 class="text-lg font-bold text-slate-900 mb-2 flex items-center gap-2">
            <span class="text-teal-500">2.</span> How to Set Up a Gravity Drain
          </h3>
          <p class="text-slate-600 leading-relaxed">
            If your AC is filling its tank faster than you can empty it, the best solution is a <strong>continuous gravity drain</strong>. Here's how:
          </p>
          <ol class="list-decimal list-inside text-slate-600 leading-relaxed mt-3 space-y-2">
            <li><strong>Find the drain port</strong> — it's usually a threaded plug on the back or bottom of the unit. Check your owner's manual.</li>
            <li><strong>Attach a garden hose or the included drain hose</strong> — most units accept a standard ¾" garden hose thread or include a small-diameter rubber drain tube.</li>
            <li><strong>Route the hose downhill</strong> to a floor drain, utility sink, or a large bucket. Gravity does the work — no pump needed.</li>
            <li><strong>Secure the hose</strong> so it doesn't kink or get kicked loose. Use zip ties or tape to keep it against the baseboard.</li>
          </ol>
          <p class="text-slate-600 leading-relaxed mt-3">
            <strong>Pro tip:</strong> If you don't have a nearby floor drain, route the hose out through the same window panel where your exhaust hose goes. Many window kits have a knockout for exactly this purpose.
          </p>
        </div>

        <!-- Section 3: Signs Your Drain is Clogged -->
        <div class="bg-slate-50 rounded-2xl p-6 border border-slate-100">
          <h3 class="text-lg font-bold text-slate-900 mb-2 flex items-center gap-2">
            <span class="text-teal-500">3.</span> Signs Your Portable AC Drain Is Clogged
          </h3>
          <p class="text-slate-600 leading-relaxed">
            Even with a continuous drain hose connected, clogs can happen over time. Watch for these warning signs:
          </p>
          <ul class="list-disc list-inside text-slate-600 leading-relaxed mt-3 space-y-2">
            <li><strong>The "Full Tank" indicator light comes on</strong> even though the drain hose is connected — water isn't flowing out.</li>
            <li><strong>Water pools around the base of the unit</strong> — the internal tray is overflowing because the drain is backed up.</li>
            <li><strong>A musty or mildew smell</strong> — standing water inside the drain path is breeding mold and bacteria.</li>
            <li><strong>The AC keeps shutting itself off</strong> — the float switch is triggering because water isn't draining properly.</li>
          </ul>
          <p class="text-slate-600 leading-relaxed mt-3">
            <strong>Fix it:</strong> Disconnect the hose and flush it with a mixture of warm water and white vinegar. Use a pipe cleaner or thin brush to clear the drain port on the unit. Run clean water through the hose to confirm it flows freely before reconnecting.
          </p>
        </div>
      </div>
    </div>
  </div>

  <!-- ===== INLINE JAVASCRIPT ===== -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', function() {

      var calculateBtn = document.getElementById('calculateBtn');

      if (calculateBtn) {
        calculateBtn.addEventListener('click', function() {

          // Gather inputs
          var dehumRate = parseFloat(document.getElementById('dehumRate').value) || 2.5;
          var tankSize = parseFloat(document.getElementById('tankSize').value) || 14;
          var humidityFactor = parseFloat(document.getElementById('humidityLevel').value) || 1.0;
          var hoursUse = parseFloat(document.getElementById('hoursUse').value) || 8;

          // Clamp hours to valid range
          if (hoursUse < 1) hoursUse = 1;
          if (hoursUse > 24) hoursUse = 24;

          // Core calculations
          var effectiveRate = dehumRate * humidityFactor;
          var fillTime = tankSize / effectiveRate;
          var fillsPerDay = Math.ceil(hoursUse / fillTime);

          // Display fill time (one decimal place)
          var fillTimeDisplay = fillTime.toFixed(1);
          document.getElementById('fillTimeResult').textContent = fillTimeDisplay;

          // Display fills per day
          document.getElementById('fillsPerDayResult').textContent = fillsPerDay;
          document.getElementById('hoursUsedDisplay').textContent = hoursUse;

          // Determine verdict
          var verdictArea = document.getElementById('verdictArea');

          if (fillTime > hoursUse) {
            // Green — tank won't fill during the session
            verdictArea.className = 'rounded-2xl p-6 text-center bg-emerald-50 border-2 border-emerald-200';
            verdictArea.innerHTML = '<div class="text-4xl mb-2">🟢</div>'
              + '<h3 class="text-xl font-extrabold text-emerald-700 mb-2">You\'re Fine!</h3>'
              + '<p class="text-emerald-600">The tank won\'t fill during your session. Just empty it once a day and you\'re good to go. No drain hose needed unless you want zero maintenance.</p>';
          } else if (fillTime >= 4) {
            // Yellow — fills during use but manageable with a drain
            verdictArea.className = 'rounded-2xl p-6 text-center bg-amber-50 border-2 border-amber-200';
            verdictArea.innerHTML = '<div class="text-4xl mb-2">🟡</div>'
              + '<h3 class="text-xl font-extrabold text-amber-700 mb-2">Tank Will Fill While Running</h3>'
              + '<p class="text-amber-600">Your tank will fill up every <strong>' + fillTimeDisplay + ' hours</strong>. Set up a gravity drain hose to a bucket or floor drain to avoid auto-shutoff. Without a drain, you\'ll need to empty it <strong>' + fillsPerDay + ' time' + (fillsPerDay > 1 ? 's' : '') + '</strong> per day.</p>';
          } else {
            // Red — high humidity, frequent fills
            verdictArea.className = 'rounded-2xl p-6 text-center bg-red-50 border-2 border-red-200';
            verdictArea.innerHTML = '<div class="text-4xl mb-2">🔴</div>'
              + '<h3 class="text-xl font-extrabold text-red-700 mb-2">High Humidity — Drain Hose Required!</h3>'
              + '<p class="text-red-600">Your AC will fill its tank every <strong>' + fillTimeDisplay + ' hours</strong> and shut off <strong>' + fillsPerDay + ' time' + (fillsPerDay > 1 ? 's' : '') + ' per day</strong>. You <strong>MUST</strong> connect a continuous drain hose or the AC will keep turning itself off. Route a garden hose from the drain port to a floor drain or large bucket.</p>';
          }

          // Show results
          var resultsArea = document.getElementById('resultsArea');
          resultsArea.classList.remove('hidden');

          // Smooth scroll to results
          resultsArea.scrollIntoView({ behavior: 'smooth', block: 'center' });
        });
      }

    });
  </script>
</Layout>
