            </div>
            <ul class="space-y-3">
              {corePages.map((link) => (
                <li>
                  <a href={link.href} class="group text-sm font-semibold text-slate-600 hover:text-slate-950 transition-colors leading-relaxed flex items-start gap-2.5">
