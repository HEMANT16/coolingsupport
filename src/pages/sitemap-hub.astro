---
import Layout from '../layouts/Layout.astro';
import SEO from '../components/SEO.astro';

// Silo 1: Core Pages
const corePages = [
  { name: "Homepage & Interactive Calculators", href: "/" },
  { name: "About Us & Our HVAC Engineering Team", href: "/about-us" },
