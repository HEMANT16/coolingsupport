  { name: "Air Duct Sizing Calculator (CFM & Friction)", href: "/tools/air-duct-sizing-calculator" },
  { name: "Plumbing Pipe Friction Loss Calculator", href: "/tools/plumbing-pipe-calculator" }
];

// Silo 3: Cost, ROI & Pricing Calculators
const costCalculators = [
  { name: "AC Running Cost Estimator (Daily/Monthly Bill)", href: "/tools/ac-running-cost" },
  { name: "SEER2 Energy Savings & ROI Calculator", href: "/tools/seer2-savings-calculator" },
  { name: "Inverter vs. Traditional AC ROI Simulator", href: "/tools/inverter-roi-simulator" },
  { name: "AC Freon Recharge Cost Calculator (R410A/R22)", href: "/tools/freon-cost-calculator" },
  { name: "Ductless Mini-Split Equipment & Labor Cost Estimator", href: "/tools/mini-split-cost-estimator" },
  { name: "HVAC Flat Rate Pricing Engine", href: "/tools/flat-rate-pricing-calculator" },
  { name: "Labor Burden & True Hourly Tech Cost Engine", href: "/tools/labor-burden-calculator" }
];

// Silo 4: Field Diagnostics, Math & Professional Templates
const diagnosticTools = [
  { name: "HVAC Wire Sizing & Breaker Calculator (AWG)", href: "/tools/wire-size-calculator" },
  { name: "Superheat & Subcooling Charging Target Calculator", href: "/tools/superheat-subcooling-calculator" },
  { name: "Oversized AC Short-Cycling Simulator", href: "/tools/short-cycle-simulator" },
  { name: "AC Noise Analyzer & Audio Matcher", href: "/tools/ac-noise-analyzer" },
  { name: "Visual Dual Run Capacitor Matcher", href: "/tools/capacitor-matcher" },
  { name: "Window Venting Solutions Builder", href: "/tools/window-venting-builder" },
  { name: "HVAC Preventative Maintenance 21-Point Checklist", href: "/tools/hvac-maintenance-checklist" },
  { name: "EPA Section 608 Refrigerant Tracking Log", href: "/tools/epa-refrigerant-log" },
  { name: "Blank Manual J Worksheet & Design Load Template", href: "/tools/manual-j-worksheet" },
  { name: "HVAC Sales Proposal Template Generator", href: "/tools/hvac-proposal-template" }
];

// Silo 5: Brand Error Codes & Diagnostic Directories
const errorCodes = [
  { name: "AC Error Codes Hub & Reset Directory", href: "/ac-error-codes" },
  { name: "Carrier & Bryant Furnace Blink Codes", href: "/ac-error-codes/carrier-error-code" },
  { name: "Daikin AC Split & VRV Error Codes", href: "/ac-error-codes/daikin-error-code" },
  { name: "Fujitsu Halcyon Mini-Split Error Codes", href: "/ac-error-codes/fujitsu-error-code" },
  { name: "Gree Mini-Split & Inverter AC Codes", href: "/ac-error-codes/gree-error-code" },
  { name: "Lennox AC & Furnace Control Board Codes", href: "/ac-error-codes/lennox-error-code" },
  { name: "LG AC Inverter Diagnostics & Fault Codes", href: "/ac-error-codes/lg-error-code" },
  { name: "Lloyd AC Inverter Blink Codes", href: "/ac-error-codes/lloyd-error-code" },
  { name: "Mitsubishi Mini-Split LED blink Diagnostics", href: "/ac-error-codes/mitsubishi-error-code" },
  { name: "Rheem & Ruud Furnace & AC Fault Codes", href: "/ac-error-codes/rheem-error-code" },
  { name: "Trane & American Standard LED flash Codes", href: "/ac-error-codes/trane-error-code" },
  { name: "Voltas AC Split & Window Fault Codes", href: "/ac-error-codes/voltas-error-code" }
];

