  { name: "Privacy & Local Data Processing Policy", href: "/privacy" },
  { name: "Calculation Methodology & ASHRAE Standards", href: "/methodology" }
];

// Silo 2: Sizing & Capacity Calculators
const sizingCalculators = [
  { name: "Portable AC Hub & Tools", href: "/portable-ac" },
  { name: "Portable Air Conditioner Room Size Calculator", href: "/portable-ac/sacc-sizing" },
  { name: "Portable Air Conditioner Circuit Breaker Trips?", href: "/portable-ac/breaker-check" },
  { name: "Why Does My Portable AC Keep Filling Up With Water?", href: "/portable-ac/bucket-fill-time" },
