        <!-- Silo 7: Core Info & Trust Pages -->
        <div class="bg-white rounded-3xl border border-slate-200/80 shadow-[0_8px_30px_rgba(0,0,0,0.015)] p-6 sm:p-8 flex flex-col justify-between hover:shadow-[0_20px_40px_rgba(0,0,0,0.03)] transition-all hover:-translate-y-1 duration-300">
