const troubleshootingGuides = [
  { name: "HVAC Troubleshooting & Repair Guides Hub", href: "/guides" },
  { name: "AC Running But Not Cooling? 5 Common Causes", href: "/guides/ac-not-cooling" },
  { name: "HVAC Diagnostic Guides Index", href: "/guides/diagnostics" },
  { name: "Step-by-Step Repair Guides Catalog", href: "/guides/how-to" },
  { name: "How to Set Your Thermostat During a Heatwave", href: "/guides/how-to/heatwave-thermostat" },
  { name: "How to Clean AC Condenser Coils", href: "/guides/how-to/ac-maintenance" },
  { name: "How to Fix an AC Dripping Water Through Ceiling", href: "/guides/how-to/ac-leaking-water" },
  { name: "How to Unfreeze an AC Evaporator Coil", href: "/guides/how-to/coil-freezing" }
];

// Silo 7: Comparative Analysis & Market Data Guides
const marketDataGuides = [
  { name: "Deep-Dive Technical Articles Index", href: "/guides/articles" },
  { name: "Ultimate Home HVAC Buying Guide", href: "/guides/articles/hvac-buying-guide" },
  { name: "14 SEER2 vs 18 SEER2 High-Efficiency Worth Check", href: "/guides/articles/seer2-comparison" },
  { name: "Single-Stage vs Variable-Speed Compressor Comparison", href: "/guides/articles/inverter-vs-single-stage" },
  { name: "Central AC vs Ductless Mini-Split System Comparison", href: "/guides/articles/central-vs-mini-split" },
  { name: "Data & Electricity Tariff Databases Index", href: "/guides/data" },
  { name: "USA State-by-State Utility Rates (2026)", href: "/guides/data/state-electricity-rates" },
  { name: "Fair HVAC Equipment & Installation Cost Averages", href: "/guides/data/fair-pricing" },
  { name: "National R-410A vs R-454B Refrigerant Costs", href: "/guides/data/freon-costs" },
  { name: "Federal & State Heat Pump Rebates Directory", href: "/guides/data/heat-pump-rebates" }
];

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": "Sitemap Hub & Directory Index | Cooling Support",
    "description": "Comprehensive HTML sitemap and page directory mapping all HVAC engineering calculators, repair guides, and error code databases on Cooling Support.",
    "url": "https://coolingsupport.com/sitemap-hub"
  }
];
---

<Layout title="Sitemap Hub & Directory Index">
  <SEO 
    slot="head"
    title="Sitemap Hub &amp; Directory Index | Cooling Support" 
    description="Comprehensive site map of Cooling Support. Instantly locate all HVAC engineering calculators, brand error codes lookups, and troubleshooting manuals."
    schema={schema}
  />

  <!-- Hero & Header Section -->
  <div class="relative bg-slate-900 pt-16 pb-20 border-b border-slate-800 text-center overflow-hidden">
    <!-- Gradient background glow -->
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[1000px] h-[350px] opacity-20 pointer-events-none">
      <div class="absolute inset-0 bg-gradient-to-b from-blue-500 via-indigo-600 to-transparent blur-[120px] rounded-full"></div>
    </div>
    
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <!-- Breadcrumb -->
      <nav class="flex justify-center items-center gap-2 text-xs text-slate-400 mb-8 font-medium">
        <a class="hover:text-blue-400 transition-colors cursor-pointer" href="/">Home</a>
        <svg class="w-3 h-3 text-slate-650" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        <span class="text-slate-300">Sitemap Hub</span>
      </nav>

      <!-- Badge -->
      <div class="inline-flex items-center gap-2 bg-blue-500/10 border border-blue-500/25 text-blue-300 text-xs font-bold px-4 py-1.5 rounded-full mb-5 tracking-widest uppercase font-mono">
        <svg class="w-3.5 h-3.5 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A2 2 0 013 15.382V6m0 0l5.447 2.724L11 7m-8 1v8m8-9l4-2 5 2.5V17m-9-9v9m0 0l5 2.5 4-2M9 21h11.5a1.5 1.5 0 001.5-1.5V10m-7.5 11l-3-6h-3.5"/></svg>
        Topical Authority Map
      </div>

      <!-- Main Headline -->
      <h1 class="text-4xl md:text-6xl font-extrabold text-white tracking-tight leading-tight mb-4 max-w-3xl mx-auto">
        Complete HVAC Resource Hub
      </h1>
      <p class="text-lg md:text-xl text-slate-400 max-w-2xl mx-auto leading-relaxed font-light mb-8">
        Every calculator, brand troubleshooting guide, error code index, and installation data source—organized into 7 clear authority silos.
      </p>

      <!-- CTA Action Buttons -->
      <div class="flex flex-wrap items-center justify-center gap-4 mb-12">
        <a class="inline-flex items-center gap-2 text-white font-bold px-6 py-3 rounded-full transition-all cursor-pointer whitespace-nowrap bg-gradient-to-r from-blue-500 to-indigo-600 hover:opacity-90 shadow-lg shadow-blue-500/20" href="/#guided-calculator">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>
          Sizing &amp; Load Tools
        </a>
        <a class="inline-flex items-center gap-2 text-slate-300 font-bold px-6 py-3 rounded-full transition-all cursor-pointer whitespace-nowrap border border-slate-700 hover:bg-slate-800 hover:text-white" href="/guides/"">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
          Troubleshooting Manuals
        </a>
      </div>

      <!-- Stats Grid -->
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 max-w-5xl mx-auto">
        <div class="bg-slate-800/60 backdrop-blur border border-slate-700/80 rounded-2xl p-5 text-center">
          <div class="text-3xl font-extrabold text-blue-400 mb-1">57</div>
          <div class="text-xs text-slate-400 uppercase tracking-widest font-mono">Pages Indexed</div>
        </div>
        <div class="bg-slate-800/60 backdrop-blur border border-slate-700/80 rounded-2xl p-5 text-center">
          <div class="text-3xl font-extrabold text-indigo-400 mb-1">7</div>
          <div class="text-xs text-slate-400 uppercase tracking-widest font-mono">Authority Silos</div>
        </div>
        <div class="bg-slate-800/60 backdrop-blur border border-slate-700/80 rounded-2xl p-5 text-center">
          <div class="text-3xl font-extrabold text-emerald-400 mb-1">50+</div>
          <div class="text-xs text-slate-400 uppercase tracking-widest font-mono">State Tariffs</div>
        </div>
        <div class="bg-slate-800/60 backdrop-blur border border-slate-700/80 rounded-2xl p-5 text-center">
          <div class="text-3xl font-extrabold text-cyan-400 mb-1">24+</div>
          <div class="text-xs text-slate-400 uppercase tracking-widest font-mono">Interactive Tools</div>
        </div>
      </div>

    </div>
  </div>

  <!-- Bento Silo Directory -->
  <div class="bg-slate-50 py-16 min-h-screen">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">

        <!-- Silo 1: Sizing & Capacity Calculators -->
        <div class="bg-white rounded-3xl border border-slate-200/80 shadow-[0_8px_30px_rgba(0,0,0,0.015)] p-6 sm:p-8 flex flex-col justify-between hover:shadow-[0_20px_40px_rgba(0,0,0,0.03)] transition-all hover:-translate-y-1 duration-300">
          <div>
            <div class="flex items-center gap-3 mb-5 pb-4 border-b border-slate-100">
              <div class="w-10 h-10 rounded-xl bg-blue-50 border border-blue-100 flex items-center justify-center text-blue-500 shrink-0">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4"/></svg>
              </div>
              <div>
                <h2 class="text-base font-bold text-slate-900 leading-tight">Sizing &amp; Capacity</h2>
                <p class="text-xs text-slate-400 mt-0.5">ACCA J &amp; BTU sizing engines</p>
              </div>
            </div>
            <ul class="space-y-3">
              {sizingCalculators.map((link) => (
                <li>
                  <a href={link.href} class="group text-sm font-semibold text-slate-600 hover:text-blue-600 transition-colors leading-relaxed flex items-start gap-2.5">
                    <span class="w-1.5 h-1.5 rounded-full bg-blue-400 mt-2 shrink-0 transition-transform group-hover:scale-150"></span>
                    <span class="transition-transform group-hover:translate-x-0.5">{link.name}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </div>

        <!-- Silo 2: Cost, ROI & Financial Calculators -->
        <div class="bg-white rounded-3xl border border-slate-200/80 shadow-[0_8px_30px_rgba(0,0,0,0.015)] p-6 sm:p-8 flex flex-col justify-between hover:shadow-[0_20px_40px_rgba(0,0,0,0.03)] transition-all hover:-translate-y-1 duration-300">
