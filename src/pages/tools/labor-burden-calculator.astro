---
import Layout from '../../layouts/Layout.astro';

const title = "Labor Burden Calculator | True Hourly Cost Tool";
const description = "HVAC and Plumbing contractors: Calculate your true hourly employee cost by factoring in payroll taxes, workers comp, vehicle expenses, and non-billable time.";
import AuthorBadge from '../../components/AuthorBadge.astro';
---

<Layout title={title} description={description}>
  <!-- JSON-LD Schemas -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": "Labor Burden Calculator",
    "description": "Calculates the true hourly cost of a field technician by factoring in base wage, payroll taxes, workers comp, vehicle costs, benefits, and unbillable drive time.",
    "applicationCategory": "BusinessApplication",
    "operatingSystem": "WebBrowser",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD"
    }
  })} />

  <!-- Hero Section -->
  <section class="bg-gray-900 text-white py-16 px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl mx-auto text-center">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-md bg-emerald-500/20 text-emerald-400 font-bold text-xs uppercase tracking-widest mb-6 border border-emerald-500/30">
        Contractor Business Suite
      </div>
      <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight mb-6">
        Labor Burden & <span class="text-emerald-400">True Cost Engine</span>
      </h1>
      <div class="mt-8 mb-4 max-w-2xl mx-auto"><AuthorBadge name="Mike Reynolds" role="HVAC Expert" image="/images/mike-reynolds.png" date="June 14, 2026" /></div>
      <p class="text-xl text-gray-300 max-w-2xl mx-auto mb-8 font-light">
        A "$25/hour" technician actually costs you significantly more. Calculate your true labor burden to ensure you aren't undercharging for labor.
      </p>
    </div>
  </section>

  <!-- Interactive Calculator App -->
  <section class="py-12 px-4 sm:px-6 lg:px-8 bg-gray-50 relative z-10">
    <div class="max-w-6xl mx-auto bg-white rounded-sm shadow-md border border-gray-200 overflow-hidden">
      
      <!-- App Header -->
      <div class="bg-slate-800 px-6 py-4 flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b-4 border-emerald-500">
        <div class="flex items-center gap-3">
          <span class="text-emerald-400 text-xl">‍️</span>
          <h2 class="text-white font-bold text-lg">Labor Burden Analysis</h2>
        </div>
      </div>

      <div class="p-6 md:p-8">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
          
          <!-- Controls (Left: 7 cols) -->
          <div class="lg:col-span-7 space-y-8">
            
            <div class="bg-emerald-50 border border-emerald-200 p-4 rounded-sm mb-2">
              <p class="text-emerald-800 text-sm"><strong>How it works:</strong> We calculate total annual cost (including the van) and divide it strictly by <em>Billable Hours</em>. Drive time and meetings do not generate revenue!</p>
            </div>

            <!-- Wage Inputs -->
            <h3 class="text-gray-900 font-bold uppercase tracking-wider text-xs border-b border-gray-200 pb-2">1. The Technician</h3>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
              <div>
                <label class="block text-sm font-bold text-gray-700 mb-2">Base Hourly Wage</label>
                <div class="flex rounded-sm shadow-sm border-2 border-gray-300 focus-within:border-emerald-500 overflow-hidden">
                  <span class="px-4 bg-gray-100 border-r border-gray-300 flex items-center font-bold text-gray-500">$</span>
                  <input type="number" id="baseWage" value="25" step="1" class="w-full border-none focus:ring-0 text-gray-900 text-xl font-bold p-3" />
                </div>
              </div>
              <div>
                <label class="block text-sm font-bold text-gray-700 mb-2">Annual Billable Hours</label>
                <div class="flex rounded-sm shadow-sm border-2 border-gray-300 focus-within:border-emerald-500 overflow-hidden">
                  <input type="number" id="billableHours" value="1500" step="50" class="w-full border-none focus:ring-0 text-gray-900 text-xl font-bold p-3" />
                  <span class="px-4 bg-gray-100 border-l border-gray-300 flex items-center font-bold text-gray-500">Hrs</span>
                </div>
                <p class="text-xs text-gray-500 mt-1 font-medium">Standard year = 2080 hrs. Average tech only bills 1200-1600 due to driving.</p>
              </div>
            </div>

            <!-- Annual Burden Inputs -->
            <h3 class="text-gray-900 font-bold uppercase tracking-wider text-xs border-b border-gray-200 pb-2 pt-4">2. Annual Company Burden</h3>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
              <div>
                <label class="block text-sm font-bold text-gray-700 mb-2">Payroll Taxes & Workers Comp</label>
                <div class="flex rounded-sm shadow-sm border-2 border-gray-300 focus-within:border-emerald-500 overflow-hidden">
                  <span class="px-4 bg-gray-100 border-r border-gray-300 flex items-center font-bold text-gray-500">$</span>
                  <input type="number" id="taxes" value="6500" step="100" class="w-full border-none focus:ring-0 text-gray-900 text-xl font-bold p-3" />
                </div>
                <p class="text-xs text-gray-500 mt-1 font-medium">FICA, SUTA, FUTA, WC</p>
              </div>
              <div>
                <label class="block text-sm font-bold text-gray-700 mb-2">Benefits (Health, 401k, Uniforms)</label>
                <div class="flex rounded-sm shadow-sm border-2 border-gray-300 focus-within:border-emerald-500 overflow-hidden">
                  <span class="px-4 bg-gray-100 border-r border-gray-300 flex items-center font-bold text-gray-500">$</span>
                  <input type="number" id="benefits" value="5000" step="100" class="w-full border-none focus:ring-0 text-gray-900 text-xl font-bold p-3" />
                </div>
              </div>
              <div class="sm:col-span-2">
                <label class="block text-sm font-bold text-gray-700 mb-2">Service Van (Gas, Ins., Maintenance, Depreciation)</label>
                <div class="flex rounded-sm shadow-sm border-2 border-gray-300 focus-within:border-emerald-500 overflow-hidden">
                  <span class="px-4 bg-gray-100 border-r border-gray-300 flex items-center font-bold text-gray-500">$</span>
                  <input type="number" id="vanCost" value="8000" step="100" class="w-full border-none focus:ring-0 text-gray-900 text-xl font-bold p-3" />
                </div>
              </div>
            </div>

            <!-- Action Button -->
            <button id="btnCalculate" class="w-full mt-8 bg-slate-900 hover:bg-slate-800 text-white font-extrabold text-xl py-5 rounded-sm shadow-lg transition-transform active:scale-95 flex items-center justify-center gap-3">
              Calculate True Hourly Cost <span class="text-2xl"></span>
            </button>

          </div>

          <!-- Output Panel (Right: 5 cols) -->
          <div class="lg:col-span-5 bg-slate-900 rounded-sm p-6 lg:p-8 text-white flex flex-col relative overflow-hidden shadow-md">
            <div class="absolute top-0 right-0 w-64 h-64 bg-emerald-500 rounded-md mix-blend-overlay filter blur-3xl opacity-10 transform translate-x-1/2 -translate-y-1/2"></div>
            
            <h3 class="text-gray-400 font-bold uppercase tracking-widest text-sm mb-6 border-b border-slate-700 pb-4">Burden Analysis</h3>
            
            <div class="space-y-6 flex-grow">
              
              <!-- True Cost Box -->
              <div class="flex flex-col gap-2 bg-emerald-900/30 p-6 rounded-sm border-2 border-emerald-500 transition-colors text-center">
                <span class="text-emerald-400 font-bold uppercase tracking-widest text-xs">True Hourly Cost</span>
                <span class="text-5xl font-black text-white leading-none" id="outTrueCost">--</span>
              </div>

              <div class="grid grid-cols-2 gap-4">
                <div class="bg-slate-800 p-4 rounded-sm border border-slate-700">
                  <span class="text-slate-400 font-bold uppercase tracking-widest text-[10px] block mb-1">Base Wages (Annual)</span>
                  <span class="text-xl font-black text-white" id="outBaseTotal">--</span>
                </div>
                <div class="bg-slate-800 p-4 rounded-sm border border-slate-700">
                  <span class="text-slate-400 font-bold uppercase tracking-widest text-[10px] block mb-1">Total Burden (Annual)</span>
                  <span class="text-xl font-black text-emerald-400" id="outBurdenTotal">--</span>
                </div>
                <div class="bg-slate-800 p-4 rounded-sm border border-slate-700 col-span-2">
                  <span class="text-slate-400 font-bold uppercase tracking-widest text-[10px] block mb-1">Total Cost to Company (Annual)</span>
                  <span class="text-3xl font-black text-white" id="outGrandTotal">--</span>
                </div>
              </div>

            </div>
          </div>

        </div>
      </div>
    </div>
  </section>

  <!-- Skyscraper Content -->
  <section class="py-16 px-4 sm:px-6 lg:px-8 bg-white border-t border-gray-100">
    <div class="max-w-4xl mx-auto space-y-16">
      
      <div>
        <h2 class="text-3xl font-bold text-gray-900 mb-6 flex items-center gap-3">
          The Unbillable Hour Trap
        </h2>
        <p class="text-lg text-gray-700 leading-relaxed mb-6">
          Most new business owners simply look at a technician's $25 hourly rate, add $5 for taxes, and assume the tech costs $30/hour. They then charge the customer $80/hour and wonder why they are going bankrupt at the end of the year.
        </p>
        <p class="text-lg text-gray-700 leading-relaxed mb-6">
          The reality is a technician in a typical 40-hour workweek (2,080 hours per year) only physically wrenches on equipment in front of a customer for about <strong>1,200 to 1,600 hours</strong> per year. The rest of the time is spent:
        </p>
        <ul class="list-disc pl-8 mb-6 text-gray-700 space-y-2 font-medium">
          <li>Sitting in traffic driving to the customer's house.</li>
          <li>Driving to the supply house to pick up a contactor or motor.</li>
          <li>Attending morning shop meetings.</li>
          <li>Taking PTO, Sick Days, or Holidays.</li>
        </ul>
        <div class="bg-slate-900 text-white p-6 rounded-sm shadow-md mb-6">
          <p class="font-bold text-emerald-400 mb-2 uppercase tracking-wider text-sm">The 10-Year Veteran Reality:</p>
          <p class="text-gray-300 leading-relaxed">
            You must pay the technician for all 2,080 hours. But you can only generate revenue during the 1,500 billable hours. That means the cost of those 580 "wasted" hours must be divided up and absorbed into the billable hours. This is why a $25/hour technician often costs the business $55 to $65 for every hour they actually bill.
          </p>
        </div>
      </div>

    </div>
  </section>

  <!-- Script -->
  <script>
    const btnCalculate = document.getElementById('btnCalculate')!;
    
    // Inputs
    const inBaseWage = document.getElementById('baseWage') as HTMLInputElement;
    const inBillableHours = document.getElementById('billableHours') as HTMLInputElement;
    const inTaxes = document.getElementById('taxes') as HTMLInputElement;
    const inBenefits = document.getElementById('benefits') as HTMLInputElement;
    const inVanCost = document.getElementById('vanCost') as HTMLInputElement;

    // Outputs
    const outTrueCost = document.getElementById('outTrueCost')!;
    const outBaseTotal = document.getElementById('outBaseTotal')!;
    const outBurdenTotal = document.getElementById('outBurdenTotal')!;
    const outGrandTotal = document.getElementById('outGrandTotal')!;

    btnCalculate.addEventListener('click', () => {
        const baseWage = parseFloat(inBaseWage.value) || 0;
        let billableHours = parseFloat(inBillableHours.value) || 1500;
        if (billableHours <= 0) billableHours = 1;

        const taxes = parseFloat(inTaxes.value) || 0;
        const benefits = parseFloat(inBenefits.value) || 0;
        const vanCost = parseFloat(inVanCost.value) || 0;

        // Base wage is paid for standard full time 2080 hours
        const annualBaseTotal = baseWage * 2080;
        
        // Total burden items
        const annualBurdenTotal = taxes + benefits + vanCost;

        // Grand Total
        const grandTotal = annualBaseTotal + annualBurdenTotal;

        // True Hourly Cost (Divided strictly by BILLABLE hours)
        const trueCost = grandTotal / billableHours;

        outTrueCost.innerText = `$${trueCost.toFixed(2)}`;
        outBaseTotal.innerText = `$${annualBaseTotal.toLocaleString()}`;
        outBurdenTotal.innerText = `$${annualBurdenTotal.toLocaleString()}`;
        outGrandTotal.innerText = `$${grandTotal.toLocaleString()}`;
    });
  </script>
</Layout>
