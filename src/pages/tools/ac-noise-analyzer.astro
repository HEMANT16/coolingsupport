---
import Layout from '../../layouts/Layout.astro';

const title = "Free AC Noise Analyzer | Diagnose Air Conditioner Sounds";
const description = "Use our interactive AC Noise Analyzer to figure out exactly what is broken inside your air conditioner based on the sound it is making (buzzing, clicking, squealing, etc.).";
import AuthorBadge from '../../components/AuthorBadge.astro';
---

<Layout title={title} description={description}>
  
  <!-- Schema Injection -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "AC Noise Analyzer",
    "author": { "@type": "Person", "name": "Mike Reynolds" },
    "description": description,
    "applicationCategory": "Utility",
    "operatingSystem": "All",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD"
    }
  })} />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Why is my AC making a loud buzzing noise?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "A loud buzzing noise from the outside AC unit usually indicates an electrical issue, such as a failed dual run capacitor or a stuck contactor relay. You should turn off the AC immediately to prevent damage to the compressor."
        }
      },
      {
        "@type": "Question",
        "name": "Is a hissing sound from an AC dangerous?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes, a hissing or bubbling sound usually indicates a refrigerant leak. Running the AC without proper refrigerant levels can permanently destroy the compressor. Turn the system off and call a technician."
        }
      }
    ]
  })} />

  <!-- Hero Section -->
  <section class="relative pt-24 pb-12 overflow-hidden bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900">
    <div class="absolute inset-0 bg-[url('/grid-pattern.svg')] opacity-10"></div>
    <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-md bg-cyan-500/10 border border-cyan-500/20 text-cyan-400 text-sm font-semibold mb-6">
        <span class="flex h-2 w-2 rounded-md bg-cyan-500 animate-pulse"></span>
        AI Diagnostic Engine
      </div>
      <h1 class="text-4xl md:text-6xl font-black text-white tracking-tight mb-6">
        AC Noise <span class="text-transparent bg-clip-text bg-slate-800">Analyzer</span>
      </h1>
      <div class="mt-8 mb-4 max-w-2xl mx-auto"><AuthorBadge name="Mike Reynolds" role="HVAC Expert" image="/images/mike-reynolds.png" date="June 14, 2026" /></div>
      <p class="text-xl text-slate-300 max-w-2xl mx-auto leading-relaxed">
        Don't let a strange noise destroy your compressor. Select the sound your AC is making to instantly identify the problem, the danger level, and the estimated repair cost.
      </p>
    </div>
  </section>

  <!-- Interactive Diagnostic Tool -->
  <section class="py-12 px-4 sm:px-6 lg:px-8 bg-gray-50 relative z-10 -mt-6">
    <div class="max-w-4xl mx-auto bg-white rounded-sm shadow-md border border-gray-200 overflow-hidden">
      
      <!-- App Header -->
      <div class="bg-gray-900 px-6 py-4 flex items-center justify-between">
        <div class="flex items-center gap-3">
          <span class="text-cyan-400">️</span>
          <h2 class="text-white font-bold text-lg">Live Noise Analyzer</h2>
        </div>
        <div class="flex gap-1.5">
          <div class="w-3 h-3 rounded-md bg-red-500"></div>
          <div class="w-3 h-3 rounded-md bg-yellow-500"></div>
          <div class="w-3 h-3 rounded-md bg-green-500"></div>
        </div>
      </div>

      <div class="p-6 sm:p-10">
        
        <!-- Quick Answer Output -->
        <div class="mb-8 p-6 bg-slate-50 rounded-sm border border-slate-200 shadow-inner">
          <h3 class="text-sm font-bold text-slate-500 uppercase tracking-wider mb-2">Emergency Assessment</h3>
          <p id="quickAnswerText" class="text-xl text-slate-800 leading-relaxed font-medium">
            Select the location and sound type below to diagnose your AC.
          </p>
        </div>

        <!-- Inputs Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-10">
          
          <!-- Location Input -->
          <div>
            <label class="block text-sm font-bold text-gray-700 mb-3 uppercase tracking-wide">1. Where is the sound coming from?</label>
            <div class="flex gap-3">
              <button class="loc-btn active flex-1 py-3 px-4 font-bold rounded-sm border-2 border-cyan-500 bg-cyan-50 text-cyan-700 transition-all focus:outline-none shadow-sm" data-val="outside">
                Outside Unit
              </button>
              <button class="loc-btn flex-1 py-3 px-4 font-bold rounded-sm border border-gray-200 text-gray-500 hover:border-cyan-500 hover:text-cyan-600 transition-all focus:outline-none" data-val="inside">
                Inside Unit / Vents
              </button>
            </div>
            <input type="hidden" id="locationVal" value="outside" />
          </div>

          <!-- Sound Input -->
          <div>
            <label class="block text-sm font-bold text-gray-700 mb-3 uppercase tracking-wide">2. What does it sound like?</label>
            <div class="flex flex-wrap gap-2">
              <button class="sound-btn active py-2 px-4 text-sm font-bold rounded-sm border-2 border-cyan-500 bg-cyan-50 text-cyan-700 transition-all focus:outline-none shadow-sm" data-val="buzzing">Buzzing</button>
              <button class="sound-btn py-2 px-4 text-sm font-bold rounded-sm border border-gray-200 text-gray-500 hover:border-cyan-500 hover:text-cyan-600 transition-all focus:outline-none" data-val="hissing">Hissing</button>
              <button class="sound-btn py-2 px-4 text-sm font-bold rounded-sm border border-gray-200 text-gray-500 hover:border-cyan-500 hover:text-cyan-600 transition-all focus:outline-none" data-val="screeching">Screeching</button>
              <button class="sound-btn py-2 px-4 text-sm font-bold rounded-sm border border-gray-200 text-gray-500 hover:border-cyan-500 hover:text-cyan-600 transition-all focus:outline-none" data-val="rattling">Rattling</button>
              <button class="sound-btn py-2 px-4 text-sm font-bold rounded-sm border border-gray-200 text-gray-500 hover:border-cyan-500 hover:text-cyan-600 transition-all focus:outline-none" data-val="clicking">Clicking</button>
            </div>
            <input type="hidden" id="soundVal" value="buzzing" />
          </div>
        </div>

        <!-- Dashboard Outputs -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 pt-8 border-t border-gray-100">
          
          <div class="p-6 bg-white rounded-sm border border-gray-200 shadow-sm flex flex-col justify-center items-center text-center">
            <span class="text-sm font-bold text-gray-500 uppercase tracking-wider mb-2">Likely Cause</span>
            <span id="causeResult" class="text-2xl font-black text-gray-900 leading-tight">Failed Capacitor</span>
          </div>

          <div class="p-6 bg-white rounded-sm border border-gray-200 shadow-sm flex flex-col justify-center items-center text-center">
            <span class="text-sm font-bold text-gray-500 uppercase tracking-wider mb-2">Danger Level</span>
            <div id="dangerPill" class="px-4 py-1.5 rounded-md bg-red-100 text-red-700 font-black text-xl tracking-tight uppercase shadow-inner">
              CRITICAL
            </div>
            <span id="dangerDesc" class="text-xs font-bold text-red-500 mt-2">Turn OFF Immediately</span>
          </div>

          <div class="p-6 bg-white rounded-sm border border-gray-200 shadow-sm flex flex-col justify-center items-center text-center">
            <span class="text-sm font-bold text-gray-500 uppercase tracking-wider mb-2">Est. Repair Cost</span>
            <span id="costResult" class="text-3xl font-black text-slate-800">$150 - $300</span>
          </div>

        </div>

      </div>
    </div>
  </section>

  <!-- Skyscraper Content -->
  <section class="py-16 px-4 sm:px-6 lg:px-8 bg-white border-t border-gray-100">
    <div class="max-w-4xl mx-auto space-y-16">
      
      <!-- Section 1: The Turn It Off Protocol -->
      <div>
        <h2 class="text-3xl font-bold text-gray-900 mb-6 flex items-center gap-3">
          The "Turn It Off" Protocol
        </h2>
        <p class="text-lg text-gray-700 leading-relaxed mb-6">Certain sounds mean your air conditioner is actively destroying itself. Continuing to run it will turn a $150 repair into a $2,500 system replacement.</p>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="bg-red-50 rounded-sm border border-red-200 p-6 flex flex-col h-full shadow-sm">
            <h3 class="text-xl font-bold text-red-900 mb-2">Loud Buzzing (Outside)</h3>
            <p class="text-red-800 leading-relaxed">This usually means the capacitor has failed, but the compressor is still trying to draw power to start. This causes severe electrical overheating. Turn the breaker off immediately.</p>
          </div>
          <div class="bg-red-50 rounded-sm border border-red-200 p-6 flex flex-col h-full shadow-sm">
            <h3 class="text-xl font-bold text-red-900 mb-2">Screeching (Inside or Outside)</h3>
            <p class="text-red-800 leading-relaxed">This is metal-on-metal friction. A fan motor bearing has failed. If it seizes completely while drawing power, it can catch fire or short out the main control board.</p>
          </div>
        </div>
      </div>

      <!-- Section 1.5: 3 Steps Before Calling a Pro -->
      <div>
        <h2 class="text-3xl font-bold text-gray-900 mb-6 flex items-center gap-3">
          3 Steps Before You Call a Pro
        </h2>
        <div class="space-y-4">
          <div class="bg-white p-6 rounded-sm shadow-sm border border-gray-200 flex gap-4 items-start">
            <div class="flex-shrink-0 w-8 h-8 bg-cyan-100 text-cyan-700 rounded-md flex items-center justify-center font-bold">1</div>
            <div>
              <h3 class="text-lg font-bold text-gray-900 mb-1">Turn Off the System</h3>
              <p class="text-gray-600">Immediately stop the thermostat and flip the breaker. Running a struggling compressor is the #1 way to turn a $150 repair into a $2,500 total system replacement.</p>
            </div>
          </div>
          <div class="bg-white p-6 rounded-sm shadow-sm border border-gray-200 flex gap-4 items-start">
            <div class="flex-shrink-0 w-8 h-8 bg-cyan-100 text-cyan-700 rounded-md flex items-center justify-center font-bold">2</div>
            <div>
              <h3 class="text-lg font-bold text-gray-900 mb-1">Inspect for Simple Blockages</h3>
              <p class="text-gray-600">Walk outside and look inside the condenser grate. Remove any sticks, leaves, or debris that might be striking the fan blades.</p>
            </div>
          </div>
          <div class="bg-white p-6 rounded-sm shadow-sm border border-gray-200 flex gap-4 items-start">
            <div class="flex-shrink-0 w-8 h-8 bg-cyan-100 text-cyan-700 rounded-md flex items-center justify-center font-bold">3</div>
            <div>
              <h3 class="text-lg font-bold text-gray-900 mb-1">Check Your Indoor Filter</h3>
              <p class="text-gray-600">A severely clogged filter restricts airflow, causing the evaporator coils to freeze over solid in ice. This leads to a struggling compressor and humming or hissing noises.</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Section 1.6: DIY vs Professional Repair Matrix -->
      <div>
        <h2 class="text-3xl font-bold text-gray-900 mb-6 flex items-center gap-3">
          <span class="text-cyan-500">️</span> DIY vs. Professional Repair
        </h2>
        <p class="text-lg text-gray-700 leading-relaxed mb-6">Always put safety first. Air conditioning systems use 240V high-voltage electricity and pressurized chemicals.</p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="bg-green-50 p-6 rounded-sm border border-green-200 shadow-sm">
            <h3 class="text-xl font-bold text-green-900 mb-4 border-b border-green-200 pb-2">Safe for Homeowners</h3>
            <ul class="space-y-3 text-green-800">
              <li class="flex items-center gap-2"> Replacing the air filter</li>
              <li class="flex items-center gap-2"> Cleaning debris from outdoor fins</li>
              <li class="flex items-center gap-2"> Pouring vinegar down the condensate drain</li>
              <li class="flex items-center gap-2"> Resetting the circuit breaker</li>
            </ul>
          </div>
          <div class="bg-red-50 p-6 rounded-sm border border-red-200 shadow-sm">
            <h3 class="text-xl font-bold text-red-900 mb-4 border-b border-red-200 pb-2">Requires HVAC Professional</h3>
            <ul class="space-y-3 text-red-800">
              <li class="flex items-start gap-2"> <strong>Replacing Capacitors</strong> (Holds lethal charge even when off)</li>
              <li class="flex items-start gap-2"> Testing high-voltage contactor relays</li>
              <li class="flex items-start gap-2"> Finding and patching refrigerant leaks</li>
              <li class="flex items-start gap-2"> Replacing a fan motor</li>
            </ul>
          </div>
        </div>
      </div>

      <!-- Section 2: Anatomy of Noises -->
      <div>
        <h2 class="text-3xl font-bold text-gray-900 mb-6 flex items-center gap-3">
          <span class="text-cyan-500">️</span> The Physics of AC Sounds
        </h2>
        <p class="text-lg text-gray-700 leading-relaxed mb-6">HVAC technicians diagnose 80% of problems just by listening. Here is the mechanical reason behind each noise.</p>
        <div class="overflow-x-auto bg-white rounded-sm shadow-sm border border-gray-200">
          <table class="w-full text-left border-collapse">
            <thead>
              <tr class="bg-gray-50 border-b border-gray-200">
                <th class="p-4 font-bold text-gray-900 w-1/4">The Sound</th>
                <th class="p-4 font-bold text-cyan-700 w-3/4">The Mechanical Reality</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100 text-gray-700">
              <tr>
                <td class="p-4 font-bold">Hissing / Bubbling</td>
                <td class="p-4">High-pressure refrigerant gas is escaping through a microscopic crack in the copper coils. Bubbling means it is mixing with moisture or oil.</td>
              </tr>
              <tr>
                <td class="p-4 font-bold">Buzzing</td>
                <td class="p-4">Electrical arcing. High voltage is jumping a gap because a relay (contactor) or capacitor is failing to close or discharge properly.</td>
              </tr>
              <tr>
                <td class="p-4 font-bold">Rattling</td>
                <td class="p-4">Vibration harmonics. A screw has vibrated loose, causing a metal panel to strike another piece of metal 60 times per second.</td>
              </tr>
              <tr>
                <td class="p-4 font-bold">Humming</td>
                <td class="p-4">Often caused by a frozen indoor evaporator coil due to restricted airflow, or a struggling outdoor compressor that cannot start.</td>
              </tr>
              <tr>
                <td class="p-4 font-bold">Grinding</td>
                <td class="p-4">Severe metal-on-metal friction. This usually indicates that the outdoor fan motor bearings are completely destroyed, or the blower wheel has come loose.</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Section 3: The Repair Cost Matrix -->
      <div>
        <h2 class="text-3xl font-bold text-gray-900 mb-6 flex items-center gap-3">
          National Repair Cost Matrix
        </h2>
        <p class="text-lg text-gray-700 leading-relaxed mb-6">Based on national HVAC averages, here is what you should expect to pay for the components causing these noises.</p>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="p-6 bg-white rounded-sm border border-gray-200 shadow-sm text-center">
            <h3 class="text-lg font-bold text-gray-900 mb-1">Capacitor</h3>
            <p class="text-sm text-gray-500 mb-3">(Causes Buzzing)</p>
            <p class="text-3xl font-black text-slate-800">$150 - $250</p>
          </div>
          <div class="p-6 bg-white rounded-sm border border-gray-200 shadow-sm text-center">
            <h3 class="text-lg font-bold text-gray-900 mb-1">Fan Motor</h3>
            <p class="text-sm text-gray-500 mb-3">(Causes Screeching)</p>
            <p class="text-3xl font-black text-slate-800">$300 - $600</p>
          </div>
          <div class="p-6 bg-white rounded-sm border border-gray-200 shadow-sm text-center">
            <h3 class="text-lg font-bold text-gray-900 mb-1">Refrigerant Leak</h3>
            <p class="text-sm text-gray-500 mb-3">(Causes Hissing)</p>
            <p class="text-3xl font-black text-slate-800">$500 - $1,500</p>
          </div>
        </div>
      </div>

      <!-- Section 4: Exceptions -->
      <div>
        <h2 class="text-3xl font-bold text-gray-900 mb-6 flex items-center gap-3">
          Is it just normal operation?
        </h2>
        <div class="bg-green-50 rounded-sm border border-green-200 p-6">
          <p class="text-green-900 leading-relaxed mb-4">
            Not all noises are bad. A single <strong>loud click</strong> when the outside unit turns on is just the contactor relay snapping shut to deliver 240 volts. A soft, steady <strong>humming</strong> from the outside unit is just the normal operation of the compressor pushing refrigerant.
          </p>
          <p class="text-green-900 leading-relaxed">
            Likewise, a faint <strong>whooshing</strong> sound from your indoor vents simply means air is moving. As long as the air is cold and the airflow is strong, steady whooshing is normal.
          </p>
        </div>
      </div>

      <!-- Section 5: FAQs -->
      <div>
        <h2 class="text-3xl font-bold text-gray-900 mb-8 flex items-center gap-3">
          Frequently Asked Questions
        </h2>
        <div class="space-y-4">
          <details class="group bg-gray-50 rounded-sm border border-gray-200 overflow-hidden cursor-pointer open:bg-white open:ring-2 open:ring-cyan-500 open:shadow-md transition-all">
            <summary class="px-6 py-4 font-bold text-gray-900 flex justify-between items-center select-none">
              Is it safe to run my AC if it's rattling?
              <span class="text-cyan-500 group-open:rotate-180 transition-transform">▼</span>
            </summary>
            <div class="px-6 pb-4 text-gray-700 leading-relaxed border-t border-gray-100 pt-4">
              Generally, yes. A rattling sound is usually a loose panel or a stray twig in the condenser fan. However, you should inspect the unit visually to ensure nothing is obstructing the fan blades, as a blocked fan can cause the motor to overheat.
            </div>
          </details>

          <details class="group bg-gray-50 rounded-sm border border-gray-200 overflow-hidden cursor-pointer open:bg-white open:ring-2 open:ring-cyan-500 open:shadow-md transition-all">
            <summary class="px-6 py-4 font-bold text-gray-900 flex justify-between items-center select-none">
              Why does my AC hiss when it turns off?
              <span class="text-cyan-500 group-open:rotate-180 transition-transform">▼</span>
            </summary>
            <div class="px-6 pb-4 text-gray-700 leading-relaxed border-t border-gray-100 pt-4">
              A brief hissing sound lasting only a few seconds right after the AC shuts off is normal. This is simply the high-pressure and low-pressure refrigerant equalizing inside the system. If the hissing is continuous, that indicates a leak.
            </div>
          </details>

          <details class="group bg-gray-50 rounded-sm border border-gray-200 overflow-hidden cursor-pointer open:bg-white open:ring-2 open:ring-cyan-500 open:shadow-md transition-all">
            <summary class="px-6 py-4 font-bold text-gray-900 flex justify-between items-center select-none">
              Can a dirty air filter cause my AC to make noises?
              <span class="text-cyan-500 group-open:rotate-180 transition-transform">▼</span>
            </summary>
            <div class="px-6 pb-4 text-gray-700 leading-relaxed border-t border-gray-100 pt-4">
              Yes, absolutely. A severely clogged air filter blocks airflow over the evaporator coils. This causes the coils to literally freeze solid into a block of ice. When this happens, the system struggles to breathe, often producing a humming, hissing, or high-pitched whistling noise.
            </div>
          </details>

          <details class="group bg-gray-50 rounded-sm border border-gray-200 overflow-hidden cursor-pointer open:bg-white open:ring-2 open:ring-cyan-500 open:shadow-md transition-all">
            <summary class="px-6 py-4 font-bold text-gray-900 flex justify-between items-center select-none">
              Is it safe to replace an AC capacitor myself?
              <span class="text-cyan-500 group-open:rotate-180 transition-transform">▼</span>
            </summary>
            <div class="px-6 pb-4 text-gray-700 leading-relaxed border-t border-gray-100 pt-4">
              No, unless you are trained in high-voltage electrical safety. Even when you turn off the main circuit breaker, a dual-run capacitor stores a lethal electrical charge (often over 370 Volts). If you touch the terminals without properly discharging it first, it can cause severe injury or death.
            </div>
          </details>

          <details class="group bg-gray-50 rounded-sm border border-gray-200 overflow-hidden cursor-pointer open:bg-white open:ring-2 open:ring-cyan-500 open:shadow-md transition-all">
            <summary class="px-6 py-4 font-bold text-gray-900 flex justify-between items-center select-none">
              Why does my AC hum but the fan won't spin?
              <span class="text-cyan-500 group-open:rotate-180 transition-transform">▼</span>
            </summary>
            <div class="px-6 pb-4 text-gray-700 leading-relaxed border-t border-gray-100 pt-4">
              If your outdoor unit is humming but the fan blade isn't spinning, the start capacitor has almost certainly failed. The motor is trying to start (hence the hum) but lacks the electrical "kick" provided by the capacitor. You can sometimes poke the fan blade with a stick (carefully) to jump-start it, but you still need a new capacitor immediately.
            </div>
          </details>
        </div>
      </div>

    </div>
  </section>

  <!-- Interactive Logic -->
  <script>
    // Data Matrix
    const matrix = {
      outside: {
        buzzing: {
          ans: "️ <strong>Turn off your AC immediately.</strong> A loud buzzing outside means your compressor is trying to start but failing, usually due to a dead capacitor. Leaving it on will melt the compressor wires.",
          cause: "Failed Capacitor or Contactor",
          danger: "CRITICAL",
          desc: "Turn OFF Immediately",
          color: "red",
          cost: "$150 - $300"
        },
        hissing: {
          ans: "A continuous hissing or bubbling sound from the outdoor unit means high-pressure refrigerant gas is escaping through a leak. <strong>Turn the system off</strong>, as running it dry will destroy the compressor.",
          cause: "Refrigerant Leak",
          danger: "HIGH",
          desc: "Requires Technician",
          color: "red",
          cost: "$500 - $1,500"
        },
        screeching: {
          ans: "️ <strong>Turn off your AC immediately.</strong> Screeching is metal-on-metal friction. Your condenser fan motor bearings have likely failed. If the fan stops, the compressor will overheat.",
          cause: "Condenser Fan Motor",
          danger: "CRITICAL",
          desc: "Turn OFF Immediately",
          color: "red",
          cost: "$300 - $600"
        },
        rattling: {
          ans: "Rattling outside is usually a minor issue. It is typically a loose service panel, a twig that fell into the fan grate, or vibration against the concrete pad.",
          cause: "Loose Hardware / Debris",
          danger: "LOW",
          desc: "Inspect Visually",
          color: "green",
          cost: "$0 - $150"
        },
        clicking: {
          ans: "A single loud click when turning on is normal. However, <strong>rapid, continuous clicking</strong> means an electrical relay (contactor) is failing or receiving bad voltage.",
          cause: "Failing Contactor",
          danger: "MEDIUM",
          desc: "Schedule Service",
          color: "yellow",
          cost: "$100 - $250"
        }
      },
      inside: {
        buzzing: {
          ans: "Buzzing from inside the house or vents usually points to a failing blower motor, a bad indoor control board, or a loose transformer vibrating in the air handler.",
          cause: "Blower Motor / Board",
          danger: "MEDIUM",
          desc: "Schedule Service",
          color: "yellow",
          cost: "$200 - $600"
        },
        hissing: {
          ans: "Hissing from the indoor unit means your evaporator coil has a crack and is leaking refrigerant into your home. <strong>Turn off the AC</strong> and call a technician.",
          cause: "Evaporator Coil Leak",
          danger: "HIGH",
          desc: "Requires Technician",
          color: "red",
          cost: "$800 - $2,000"
        },
        screeching: {
          ans: "Screeching from the indoor unit or vents means the indoor blower motor bearings are dying. Turn it off before the motor seizes and causes electrical damage.",
          cause: "Blower Motor Bearings",
          danger: "MEDIUM",
          desc: "Turn OFF & Service",
          color: "yellow",
          cost: "$300 - $600"
        },
        rattling: {
          ans: "Rattling indoors is often just a loose duct, a clogged filter getting sucked into the blower, or an unbalanced blower wheel. Check your filter first.",
          cause: "Loose Duct / Filter",
          danger: "LOW",
          desc: "Check Filter",
          color: "green",
          cost: "$0 - $150"
        },
        clicking: {
          ans: "A soft clicking near the thermostat is normal. If it's coming from the air handler in the attic/closet, it could be a failing defrost board or sequencer.",
          cause: "Thermostat / Sequencer",
          danger: "LOW",
          desc: "Monitor It",
          color: "green",
          cost: "$0 - $200"
        }
      }
    };

    const locBtns = document.querySelectorAll('.loc-btn');
    const soundBtns = document.querySelectorAll('.sound-btn');
    const locInput = document.getElementById('locationVal') as HTMLInputElement;
    const soundInput = document.getElementById('soundVal') as HTMLInputElement;
    
    const quickAnswerText = document.getElementById('quickAnswerText')!;
    const causeResult = document.getElementById('causeResult')!;
    const dangerPill = document.getElementById('dangerPill')!;
    const dangerDesc = document.getElementById('dangerDesc')!;
    const costResult = document.getElementById('costResult')!;

    function updateUI() {
      const loc = locInput.value as 'inside' | 'outside';
      const snd = soundInput.value as 'buzzing' | 'hissing' | 'screeching' | 'rattling' | 'clicking';
      const data = matrix[loc][snd];

      quickAnswerText.innerHTML = data.ans;
      causeResult.textContent = data.cause;
      costResult.textContent = data.cost;
      dangerPill.textContent = data.danger;
      dangerDesc.textContent = data.desc;

      // Color logic
      dangerPill.className = "px-4 py-1.5 rounded-md font-black text-xl tracking-tight uppercase shadow-inner";
      if (data.color === 'red') {
        dangerPill.classList.add('bg-red-100', 'text-red-700');
        dangerDesc.className = "text-xs font-bold text-red-500 mt-2";
      } else if (data.color === 'yellow') {
        dangerPill.classList.add('bg-yellow-100', 'text-yellow-700');
        dangerDesc.className = "text-xs font-bold text-yellow-600 mt-2";
      } else {
        dangerPill.classList.add('bg-green-100', 'text-green-700');
        dangerDesc.className = "text-xs font-bold text-green-500 mt-2";
      }
    }

    // Event Listeners
    locBtns.forEach(btn => {
      btn.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLButtonElement;
        locInput.value = target.getAttribute('data-val') || 'outside';
        
        locBtns.forEach(b => {
          b.className = "loc-btn flex-1 py-3 px-4 font-bold rounded-sm border border-gray-200 text-gray-500 hover:border-cyan-500 hover:text-cyan-600 transition-all focus:outline-none";
        });
        target.className = "loc-btn active flex-1 py-3 px-4 font-bold rounded-sm border-2 border-cyan-500 bg-cyan-50 text-cyan-700 transition-all focus:outline-none shadow-sm";
        updateUI();
      });
    });

    soundBtns.forEach(btn => {
      btn.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLButtonElement;
        soundInput.value = target.getAttribute('data-val') || 'buzzing';
        
        soundBtns.forEach(b => {
          b.className = "sound-btn py-2 px-4 text-sm font-bold rounded-sm border border-gray-200 text-gray-500 hover:border-cyan-500 hover:text-cyan-600 transition-all focus:outline-none";
        });
        target.className = "sound-btn active py-2 px-4 text-sm font-bold rounded-sm border-2 border-cyan-500 bg-cyan-50 text-cyan-700 transition-all focus:outline-none shadow-sm";
        updateUI();
      });
    });

    // Handle URL parameters for direct linking
    const params = new URLSearchParams(window.location.search);
    const urlLoc = params.get('loc');
    const urlSound = params.get('sound');
    
    if (urlLoc) {
      const btn = document.querySelector(`.loc-btn[data-val="${urlLoc}"]`) as HTMLButtonElement | null;
      if (btn) {
        locInput.value = urlLoc;
        locBtns.forEach(b => {
          b.className = "loc-btn flex-1 py-3 px-4 font-bold rounded-sm border border-gray-200 text-gray-500 hover:border-cyan-500 hover:text-cyan-600 transition-all focus:outline-none";
        });
        btn.className = "loc-btn active flex-1 py-3 px-4 font-bold rounded-sm border-2 border-cyan-500 bg-cyan-50 text-cyan-700 transition-all focus:outline-none shadow-sm";
      }
    }
    if (urlSound) {
      const btn = document.querySelector(`.sound-btn[data-val="${urlSound}"]`) as HTMLButtonElement | null;
      if (btn) {
        soundInput.value = urlSound;
        soundBtns.forEach(b => {
          b.className = "sound-btn py-2 px-4 text-sm font-bold rounded-sm border border-gray-200 text-gray-500 hover:border-cyan-500 hover:text-cyan-600 transition-all focus:outline-none";
        });
        btn.className = "sound-btn active py-2 px-4 text-sm font-bold rounded-sm border-2 border-cyan-500 bg-cyan-50 text-cyan-700 transition-all focus:outline-none shadow-sm";
      }
    }

    // Initial render
    updateUI();
  </script>
</Layout>
