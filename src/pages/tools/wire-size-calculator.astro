---
import Layout from '../../layouts/Layout.astro';

const title = "HVAC Wire Size & Breaker Calculator | AWG by MCA & MOCP";
const description = "Calculate the exact wire gauge (AWG) and breaker size needed for your AC or heat pump based on MCA and MOCP ratings using NEC Article 440.";
import AuthorBadge from '../../components/AuthorBadge.astro';
---

<Layout title={title} description={description}>
  <!-- JSON-LD Schemas -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": "HVAC Wire & Breaker Calculator",
    "description": "An interactive calculator to determine required wire gauge (AWG) and circuit breaker size for air conditioners and heat pumps based on MCA and MOCP.",
    "applicationCategory": "CalculatorApplication",
    "operatingSystem": "WebBrowser",
    "featureList": "NEC Article 440 compliance, Voltage drop calculation, MCA to AWG mapping",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD"
    }
  })} />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Why is my AC breaker larger than my wire rating?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Under NEC Article 440, HVAC compressors have internal overload protection. The circuit breaker is only there to protect against short circuits and ground faults, allowing it to be oversized to handle the massive inrush current required to start the compressor without nuisance tripping."
        }
      },
      {
        "@type": "Question",
        "name": "What do MCA and MOCP mean on an AC unit?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "MCA stands for Minimum Circuit Ampacity, which determines the minimum wire thickness (AWG) required. MOCP stands for Maximum Overcurrent Protection (or Max Fuse), which dictates the absolute maximum size of the circuit breaker you can install."
        }
      },
      {
        "@type": "Question",
        "name": "Can I use 10 AWG wire on a 40 Amp breaker for my AC?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes, if the AC's data plate lists an MCA of 30 Amps or less and an MOCP of 40 Amps. While a 40A breaker on 10 AWG wire violates standard residential rules, it is perfectly legal for dedicated HVAC circuits under NEC Article 440."
        }
      }
    ]
  })} />

  <!-- Hero Section -->
  <section class="bg-gray-900 text-white py-16 px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl mx-auto text-center">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-md bg-yellow-500/20 text-yellow-400 font-bold text-xs uppercase tracking-widest mb-6 border border-yellow-500/30">
        Code Compliant Sizing
      </div>
      <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight mb-6">
        HVAC Wire & Breaker <span class="text-yellow-400">Calculator</span>
      </h1>
      <div class="mt-8 mb-4 max-w-2xl mx-auto"><AuthorBadge name="Mike Reynolds" role="HVAC Expert" image="/images/mike-reynolds.png" date="June 14, 2026" /></div>
      <p class="text-xl text-gray-300 max-w-2xl mx-auto mb-8 font-light">
        Find the exact NM-B wire gauge and breaker size required for your air conditioner, heat pump, or electric furnace based on NEC Article 440.
      </p>
    </div>
  </section>

  <!-- How To Use & The Calculation -->
  <section class="py-12 px-4 sm:px-6 lg:px-8 bg-white border-b border-gray-100">
    <div class="max-w-4xl mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
        <div>
          <h2 class="text-2xl font-bold text-gray-900 mb-4">How to Use This Tool</h2>
          <ol class="space-y-4 text-gray-700 list-decimal list-inside">
            <li>Walk outside to your AC condenser and locate the silver or white manufacturer data plate.</li>
            <li>Find the abbreviation <strong>MCA</strong> (Minimum Circuit Ampacity) and enter it into the calculator.</li>
            <li>Find the abbreviation <strong>MOCP</strong> (Maximum Overcurrent Protection) or <strong>Max Fuse</strong> and enter it.</li>
            <li>Estimate the distance of the wire run from your main electrical panel to the outdoor unit.</li>
          </ol>
        </div>
        <div>
          <h2 class="text-2xl font-bold text-gray-900 mb-4">The Calculation Rules</h2>
          <p class="text-gray-700 mb-4">Our engine uses strict NEC Article 440 guidelines:</p>
          <ul class="space-y-2 text-gray-700 list-disc list-inside">
            <li><strong>Wire Size:</strong> Calculated using the MCA against standard 60°C Copper NM-B limits (e.g., MCA ≤ 30A = 10 AWG).</li>
            <li><strong>Breaker Size:</strong> Directly matched to the exact MOCP rating allowed by the manufacturer.</li>
            <li><strong>Voltage Drop:</strong> Runs over 75 feet automatically trigger a wire gauge upsize to prevent compressor stalling.</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Interactive Calculator App -->
  <section class="py-12 px-4 sm:px-6 lg:px-8 bg-gray-50 relative z-10">
    <div class="max-w-6xl mx-auto bg-white rounded-sm shadow-md border border-gray-200 overflow-hidden">
      
      <!-- App Header -->
      <div class="bg-blue-900 px-6 py-4 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div class="flex items-center gap-3">
          <h2 class="text-white font-bold text-lg">Electrical Sizing Engine</h2>
        </div>
        
        <!-- Mode Toggle -->
        <div class="flex bg-blue-950 p-1 rounded-sm w-full sm:w-auto">
          <button id="btnExact" class="flex-1 sm:flex-none px-6 py-2 rounded-lg text-sm font-bold transition-all bg-blue-600 text-white shadow-sm">
            Exact (Nameplate)
          </button>
          <button id="btnEstimate" class="flex-1 sm:flex-none px-6 py-2 rounded-lg text-sm font-bold transition-all text-blue-300 hover:text-white">
            Estimate (Tonnage)
          </button>
        </div>
      </div>

      <div class="p-6 md:p-8">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
          
          <!-- Controls (Left: 7 cols) -->
          <div class="lg:col-span-7 space-y-8">
            
            <!-- EXACT MODE INPUTS -->
            <div id="modeExact" class="space-y-6">
              <div class="bg-blue-50 border border-blue-200 p-4 rounded-sm mb-6">
                <p class="text-blue-800 text-sm font-medium"><strong>Pro Tip:</strong> Look at the silver or white sticker on the side of your outdoor unit to find the exact MCA and MOCP ratings.</p>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                <!-- MCA -->
                <div>
                  <label class="block text-sm font-bold text-gray-900 uppercase tracking-wider mb-3">MCA (Min Circuit Ampacity)</label>
                  <div class="flex rounded-sm shadow-sm border-2 border-gray-300 focus-within:border-blue-500 focus-within:ring-1 focus-within:ring-blue-500 overflow-hidden bg-white transition-colors">
                    <input type="number" id="mcaInput" value="18.2" step="0.1" min="1" class="w-full border-none focus:ring-0 text-gray-900 text-xl block p-3 font-bold bg-transparent" />
                    <span class="inline-flex items-center px-4 bg-gray-100 text-gray-600 border-l border-gray-300 font-bold uppercase tracking-wider text-sm">
                      Amps
                    </span>
                  </div>
                </div>

                <!-- MOCP -->
                <div>
                  <label class="block text-sm font-bold text-gray-900 uppercase tracking-wider mb-3">MOCP (Max Fuse / Breaker)</label>
                  <div class="flex rounded-sm shadow-sm border-2 border-gray-300 focus-within:border-blue-500 focus-within:ring-1 focus-within:ring-blue-500 overflow-hidden bg-white transition-colors">
                    <input type="number" id="mocpInput" value="30" step="5" min="15" class="w-full border-none focus:ring-0 text-gray-900 text-xl block p-3 font-bold bg-transparent" />
                    <span class="inline-flex items-center px-4 bg-gray-100 text-gray-600 border-l border-gray-300 font-bold uppercase tracking-wider text-sm">
                      Amps
                    </span>
                  </div>
                </div>
              </div>
            </div>

            <!-- ESTIMATION MODE INPUTS (Hidden by default) -->
            <div id="modeEstimate" class="space-y-6 hidden">
              <div class="bg-yellow-50 border border-yellow-200 p-4 rounded-sm mb-6">
                <p class="text-yellow-800 text-sm font-bold">️ Warning: Estimation Mode</p>
                <p class="text-yellow-700 text-xs mt-1">This provides a rough average for modern 14-16 SEER AC units. You must read the actual nameplate before purchasing wire or breakers.</p>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                <!-- Tonnage -->
                <div>
                  <label class="block text-sm font-bold text-gray-900 uppercase tracking-wider mb-3">System Size (Tonnage)</label>
                  <select id="tonnageSelect" class="w-full bg-white border border-gray-300 text-gray-900 text-sm rounded-sm focus:ring-blue-500 focus:border-blue-500 block p-3 shadow-sm font-semibold">
                    <option value="1.5">1.5 Ton (18,000 BTU)</option>
                    <option value="2.0" selected>2.0 Ton (24,000 BTU)</option>
                    <option value="2.5">2.5 Ton (30,000 BTU)</option>
                    <option value="3.0">3.0 Ton (36,000 BTU)</option>
                    <option value="3.5">3.5 Ton (42,000 BTU)</option>
                    <option value="4.0">4.0 Ton (48,000 BTU)</option>
                    <option value="5.0">5.0 Ton (60,000 BTU)</option>
                  </select>
                </div>
                
                <!-- System Type -->
                <div>
                  <label class="block text-sm font-bold text-gray-900 uppercase tracking-wider mb-3">Equipment Type</label>
                  <select id="typeSelect" class="w-full bg-white border border-gray-300 text-gray-900 text-sm rounded-sm focus:ring-blue-500 focus:border-blue-500 block p-3 shadow-sm font-semibold">
                    <option value="ac" selected>AC / Heat Pump (Outdoor)</option>
                    <option value="furnace">10kW Electric Heat (Indoor)</option>
                  </select>
                </div>
              </div>
            </div>

            <!-- Global Inputs (Distance) -->
            <div class="bg-gray-50 p-6 rounded-sm border border-gray-200 mt-8">
              <div class="flex justify-between items-end mb-4">
                <label class="block text-sm font-bold text-gray-900 uppercase tracking-wider">Distance from Panel to Unit</label>
                <span class="text-xl font-black text-blue-600" id="distanceDisplay">50 ft</span>
              </div>
              <input type="range" id="distance" min="10" max="200" step="10" value="50" class="w-full h-2 bg-gray-300 rounded-lg appearance-none cursor-pointer accent-blue-600">
              <div class="flex justify-between text-xs text-gray-500 mt-2 font-bold">
                <span>10 ft</span>
                <span>200 ft</span>
              </div>
              <p class="text-xs text-gray-500 mt-3 font-medium">Distances over 75 feet may require upsizing the wire gauge to prevent voltage drop.</p>
            </div>

          </div>

          <!-- Output Panel (Right: 5 cols) -->
          <div class="lg:col-span-5 bg-gray-900 rounded-sm p-6 lg:p-8 text-white flex flex-col relative overflow-hidden shadow-md">
            <div class="absolute top-0 right-0 w-64 h-64 bg-yellow-500 rounded-md mix-blend-overlay filter blur-3xl opacity-10 transform translate-x-1/2 -translate-y-1/2"></div>
            
            <h3 class="text-gray-400 font-bold uppercase tracking-widest text-sm mb-6 border-b border-gray-800 pb-4">Required Specifications</h3>
            
            <div class="space-y-6 flex-grow">
              
              <!-- Required Wire -->
              <div class="flex flex-col gap-2 bg-gray-800/80 p-5 rounded-sm border border-gray-700">
                <span class="text-yellow-400 font-bold uppercase tracking-widest text-xs flex items-center gap-2"><span class="text-base"></span> Required Wire Gauge (Copper)</span>
                <span class="text-4xl font-black text-white" id="outWire">12 AWG</span>
                <span class="text-gray-400 text-xs font-medium mt-1">Standard NM-B (Romex) / THHN</span>
              </div>

              <!-- Required Breaker -->
              <div class="flex flex-col gap-2 bg-gray-800/80 p-5 rounded-sm border border-gray-700">
                <span class="text-red-400 font-bold uppercase tracking-widest text-xs flex items-center gap-2"><span class="text-base"></span> Circuit Breaker Size</span>
                <span class="text-4xl font-black text-white" id="outBreaker">30 Amp</span>
                <span class="text-gray-400 text-xs font-medium mt-1">Max allowable. Do not exceed.</span>
              </div>
              
              <!-- Warnings -->
              <div id="warningBox" class="mt-4 bg-yellow-900/40 border-l-4 border-yellow-500 p-4 rounded-r-xl hidden">
                <p class="text-yellow-200 text-sm font-bold mb-1 uppercase tracking-wider">Voltage Drop Warning</p>
                <p class="text-yellow-100/80 text-xs leading-relaxed" id="warningText">
                  Because the run is over 75 feet, you must upsize the wire by one step to prevent voltage drop and compressor stalling.
                </p>
              </div>

            </div>

          </div>

        </div>
      </div>
    </div>
  </section>

  <!-- Skyscraper Content (10-Year Veteran Tone) -->
  <section class="py-16 px-4 sm:px-6 lg:px-8 bg-white border-t border-gray-100">
    <div class="max-w-4xl mx-auto space-y-16">
      
      <!-- Section 1: The Inspector Fallacy -->
      <div>
        <h2 class="text-3xl font-bold text-gray-900 mb-6 flex items-center gap-3">
          The "Home Inspector" Fallacy
        </h2>
        <p class="text-lg text-gray-700 leading-relaxed mb-6">
          If you are selling a house, there is a very high probability that a general home inspector will look at your electrical panel, see a 40 Amp breaker connected to 10 AWG wire feeding your AC, and flag it as a "severe fire hazard." <strong>The inspector is almost always wrong.</strong>
        </p>
        <p class="text-lg text-gray-700 leading-relaxed mb-6">
          For standard lighting and outlets in a house, 10 AWG wire is legally limited to a 30 Amp breaker. But HVAC compressors are totally different. Under <strong>NEC Article 440</strong>, air conditioners have built-in internal overload protectors inside the compressor. The breaker in the panel is not there to protect against overloads; it is only there to protect against direct short circuits to ground.
        </p>
        <div class="bg-gray-900 text-white p-6 rounded-sm shadow-md mb-6">
          <p class="font-bold text-yellow-400 mb-2 uppercase tracking-wider text-sm">The 10-Year Veteran Reality:</p>
          <p class="text-gray-300 leading-relaxed">
            Compressors pull a massive surge of electricity (Inrush Current) for a split second when they start up. If you put 10 AWG wire on a 30 Amp breaker, that surge will randomly trip the breaker on hot days. NEC 440 allows you to intentionally oversize the breaker (up to the MOCP) so it doesn't trip on startup, while the wire stays small because the running current (MCA) is very low.
          </p>
        </div>
      </div>

      <!-- Section 2: MCA and MOCP -->
      <div>
        <h2 class="text-3xl font-bold text-gray-900 mb-6 flex items-center gap-3">
          MCA vs. MOCP Explained
        </h2>
        <p class="text-lg text-gray-700 leading-relaxed mb-6">
          Never guess the wire size based on the tonnage of the unit. You must look at the silver data plate on the side of the condenser.
        </p>
        <ul class="space-y-4 text-gray-700 text-lg mb-6">
          <li class="flex items-start gap-3">
            <span class="text-blue-500 font-bold mt-1">▶</span>
            <span><strong>MCA (Minimum Circuit Ampacity):</strong> This dictates the thickness of the copper wire you must run. The wire must be rated to carry at least this many amps indefinitely. (e.g., An MCA of 18 means you must use 12 AWG wire, which is rated for 20 amps).</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-blue-500 font-bold mt-1">▶</span>
            <span><strong>MOCP / Max Fuse (Maximum Overcurrent Protection):</strong> This is the absolute largest circuit breaker you can legally snap into the panel. It exists to cut power if the motor dead-shorts.</span>
          </li>
        </ul>
      </div>

      <!-- Section 3: The Aluminum Wire Trap -->
      <div>
        <h2 class="text-3xl font-bold text-gray-900 mb-6 flex items-center gap-3">
          The Aluminum Wire Trap
        </h2>
        <p class="text-lg text-gray-700 leading-relaxed mb-6">
          If you are replacing a dead AC unit from the 1980s or 1990s, there is a good chance the original installer ran thick, silver-colored Aluminum wire from the panel to the outside disconnect box.
        </p>
        <p class="text-lg text-gray-700 leading-relaxed mb-6">
          <strong>Do not attach modern copper wiring directly to old aluminum wiring.</strong> When copper and aluminum touch and heat up under heavy electrical loads, they expand and contract at different rates. The connection will loosen, arc, and melt the disconnect box right off the side of your house. 
        </p>
        <p class="text-lg text-gray-700 leading-relaxed">
          If you absolutely must reuse an old aluminum feed, you must hire an electrician to terminate the connection using specialized anti-oxidant paste and expensive "Polaris" mechanical lugs.
        </p>
      </div>

      <!-- Section 4: FAQs -->
      <div>
        <h2 class="text-3xl font-bold text-gray-900 mb-8 flex items-center gap-3">
          Electrical Sizing FAQ
        </h2>
        <div class="space-y-4">
          <details class="group bg-gray-50 rounded-sm border border-gray-200 overflow-hidden cursor-pointer open:bg-white open:ring-2 open:ring-blue-500 open:shadow-md transition-all">
            <summary class="px-6 py-4 font-bold text-gray-900 flex justify-between items-center select-none">
              Why is my AC breaker larger than my wire rating?
              <span class="text-blue-500 group-open:rotate-180 transition-transform">▼</span>
            </summary>
            <div class="px-6 pb-4 text-gray-700 leading-relaxed border-t border-gray-100 pt-4 text-sm">
              Under NEC Article 440, HVAC compressors have internal overload protection. The circuit breaker is only there to protect against short circuits and ground faults, allowing it to be oversized to handle the massive inrush current required to start the compressor without nuisance tripping.
            </div>
          </details>

          <details class="group bg-gray-50 rounded-sm border border-gray-200 overflow-hidden cursor-pointer open:bg-white open:ring-2 open:ring-blue-500 open:shadow-md transition-all">
            <summary class="px-6 py-4 font-bold text-gray-900 flex justify-between items-center select-none">
              What do MCA and MOCP mean on an AC unit?
              <span class="text-blue-500 group-open:rotate-180 transition-transform">▼</span>
            </summary>
            <div class="px-6 pb-4 text-gray-700 leading-relaxed border-t border-gray-100 pt-4 text-sm">
              MCA stands for Minimum Circuit Ampacity, which determines the minimum wire thickness (AWG) required. MOCP stands for Maximum Overcurrent Protection (or Max Fuse), which dictates the absolute maximum size of the circuit breaker you can install.
            </div>
          </details>

          <details class="group bg-gray-50 rounded-sm border border-gray-200 overflow-hidden cursor-pointer open:bg-white open:ring-2 open:ring-blue-500 open:shadow-md transition-all">
            <summary class="px-6 py-4 font-bold text-gray-900 flex justify-between items-center select-none">
              Can I use 10 AWG wire on a 40 Amp breaker for my AC?
              <span class="text-blue-500 group-open:rotate-180 transition-transform">▼</span>
            </summary>
            <div class="px-6 pb-4 text-gray-700 leading-relaxed border-t border-gray-100 pt-4 text-sm">
              Yes, if the AC's data plate lists an MCA of 30 Amps or less and an MOCP of 40 Amps. While a 40A breaker on 10 AWG wire violates standard residential rules, it is perfectly legal for dedicated HVAC circuits under NEC Article 440.
            </div>
          </details>
        </div>
      </div>

    </div>
  </section>

  <!-- Interactive Logic -->
  <script>
    // Elements
    const btnExact = document.getElementById('btnExact')!;
    const btnEstimate = document.getElementById('btnEstimate')!;
    const modeExact = document.getElementById('modeExact')!;
    const modeEstimate = document.getElementById('modeEstimate')!;
    
    const mcaInput = document.getElementById('mcaInput') as HTMLInputElement;
    const mocpInput = document.getElementById('mocpInput') as HTMLInputElement;
    const tonnageSelect = document.getElementById('tonnageSelect') as HTMLSelectElement;
    const typeSelect = document.getElementById('typeSelect') as HTMLSelectElement;
    const distanceSlider = document.getElementById('distance') as HTMLInputElement;
    const distanceDisplay = document.getElementById('distanceDisplay')!;

    const outWire = document.getElementById('outWire')!;
    const outBreaker = document.getElementById('outBreaker')!;
    const warningBox = document.getElementById('warningBox')!;
    const warningText = document.getElementById('warningText')!;

    let currentMode = 'exact';

    // Toggle Modes
    function setMode(mode: 'exact' | 'estimate') {
      currentMode = mode;
      if (mode === 'exact') {
        btnExact.className = "flex-1 sm:flex-none px-6 py-2 rounded-lg text-sm font-bold transition-all bg-blue-600 text-white shadow-sm";
        btnEstimate.className = "flex-1 sm:flex-none px-6 py-2 rounded-lg text-sm font-bold transition-all text-blue-300 hover:text-white";
        modeExact.classList.remove('hidden');
        modeEstimate.classList.add('hidden');
      } else {
        btnEstimate.className = "flex-1 sm:flex-none px-6 py-2 rounded-lg text-sm font-bold transition-all bg-blue-600 text-white shadow-sm";
        btnExact.className = "flex-1 sm:flex-none px-6 py-2 rounded-lg text-sm font-bold transition-all text-blue-300 hover:text-white";
        modeEstimate.classList.remove('hidden');
        modeExact.classList.add('hidden');
      }
      calculate();
    }

    btnExact.addEventListener('click', () => setMode('exact'));
    btnEstimate.addEventListener('click', () => setMode('estimate'));

    // The Logic
    function getWireAWG(mca: number, distance: number) {
      let awg = 14;
      
      // Standard 60C Copper limits (NM-B / Romex)
      if (mca <= 15) awg = 14;
      else if (mca <= 20) awg = 12;
      else if (mca <= 30) awg = 10;
      else if (mca <= 40) awg = 8;
      else if (mca <= 55) awg = 6;
      else if (mca <= 70) awg = 4;
      else if (mca <= 95) awg = 2;
      else awg = 0; // Too big for standard residental scope

      let needsUpsize = false;
      // Voltage Drop heuristic
      if (distance > 75) {
        needsUpsize = true;
        // Bump wire up one size
        if (awg === 14) awg = 12;
        else if (awg === 12) awg = 10;
        else if (awg === 10) awg = 8;
        else if (awg === 8) awg = 6;
        else if (awg === 6) awg = 4;
        else if (awg === 4) awg = 2;
      }

      return { awg, needsUpsize };
    }

    function calculate() {
      const distance = parseInt(distanceSlider.value);
      distanceDisplay.innerText = `${distance} ft`;

      let activeMCA = 0;
      let activeMOCP = 0;

      if (currentMode === 'exact') {
        activeMCA = parseFloat(mcaInput.value) || 0;
        activeMOCP = parseFloat(mocpInput.value) || 0;
      } else {
        // Estimation Mode
        const tons = parseFloat(tonnageSelect.value);
        const type = typeSelect.value;

        if (type === 'ac') {
          // Rough averages for modern 230V ACs
          activeMCA = tons * 7.5; 
          activeMOCP = Math.ceil((activeMCA * 1.5) / 5) * 5; // Standard sizing practice (1.5x to 2.25x)
        } else {
          // 10kW Heat Strip (roughly 42 Amps)
          activeMCA = 45;
          activeMOCP = 60;
        }
      }

      // Process
      const { awg, needsUpsize } = getWireAWG(activeMCA, distance);
      
      if (awg === 0) {
        outWire.innerText = "Custom";
        outWire.nextElementSibling!.textContent = "Consult an electrician. Run is too large.";
      } else {
        outWire.innerText = `${awg} AWG`;
        outWire.nextElementSibling!.textContent = "Standard NM-B (Romex) / THHN Copper";
      }

      outBreaker.innerText = `${activeMOCP} Amp`;

      // Warnings
      if (needsUpsize) {
        warningBox.classList.remove('hidden');
      } else {
        warningBox.classList.add('hidden');
      }
    }

    // Event Listeners
    mcaInput.addEventListener('input', calculate);
    mocpInput.addEventListener('input', calculate);
    tonnageSelect.addEventListener('change', calculate);
    typeSelect.addEventListener('change', calculate);
    distanceSlider.addEventListener('input', calculate);

    // Init
    calculate();
  </script>
</Layout>
