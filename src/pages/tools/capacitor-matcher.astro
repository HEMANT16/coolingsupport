---
import Layout from '../../layouts/Layout.astro';

const title = "What Capacitor Do I Need For My AC? | Replacement Matcher";
const description = "Wondering what capacitor you need for your AC? Use our visual AC capacitor replacement matcher to find the exact dual run or single run capacitor for your air conditioner.";
import AuthorBadge from '../../components/AuthorBadge.astro';
---

<Layout title={title} description={description}>
  <!-- JSON-LD Schemas -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "AC Capacitor Replacement Matcher",
    "author": { "@type": "Person", "name": "Mike Reynolds" },
    "description": "An interactive utility designed to help homeowners determine exactly what capacitor they need for their AC unit. The tool cross-references physical shape, microfarad (MFD) ratings, and HVAC voltage to generate a safe, exact replacement recommendation, including standard industry voltage upgrades.",
    "applicationCategory": "Utility",
    "operatingSystem": "All",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD"
    }
  })} />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Can I replace a 370V capacitor with a 440V capacitor?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes. A 440V capacitor is a direct, upgraded replacement for a 370V capacitor. The voltage rating is a maximum tolerance limit. However, you can NEVER replace a 440V capacitor with a 370V capacitor, as it will blow out."
        }
      },
      {
        "@type": "Question",
        "name": "What happens if I use the wrong microfarad (MFD) rating?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "If you install a capacitor with the wrong MFD rating, the motor will pull incorrect amperage. This causes the motor windings to overheat and drastically reduces the lifespan of your compressor or fan motor. Always match the exact MFD rating (e.g., 45/5)."
        }
      }
    ]
  })} />

  <!-- Hero Section -->
  <section class="bg-blue-900 text-white py-16 px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl mx-auto text-center">
      <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight mb-6">
        What Capacitor Do I Need <span class="text-blue-300">For My AC?</span>
      </h1>
      <div class="mt-8 mb-4 max-w-2xl mx-auto"><AuthorBadge name="Mike Reynolds" role="HVAC Expert" image="/images/mike-reynolds.png" date="June 14, 2026" /></div>
      <div class="text-lg text-blue-100 max-w-3xl mx-auto space-y-4 text-left bg-blue-950/50 p-6 rounded-sm border border-blue-800/50">
        <p>
          Don't guess when replacing the most critical electrical component in your condensing unit. Enter the specs from your blown capacitor below, and our matching engine will tell you exactly what replacement you need to buy.
        </p>
        <p class="text-sm text-blue-300 italic">
          Pro Tip: Over 85% of summer residential AC failures are caused by a weak or blown dual run capacitor. Replacing it yourself costs roughly $20, while calling an HVAC contractor will cost you a $250-$400 diagnostic and repair fee.
        </p>
      </div>
    </div>
  </section>

  <!-- Interactive Matcher Tool -->
  <section class="py-12 px-4 sm:px-6 lg:px-8 bg-gray-50 relative z-10 -mt-6">
    <div class="max-w-4xl mx-auto bg-white rounded-sm shadow-md border border-gray-200 overflow-hidden">
      
      <!-- App Header -->
      <div class="bg-gray-900 px-6 py-4 flex items-center justify-between">
        <div class="flex items-center gap-3">
          <h2 class="text-white font-bold text-lg">Capacitor Matching Engine</h2>
        </div>
        <div class="flex gap-1.5">
          <div class="w-3 h-3 rounded-md bg-red-500"></div>
          <div class="w-3 h-3 rounded-md bg-yellow-500"></div>
          <div class="w-3 h-3 rounded-md bg-green-500"></div>
        </div>
      </div>

      <div class="p-6 md:p-8">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
          
          <!-- Input Controls -->
          <div class="space-y-8">
            
            <!-- Type -->
            <div>
              <label class="block text-sm font-bold text-gray-900 uppercase tracking-wider mb-3">1. Capacitor Type</label>
              <div class="grid grid-cols-2 gap-3">
                <button type="button" class="type-btn active border-2 border-cyan-500 bg-cyan-50 text-cyan-700 py-3 px-4 rounded-sm font-bold transition-all shadow-sm" data-val="dual">
                  Dual Run (3 Prongs)
                </button>
                <button type="button" class="type-btn border border-gray-200 text-gray-500 hover:border-cyan-500 hover:text-cyan-600 py-3 px-4 rounded-sm font-bold transition-all" data-val="single">
                  Single Run (2 Prongs)
                </button>
              </div>
              <input type="hidden" id="typeVal" value="dual" />
            </div>

            <!-- Shape -->
            <div>
              <label class="block text-sm font-bold text-gray-900 uppercase tracking-wider mb-3">2. Physical Shape</label>
              <div class="grid grid-cols-2 gap-3">
                <button type="button" class="shape-btn active border-2 border-cyan-500 bg-cyan-50 text-cyan-700 py-3 px-4 rounded-sm font-bold transition-all shadow-sm" data-val="round">
                  Round Cylinder
                </button>
                <button type="button" class="shape-btn border border-gray-200 text-gray-500 hover:border-cyan-500 hover:text-cyan-600 py-3 px-4 rounded-sm font-bold transition-all" data-val="oval">
                  Oval Flat
                </button>
              </div>
              <input type="hidden" id="shapeVal" value="round" />
            </div>

            <!-- MFD Rating -->
            <div>
              <label class="block text-sm font-bold text-gray-900 uppercase tracking-wider mb-3 flex justify-between">
                <span>3. Microfarad (MFD / µF) Rating</span>
              </label>
              <p class="text-xs text-gray-500 mb-3">Check the label. It usually looks like "45/5 µF" or "35 MFD".</p>
              
              <!-- Dual Run MFD Options -->
              <div id="dualMfdContainer" class="grid grid-cols-3 sm:grid-cols-4 gap-2">
                <button type="button" class="mfd-btn border border-gray-200 text-gray-500 hover:border-cyan-500 py-2 rounded-lg font-bold text-sm transition-all" data-val="30/5">30/5</button>
                <button type="button" class="mfd-btn border border-gray-200 text-gray-500 hover:border-cyan-500 py-2 rounded-lg font-bold text-sm transition-all" data-val="35/5">35/5</button>
                <button type="button" class="mfd-btn border border-gray-200 text-gray-500 hover:border-cyan-500 py-2 rounded-lg font-bold text-sm transition-all" data-val="40/5">40/5</button>
                <button type="button" class="mfd-btn active border-2 border-cyan-500 bg-cyan-50 text-cyan-700 py-2 rounded-lg font-bold text-sm transition-all" data-val="45/5">45/5</button>
                <button type="button" class="mfd-btn border border-gray-200 text-gray-500 hover:border-cyan-500 py-2 rounded-lg font-bold text-sm transition-all" data-val="50/5">50/5</button>
                <button type="button" class="mfd-btn border border-gray-200 text-gray-500 hover:border-cyan-500 py-2 rounded-lg font-bold text-sm transition-all" data-val="55/5">55/5</button>
                <button type="button" class="mfd-btn border border-gray-200 text-gray-500 hover:border-cyan-500 py-2 rounded-lg font-bold text-sm transition-all" data-val="60/5">60/5</button>
                <button type="button" class="mfd-btn border border-gray-200 text-gray-500 hover:border-cyan-500 py-2 rounded-lg font-bold text-sm transition-all" data-val="80/5">80/5</button>
              </div>

              <!-- Single Run MFD Options (Hidden by default) -->
              <div id="singleMfdContainer" class="hidden grid grid-cols-3 sm:grid-cols-4 gap-2">
                <button type="button" class="mfd-btn border border-gray-200 text-gray-500 hover:border-cyan-500 py-2 rounded-lg font-bold text-sm transition-all" data-val="5">5</button>
                <button type="button" class="mfd-btn border border-gray-200 text-gray-500 hover:border-cyan-500 py-2 rounded-lg font-bold text-sm transition-all" data-val="7.5">7.5</button>
                <button type="button" class="mfd-btn border border-gray-200 text-gray-500 hover:border-cyan-500 py-2 rounded-lg font-bold text-sm transition-all" data-val="10">10</button>
                <button type="button" class="mfd-btn border border-gray-200 text-gray-500 hover:border-cyan-500 py-2 rounded-lg font-bold text-sm transition-all" data-val="35">35</button>
                <button type="button" class="mfd-btn border border-gray-200 text-gray-500 hover:border-cyan-500 py-2 rounded-lg font-bold text-sm transition-all" data-val="40">40</button>
                <button type="button" class="mfd-btn border border-gray-200 text-gray-500 hover:border-cyan-500 py-2 rounded-lg font-bold text-sm transition-all" data-val="45">45</button>
              </div>

              <input type="hidden" id="mfdVal" value="45/5" />
            </div>

            <!-- Voltage -->
            <div>
              <label class="block text-sm font-bold text-gray-900 uppercase tracking-wider mb-3">4. Voltage (VAC)</label>
              <div class="grid grid-cols-2 gap-3">
                <button type="button" class="volt-btn active border-2 border-cyan-500 bg-cyan-50 text-cyan-700 py-3 px-4 rounded-sm font-bold transition-all shadow-sm" data-val="370">
                  370 VAC
                </button>
                <button type="button" class="volt-btn border border-gray-200 text-gray-500 hover:border-cyan-500 hover:text-cyan-600 py-3 px-4 rounded-sm font-bold transition-all" data-val="440">
                  440 VAC
                </button>
              </div>
              <input type="hidden" id="voltVal" value="370" />
            </div>

          </div>

          <!-- Output Panel -->
          <div class="bg-gray-900 rounded-sm p-6 lg:p-8 text-white flex flex-col justify-center relative overflow-hidden">
            <!-- Decorative background elements -->
            <div class="absolute top-0 right-0 w-64 h-64 bg-cyan-500 rounded-md mix-blend-overlay filter blur-3xl opacity-20 transform translate-x-1/2 -translate-y-1/2 pointer-events-none"></div>
            
            <h3 class="text-sm font-bold text-cyan-400 uppercase tracking-wider mb-2">Exact Match Required:</h3>
            
            <div class="mb-8">
              <span id="finalAnswer" class="text-3xl lg:text-4xl font-black text-white leading-tight">
                45/5 µF 440V Round Dual Run
              </span>
            </div>

            <div id="voltageAlert" class="bg-blue-900/50 border border-blue-500/30 rounded-sm p-4 mb-6">
              <h4 class="font-bold text-blue-300 flex items-center gap-2 mb-2">
                <span></span> Master Tech Tip: The Voltage Upgrade
              </h4>
              <p class="text-blue-100 text-sm leading-relaxed">
                Your original is 370V, but we strongly recommend buying a <strong>440V replacement</strong>. In the HVAC trade, bumping a 370V to a 440V is a standard durability upgrade. It gives the capacitor a thicker dielectric and prevents it from popping on exceptionally hot days. NEVER downgrade from 440V to 370V.
              </p>
            </div>

            <!-- Visual Graphic -->
            <div class="bg-white/10 rounded-sm p-6 border border-white/20 flex flex-col items-center justify-center">
              <div id="visualGraphic" class="w-24 h-24 rounded-md border-4 border-gray-400 bg-gray-300 relative flex items-center justify-center shadow-inner">
                 <!-- 3 prongs for dual run -->
                 <div class="absolute top-2 left-1/2 -translate-x-1/2 flex flex-col items-center">
                    <div class="w-4 h-4 bg-yellow-500 rounded-sm"></div>
                    <span class="text-[10px] text-gray-800 font-black mt-1">HERM</span>
                 </div>
                 <div class="absolute bottom-3 left-3 flex flex-col items-center">
                    <div class="w-4 h-4 bg-orange-500 rounded-sm"></div>
                    <span class="text-[10px] text-gray-800 font-black mt-1">C</span>
                 </div>
                 <div class="absolute bottom-3 right-3 flex flex-col items-center">
                    <div class="w-4 h-4 bg-green-500 rounded-sm"></div>
                    <span class="text-[10px] text-gray-800 font-black mt-1">FAN</span>
                 </div>
              </div>
              <p class="text-xs text-gray-400 mt-4 text-center font-medium" id="wiringWarning">
                Warning: Always discharge the old capacitor with an insulated screwdriver before touching the terminals.
              </p>
            </div>

          </div>

        </div>
      </div>
    </div>
  </section>

  <!-- Skyscraper Content (10-Year Veteran Tone) -->
  <section class="py-16 px-4 sm:px-6 lg:px-8 bg-white border-t border-gray-100">
    <div class="max-w-4xl mx-auto space-y-16">
      
      <!-- Section 1: Decoding the Label -->
      <div>
        <h2 class="text-3xl font-bold text-gray-900 mb-6 flex items-center gap-3">
          Decoding the Capacitor Label
        </h2>
        <p class="text-lg text-gray-700 leading-relaxed mb-6">
          Look at the rusty metal can you just pulled out of your condensing unit. The label is probably faded, but you only care about three distinct numbers to get your AC running again: <strong>Microfarads, Voltage, and Tolerance</strong>.
        </p>
        
        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse">
            <thead>
              <tr class="bg-gray-100 border-b-2 border-gray-200">
                <th class="p-4 font-bold text-gray-900">Spec</th>
                <th class="p-4 font-bold text-gray-900">What it looks like</th>
                <th class="p-4 font-bold text-gray-900">What it actually means</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-200">
              <tr class="hover:bg-gray-50 transition-colors">
                <td class="p-4 font-bold text-cyan-700">Microfarads</td>
                <td class="p-4 text-gray-700">45/5 µF <em>or</em> 45/5 MFD</td>
                <td class="p-4 text-gray-700">The storage capacity. The large number (45) kicks your compressor on. The small number (5) kicks the condenser fan motor on. <strong>This must be an exact match.</strong></td>
              </tr>
              <tr class="hover:bg-gray-50 transition-colors">
                <td class="p-4 font-bold text-cyan-700">Voltage</td>
                <td class="p-4 text-gray-700">370 VAC <em>or</em> 440 VAC</td>
                <td class="p-4 text-gray-700">The maximum voltage tolerance. You can safely install a 440V in place of a 370V, but you will fry the capacitor instantly if you install a 370V in a system demanding 440V.</td>
              </tr>
              <tr class="hover:bg-gray-50 transition-colors">
                <td class="p-4 font-bold text-cyan-700">Tolerance</td>
                <td class="p-4 text-gray-700">+/- 5%</td>
                <td class="p-4 text-gray-700">The acceptable degradation limit. If your 45 µF capacitor drops below 42.75 µF (a 5% drop), it is failing and will cause locked rotor amps (LRA) to spike, destroying your compressor.</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Section 2: Wiring -->
      <div>
        <h2 class="text-3xl font-bold text-gray-900 mb-6 flex items-center gap-3">
          The 3 Terminals on a Dual Run Capacitor
        </h2>
        <div class="bg-red-50 rounded-sm border border-red-200 p-6 mb-6">
          <p class="text-red-900 leading-relaxed font-medium">
            Take a picture of the wiring before you unhook the dead capacitor. If you mix up the hermetic and fan wires, you will send the wrong phase shift to the wrong motor, likely resulting in immediate thermal overload.
          </p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="bg-white p-6 rounded-sm border border-gray-200 shadow-sm border-t-4 border-t-yellow-500">
            <h3 class="text-xl font-bold text-gray-900 mb-2">HERM</h3>
            <p class="text-gray-700 leading-relaxed text-sm">Stands for Hermetic Compressor. This terminal holds the massive charge (the "45" in 45/5) required to overcome the heavy refrigerant head pressure and spin the compressor up.</p>
          </div>
          <div class="bg-white p-6 rounded-sm border border-gray-200 shadow-sm border-t-4 border-t-green-500">
            <h3 class="text-xl font-bold text-gray-900 mb-2">FAN</h3>
            <p class="text-gray-700 leading-relaxed text-sm">Hooks to the condenser fan motor mounted at the top of your outside unit. It requires a much smaller kick (the "5" in 45/5) to start spinning the fan blades.</p>
          </div>
          <div class="bg-white p-6 rounded-sm border border-gray-200 shadow-sm border-t-4 border-t-orange-500">
            <h3 class="text-xl font-bold text-gray-900 mb-2">C (Common)</h3>
            <p class="text-gray-700 leading-relaxed text-sm">The common terminal. This is where the incoming line voltage (usually coming from the contactor) ties in to feed power to the entire capacitor block.</p>
          </div>
        </div>
      </div>

      <!-- Section 3: FAQs -->
      <div>
        <h2 class="text-3xl font-bold text-gray-900 mb-8 flex items-center gap-3">
          Technical FAQ
        </h2>
        <div class="space-y-4">
          <details class="group bg-gray-50 rounded-sm border border-gray-200 overflow-hidden cursor-pointer open:bg-white open:ring-2 open:ring-cyan-500 open:shadow-md transition-all">
            <summary class="px-6 py-4 font-bold text-gray-900 flex justify-between items-center select-none">
              Does the shape (Round vs. Oval) matter?
              <span class="text-cyan-500 group-open:rotate-180 transition-transform">▼</span>
            </summary>
            <div class="px-6 pb-4 text-gray-700 leading-relaxed border-t border-gray-100 pt-4 text-sm">
              Electrically, no. A 45/5 440V Round capacitor functions identically to a 45/5 440V Oval capacitor. The only difference is physical fitment. Many condensing units have a metal strap holding the capacitor to the chassis. If you switch shapes, you might need to use plumber's tape or zip-ties to secure it, because the old bracket won't fit perfectly.
            </div>
          </details>

          <details class="group bg-gray-50 rounded-sm border border-gray-200 overflow-hidden cursor-pointer open:bg-white open:ring-2 open:ring-cyan-500 open:shadow-md transition-all">
            <summary class="px-6 py-4 font-bold text-gray-900 flex justify-between items-center select-none">
              I can't find a dual run, can I use two single run capacitors instead?
              <span class="text-cyan-500 group-open:rotate-180 transition-transform">▼</span>
            </summary>
            <div class="px-6 pb-4 text-gray-700 leading-relaxed border-t border-gray-100 pt-4 text-sm">
              Yes. A dual run capacitor is literally just two single run capacitors stuffed into the same metal casing to save space. If you need a 45/5 but only have a 45 and a 5, you can strap them both in. You just have to jump the incoming power wire to the 'Common' terminal on both separate capacitors.
            </div>
          </details>
        </div>
      </div>

    </div>
  </section>

  <!-- Interactive Logic -->
  <script>
    // Elements
    const typeBtns = document.querySelectorAll('.type-btn');
    const shapeBtns = document.querySelectorAll('.shape-btn');
    const mfdBtns = document.querySelectorAll('.mfd-btn');
    const voltBtns = document.querySelectorAll('.volt-btn');
    
    const typeVal = document.getElementById('typeVal') as HTMLInputElement;
    const shapeVal = document.getElementById('shapeVal') as HTMLInputElement;
    const mfdVal = document.getElementById('mfdVal') as HTMLInputElement;
    const voltVal = document.getElementById('voltVal') as HTMLInputElement;
    
    const dualMfdContainer = document.getElementById('dualMfdContainer')!;
    const singleMfdContainer = document.getElementById('singleMfdContainer')!;
    const finalAnswer = document.getElementById('finalAnswer')!;
    const voltageAlert = document.getElementById('voltageAlert')!;
    const visualGraphic = document.getElementById('visualGraphic')!;

    function updateResult() {
      let type = typeVal.value; // dual or single
      let shape = shapeVal.value; // round or oval
      let mfd = mfdVal.value; 
      let volt = voltVal.value;

      // Ensure MFD matches the type (reset if they switch types)
      if (type === 'single' && mfd.includes('/')) {
        mfd = '35'; // default single
        mfdVal.value = mfd;
        document.querySelectorAll('#singleMfdContainer .mfd-btn').forEach(b => {
          b.className = b.className.replace('active', '').replace('border-2', 'border').replace('border-cyan-500', 'border-gray-200').replace('bg-cyan-50', '').replace('text-cyan-700', 'text-gray-500');
          if(b.getAttribute('data-val') === mfd) {
            b.classList.add('active', 'border-2', 'border-cyan-500', 'bg-cyan-50', 'text-cyan-700');
            b.classList.remove('border-gray-200', 'text-gray-500');
          }
        });
      } else if (type === 'dual' && !mfd.includes('/')) {
        mfd = '45/5'; // default dual
        mfdVal.value = mfd;
        document.querySelectorAll('#dualMfdContainer .mfd-btn').forEach(b => {
          b.className = b.className.replace('active', '').replace('border-2', 'border').replace('border-cyan-500', 'border-gray-200').replace('bg-cyan-50', '').replace('text-cyan-700', 'text-gray-500');
          if(b.getAttribute('data-val') === mfd) {
            b.classList.add('active', 'border-2', 'border-cyan-500', 'bg-cyan-50', 'text-cyan-700');
            b.classList.remove('border-gray-200', 'text-gray-500');
          }
        });
      }

      // Format Text
      let typeText = type === 'dual' ? 'Dual Run' : 'Single Run';
      let shapeText = shape === 'round' ? 'Round' : 'Oval';
      
      // Determine recommended voltage
      let recommendedVolt = "440V"; // Always recommend 440V for durability
      
      finalAnswer.textContent = `${mfd} µF ${recommendedVolt} ${shapeText} ${typeText}`;

      // Voltage Alert Logic
      if (volt === '370') {
        voltageAlert.style.display = 'block';
        voltageAlert.innerHTML = `
          <h4 class="font-bold text-blue-300 flex items-center gap-2 mb-2">
            <span></span> Master Tech Tip: The Voltage Upgrade
          </h4>
          <p class="text-blue-100 text-sm leading-relaxed">
            Your original is 370V, but we strongly recommend buying a <strong>440V replacement</strong>. In the HVAC trade, bumping a 370V to a 440V is a standard durability upgrade. It gives the capacitor a thicker dielectric and prevents it from popping on exceptionally hot days. NEVER downgrade from 440V to 370V.
          </p>
        `;
      } else {
        voltageAlert.style.display = 'block';
        voltageAlert.innerHTML = `
          <h4 class="font-bold text-blue-300 flex items-center gap-2 mb-2">
            <span></span> Correct Voltage Selected
          </h4>
          <p class="text-blue-100 text-sm leading-relaxed">
            Since your system demands 440V, you MUST replace it with a 440V capacitor. Downgrading to a 370V capacitor will cause it to swell and explode within minutes.
          </p>
        `;
      }

      // Visual Graphic Logic
      if (shape === 'round') {
        visualGraphic.className = "w-24 h-24 rounded-md border-4 border-gray-400 bg-gray-300 relative flex items-center justify-center shadow-inner";
      } else {
        visualGraphic.className = "w-16 h-28 rounded-[2rem] border-4 border-gray-400 bg-gray-300 relative flex items-center justify-center shadow-inner";
      }

      if (type === 'dual') {
        visualGraphic.innerHTML = `
           <div class="absolute top-2 left-1/2 -translate-x-1/2 flex flex-col items-center">
              <div class="w-4 h-4 bg-yellow-500 rounded-sm shadow-sm"></div>
              <span class="text-[9px] text-gray-800 font-black mt-0.5">HERM</span>
           </div>
           <div class="absolute bottom-3 left-1/2 -translate-x-1/2 transform -translate-x-4 flex flex-col items-center">
              <div class="w-4 h-4 bg-orange-500 rounded-sm shadow-sm"></div>
              <span class="text-[9px] text-gray-800 font-black mt-0.5">C</span>
           </div>
           <div class="absolute bottom-3 right-1/2 translate-x-1/2 transform translate-x-4 flex flex-col items-center">
              <div class="w-4 h-4 bg-green-500 rounded-sm shadow-sm"></div>
              <span class="text-[9px] text-gray-800 font-black mt-0.5">FAN</span>
           </div>
        `;
      } else {
        visualGraphic.innerHTML = `
           <div class="absolute top-4 left-1/2 -translate-x-1/2 flex flex-col items-center">
              <div class="w-4 h-4 bg-gray-500 rounded-sm shadow-sm"></div>
              <span class="text-[9px] text-gray-800 font-black mt-0.5">T1</span>
           </div>
           <div class="absolute bottom-4 left-1/2 -translate-x-1/2 flex flex-col items-center">
              <div class="w-4 h-4 bg-gray-500 rounded-sm shadow-sm"></div>
              <span class="text-[9px] text-gray-800 font-black mt-0.5">T2</span>
           </div>
        `;
      }
    }

    // Event Listeners
    function setupPillGroup(btns: NodeListOf<Element>, hiddenInput: HTMLInputElement, isTypeGroup = false) {
      btns.forEach(btn => {
        btn.addEventListener('click', (e) => {
          const target = e.currentTarget as HTMLButtonElement;
          hiddenInput.value = target.getAttribute('data-val') || '';
          
          // Reset styles
          btns.forEach(b => {
            b.className = b.className.replace('active', '').replace('border-2', 'border').replace('border-cyan-500', 'border-gray-200').replace('bg-cyan-50', '').replace('text-cyan-700', 'text-gray-500').replace('shadow-sm', '');
            if(!b.classList.contains('hover:border-cyan-500')) {
                b.classList.add('hover:border-cyan-500', 'hover:text-cyan-600');
            }
          });

          // Set active
          target.classList.add('active', 'border-2', 'border-cyan-500', 'bg-cyan-50', 'text-cyan-700', 'shadow-sm');
          target.classList.remove('border-gray-200', 'text-gray-500', 'hover:border-cyan-500', 'hover:text-cyan-600');

          // Toggle MFD containers if type changes
          if (isTypeGroup) {
            if (hiddenInput.value === 'dual') {
              dualMfdContainer.classList.remove('hidden');
              singleMfdContainer.classList.add('hidden');
            } else {
              dualMfdContainer.classList.add('hidden');
              singleMfdContainer.classList.remove('hidden');
            }
          }

          updateResult();
        });
      });
    }

    setupPillGroup(typeBtns, typeVal, true);
    setupPillGroup(shapeBtns, shapeVal);
    setupPillGroup(mfdBtns, mfdVal);
    setupPillGroup(voltBtns, voltVal);

    // Initial render
    updateResult();
  </script>
</Layout>
