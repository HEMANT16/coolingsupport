---
import Layout from '../../layouts/Layout.astro';

const title = "AC Freon Recharge Cost Calculator | R410A & R22 Prices";
const description = "Calculate the exact cost to recharge your home AC unit. Find the current price per pound for R410A, R22, and R454B, plus EPA phase-out regulations.";
import AuthorBadge from '../../components/AuthorBadge.astro';
---

<Layout title={title} description={description}>
  <!-- JSON-LD Schemas -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": "AC Freon Recharge Cost Calculator",
    "description": "An interactive cost calculator tool to estimate the repair cost of an AC freon recharge. Instantly calculates the price of R-410A, R-22, and R-454B refrigerant replacement based on current market rates and labor fees.",
    "applicationCategory": "CalculatorApplication",
    "operatingSystem": "WebBrowser",
    "featureList": "Live price calculation, EPA status check, Labor vs Material cost breakdown",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD"
    }
  })} />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "How much does freon cost per pound?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "The cost of AC refrigerant depends heavily on the type. As of 2025, R-410A typically costs contractors between $60 and $120 per pound, while the banned R-22 Freon can cost $150 to $250 per pound due to extreme scarcity."
        }
      },
      {
        "@type": "Question",
        "name": "How much does an AC unit freon recharge cost?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "A typical home AC recharge requires 3 to 6 pounds of refrigerant. Including the service call and labor, a standard R-410A recharge costs between $450 and $900. An R-22 recharge can easily exceed $1,200."
        }
      },
      {
        "@type": "Question",
        "name": "How often should my AC need freon?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Never. Air conditioners are hermetically sealed systems. They do not burn or consume refrigerant like a car consumes gas. If your system is low on freon, it means you have a physical leak in the copper lines or coils that must be found and repaired."
        }
      },
      {
        "@type": "Question",
        "name": "Can I buy Freon and recharge my AC myself?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "No. Under Section 608 of the Clean Air Act, it is illegal to purchase or handle regulated refrigerants like R-410A and R-22 without an EPA certification. Only a licensed HVAC technician can legally recharge your home AC."
        }
      },
      {
        "@type": "Question",
        "name": "Is it worth recharging an old R-22 AC unit?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "In most cases, no. R-22 was completely banned from production in 2020. Because supplies are strictly limited to reclaimed stock, the price per pound is astronomical. Spending $1,500 to recharge a 15-year-old system that will likely leak again is a poor financial decision compared to replacing the unit."
        }
      },
      {
        "@type": "Question",
        "name": "How do I know if my AC has a freon leak?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Common signs of a freon leak include the AC blowing lukewarm air, ice building up on the indoor evaporator coil or the outdoor refrigerant lines, a hissing sound near the unit, and unexpectedly high energy bills due to the system running constantly."
        }
      }
    ]
  })} />

  <!-- Hero Section -->
  <section class="bg-gray-900 text-white py-16 px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl mx-auto text-center">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-md bg-cyan-500/20 text-cyan-400 font-bold text-xs uppercase tracking-widest mb-6 border border-cyan-500/30">
        2025 Pricing & EPA Data
      </div>
      <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight mb-6">
        AC Freon Recharge <span class="text-cyan-400">Cost Calculator</span>
      </h1>
      <div class="mt-8 mb-4 max-w-2xl mx-auto"><AuthorBadge name="Mike Reynolds" role="HVAC Expert" image="/images/mike-reynolds.png" date="June 14, 2026" /></div>
      <p class="text-xl text-gray-300 max-w-2xl mx-auto mb-8 font-light">
        Don't get ripped off. Calculate exactly how much it should cost to recharge your AC based on the current market price of R-410A, R-22, or R-454B.
      </p>
    </div>
  </section>

  <!-- Interactive Calculator App -->
  <section class="py-12 px-4 sm:px-6 lg:px-8 bg-gray-50 relative z-10">
    <div class="max-w-5xl mx-auto bg-white rounded-sm shadow-md border border-gray-200 overflow-hidden">
      
      <!-- App Header -->
      <div class="bg-cyan-900 px-6 py-4 flex items-center gap-3">
        <span class="text-cyan-400 text-xl"></span>
        <h2 class="text-white font-bold text-lg">Freon Cost Engine</h2>
      </div>

      <div class="p-6 md:p-8">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
          
          <!-- Controls (Left) -->
          <div class="space-y-8">
            
            <!-- Step 1: Select Refrigerant -->
            <div>
              <label class="flex items-center gap-2 text-sm font-bold text-gray-900 uppercase tracking-wider mb-3">
                <span class="bg-gray-900 text-white w-6 h-6 rounded-md flex items-center justify-center text-xs">1</span> 
                Select Refrigerant Type
              </label>
              <div class="grid grid-cols-3 gap-2">
              <button class="ref-btn border-2 border-gray-200 rounded-sm py-4 px-2 text-center hover:border-cyan-500 transition-all focus:outline-none ring-4 ring-cyan-200 bg-cyan-50 border-cyan-500" data-type="r410a" data-cost-low="60" data-cost-high="120">
                  <span class="block text-xl font-black text-gray-900 mb-1">R-410A</span>
                  <span class="block text-xs text-gray-500 font-medium">Puron</span>
                </button>
                <button class="ref-btn border-2 border-gray-200 rounded-sm py-4 px-2 text-center hover:border-cyan-500 transition-all focus:outline-none" data-type="r22" data-cost-low="150" data-cost-high="250">
                  <span class="block text-xl font-black text-gray-900 mb-1">R-22</span>
                  <span class="block text-xs text-gray-500 font-medium">Freon</span>
                </button>
                <button class="ref-btn border-2 border-gray-200 rounded-sm py-4 px-2 text-center hover:border-cyan-500 transition-all focus:outline-none" data-type="r454b" data-cost-low="50" data-cost-high="90">
                  <span class="block text-xl font-black text-gray-900 mb-1">R-454B</span>
                  <span class="block text-xs text-gray-500 font-medium">Puron Adv</span>
                </button>
              </div>
            </div>

            <!-- Step 2: Amount Needed -->
            <div>
              <label class="flex items-center gap-2 text-sm font-bold text-gray-900 uppercase tracking-wider mb-3">
                <span class="bg-gray-900 text-white w-6 h-6 rounded-md flex items-center justify-center text-xs">2</span> 
                Pounds Needed (Lbs)
              </label>
              <div class="flex items-center gap-4">
                <input type="range" id="lbsSlider" min="1" max="15" value="5" class="w-full h-2 bg-gray-200 rounded-lg appearance-none cursor-pointer accent-cyan-600">
                <div class="bg-gray-900 text-white font-bold text-xl px-4 py-2 rounded-lg min-w-[4rem] text-center" id="lbsDisplay">5</div>
              </div>
              <p class="text-xs text-gray-500 mt-2 font-medium bg-blue-50 p-3 rounded-lg border border-blue-100">
                Rule of thumb: A totally empty system requires 2 to 4 lbs of refrigerant per Ton of AC capacity. A typical residential recharge takes about 3 to 6 lbs.
              </p>
            </div>

          </div>

          <!-- Output Panel (Right) -->
          <div class="bg-gray-900 rounded-sm p-6 lg:p-8 text-white flex flex-col relative overflow-hidden shadow-md">
            <div class="absolute -right-20 -top-20 w-64 h-64 bg-cyan-500 rounded-md mix-blend-multiply filter blur-3xl opacity-20"></div>
            
            <h3 class="text-cyan-400 font-bold uppercase tracking-widest text-sm mb-6 flex items-center gap-2">
              <span class="w-2 h-2 rounded-md bg-cyan-400 animate-pulse"></span>
              Estimated Cost Range
            </h3>

            <div class="space-y-4 mb-8 flex-grow">
              <div class="flex justify-between items-end border-b border-gray-700 pb-2">
                <span class="text-gray-400 font-medium">Material <span id="matDetail" class="text-xs text-cyan-300 ml-1">($60 - $120/lb)</span></span>
                <span class="text-xl font-bold" id="matCost">$300 - $600</span>
              </div>
              <div class="flex justify-between items-end border-b border-gray-700 pb-2 group relative">
                <span class="text-gray-400 font-medium border-b border-dashed border-gray-500 cursor-help">Labor & Service Call</span>
                <span class="text-xl font-bold">$150 - $300</span>
                <div class="absolute bottom-full left-0 mb-2 w-64 bg-white text-gray-900 text-xs p-3 rounded-lg shadow-lg opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none z-10">
                  Contractors charge wildly different rates based on location. This includes the dispatch fee and hourly labor to braze/recharge.
                </div>
              </div>
            </div>

            <div class="bg-gray-800 rounded-sm p-6 border border-gray-700">
              <span class="text-gray-400 font-bold uppercase tracking-wider text-xs block mb-1">Total Estimated Bill</span>
              <div class="text-4xl sm:text-5xl font-black text-white flex items-center gap-1">
                <span class="text-2xl mt-1 text-cyan-400">$</span><span id="totalCost">450 - 900</span>
              </div>
            </div>
            
            <!-- EPA Status Container (Injected via JS) -->
            <div id="epaStatusContainer" class="mt-6">
              <!-- Default initialized to R-410A -->
              <div class="bg-yellow-500/10 border border-yellow-500/30 rounded-sm p-4">
                <h4 class="text-yellow-400 font-bold text-sm mb-1 uppercase tracking-wider flex items-center gap-2">
                  <span>️</span> EPA Phase-Down
                </h4>
                <p class="text-gray-300 text-sm leading-relaxed">
                  <strong>R-410A:</strong> Manufacturing banned in 2025. It is 100% legal to repair your system, but expect prices to double.
                </p>
              </div>
            </div>

          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Skyscraper Content (10-Year Veteran Tone) -->
  <section class="py-16 px-4 sm:px-6 lg:px-8 bg-white border-t border-gray-100">
    <div class="max-w-4xl mx-auto space-y-16">
      
      <!-- Real World Quotes from Reddit & Quora -->
      <div>
        <h2 class="text-3xl font-bold text-gray-900 mb-6 flex items-center gap-3">
          Real Quotes from Reddit & Quora
        </h2>
        <p class="text-lg text-gray-700 leading-relaxed mb-6">
          HVAC pricing is the "Wild West." A corporate company with 50 wrapped trucks will charge you triple what a local independent technician will charge. Here are real, crowdsourced quotes from homeowners on <a href="https://www.reddit.com/r/hvacadvice/" target="_blank" rel="noopener noreferrer" class="text-blue-600 font-bold underline">r/hvacadvice</a> and Quora to prove how wildly prices vary:
        </p>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
          
          <div class="bg-gray-50 border border-gray-200 rounded-sm p-6 relative">
            <span class="absolute top-4 right-4 text-gray-400 text-2xl">"</span>
            <div class="flex items-center gap-2 mb-3">
              <div class="w-6 h-6 bg-orange-500 rounded-md flex items-center justify-center text-white text-xs font-bold">r/</div>
              <span class="font-bold text-gray-900 text-sm">r/hvacadvice User (Florida)</span>
            </div>
            <p class="text-gray-700 italic mb-3">"I just got quoted $2,400 to replace 8 lbs of R-22 Freon. They told me it's $250 a pound plus a $400 leak search fee. Am I being scammed?"</p>
            <p class="text-xs font-bold text-red-600 bg-red-50 inline-block px-2 py-1 rounded">Verdict: High-End Corporate Pricing</p>
          </div>

          <div class="bg-gray-50 border border-gray-200 rounded-sm p-6 relative">
            <span class="absolute top-4 right-4 text-gray-400 text-2xl">"</span>
            <div class="flex items-center gap-2 mb-3">
              <div class="w-6 h-6 bg-orange-500 rounded-md flex items-center justify-center text-white text-xs font-bold">r/</div>
              <span class="font-bold text-gray-900 text-sm">r/hvacadvice User (Texas)</span>
            </div>
            <p class="text-gray-700 italic mb-3">"Local guy came out, found a leak in the Schrader valve, tightened it, and added 3 lbs of R-410A. Total bill was $350. He charged $65/lb for the Puron."</p>
            <p class="text-xs font-bold text-green-600 bg-green-50 inline-block px-2 py-1 rounded">Verdict: Fair Independent Pricing</p>
          </div>

          <div class="bg-gray-50 border border-gray-200 rounded-sm p-6 relative">
            <span class="absolute top-4 right-4 text-gray-400 text-2xl">"</span>
            <div class="flex items-center gap-2 mb-3">
              <div class="w-6 h-6 bg-red-600 rounded-sm flex items-center justify-center text-white text-xs font-bold font-serif">Q</div>
              <span class="font-bold text-gray-900 text-sm">Quora User (California)</span>
            </div>
            <p class="text-gray-700 italic mb-3">"A tech just quoted me $150 per pound for R-410A. I know the jug costs them like $250 wholesale for 25 lbs! The markup is insane."</p>
            <p class="text-xs font-bold text-yellow-600 bg-yellow-50 inline-block px-2 py-1 rounded">Verdict: Heavy Market Markup</p>
          </div>

          <div class="bg-gray-50 border border-gray-200 rounded-sm p-6 relative">
            <span class="absolute top-4 right-4 text-gray-400 text-2xl">"</span>
            <div class="flex items-center gap-2 mb-3">
              <div class="w-6 h-6 bg-orange-500 rounded-md flex items-center justify-center text-white text-xs font-bold">r/</div>
              <span class="font-bold text-gray-900 text-sm">r/HVAC Tech (Verified Pro)</span>
            </div>
            <p class="text-gray-700 italic mb-3">"I run my own one-man truck. I charge $85/lb for R-410A and a $120 service call. It covers my insurance, gas, and EPA licensing. The big guys charge double that just to pay for their billboard ads."</p>
            <p class="text-xs font-bold text-blue-600 bg-blue-50 inline-block px-2 py-1 rounded">Verdict: The Reality of Overhead</p>
          </div>

        </div>
      </div>
      
      <!-- Section 1: The Topping Off Scam -->
      <div>
        <h2 class="text-3xl font-bold text-gray-900 mb-6 flex items-center gap-3">
          The "Topping Off" Scam
        </h2>
        <p class="text-lg text-gray-700 leading-relaxed mb-6">
          Air conditioners are hermetically sealed systems. They do not "use up" or "burn" Freon like a car burns gas. If your system is low on refrigerant, <strong>you have a leak.</strong>
        </p>
        <div class="bg-gray-900 text-white p-6 rounded-sm shadow-md mb-6">
          <p class="font-bold text-cyan-400 mb-2 uppercase tracking-wider text-sm">The 10-Year Veteran Reality:</p>
          <p class="text-gray-300 leading-relaxed">
            If a contractor comes to your house every summer and says, "You're a couple pounds low, let me just top it off," they are stealing from you. They are charging you hundreds of dollars for gas that will simply leak out again. A true professional will offer to perform an Electronic Leak Search to find and braze the hole.
          </p>
        </div>
      </div>

      <!-- Section 2: The R-410A Panic -->
      <div>
        <h2 class="text-3xl font-bold text-gray-900 mb-6 flex items-center gap-3">
          <span class="text-orange-500">️</span> The R-410A Phase-Out Panic
        </h2>
        <p class="text-lg text-gray-700 leading-relaxed mb-6">
          Because the EPA AIM Act banned the manufacturing of new R-410A equipment starting January 1, 2025, shady salespeople are telling homeowners their systems are "illegal" and must be ripped out immediately.
        </p>
        <p class="text-lg text-gray-700 leading-relaxed">
          <strong>This is a lie.</strong> It is 100% legal to keep your R-410A system and have it repaired and recharged. The only catch is that as production of R-410A is slashed over the next few years, the price per pound is going to skyrocket. If your R-410A system develops a severe leak in 2027, it may be too expensive to recharge.
        </p>
      </div>

      <!-- Section 3: FAQs -->
      <div>
        <h2 class="text-3xl font-bold text-gray-900 mb-8 flex items-center gap-3">
          Freon Cost FAQs
        </h2>
        <div class="space-y-4">
          <details class="group bg-gray-50 rounded-sm border border-gray-200 overflow-hidden cursor-pointer open:bg-white open:ring-2 open:ring-cyan-500 open:shadow-md transition-all">
            <summary class="px-6 py-4 font-bold text-gray-900 flex justify-between items-center select-none">
              How much does freon cost per pound?
              <span class="text-cyan-500 group-open:rotate-180 transition-transform">▼</span>
            </summary>
            <div class="px-6 pb-4 text-gray-700 leading-relaxed border-t border-gray-100 pt-4 text-sm">
              The cost of AC refrigerant depends heavily on the type. As of 2025, R-410A typically costs contractors between $60 and $120 per pound, while the banned R-22 Freon can cost $150 to $250 per pound due to extreme scarcity.
            </div>
          </details>

          <details class="group bg-gray-50 rounded-sm border border-gray-200 overflow-hidden cursor-pointer open:bg-white open:ring-2 open:ring-cyan-500 open:shadow-md transition-all">
            <summary class="px-6 py-4 font-bold text-gray-900 flex justify-between items-center select-none">
              How much does an AC unit freon recharge cost?
              <span class="text-cyan-500 group-open:rotate-180 transition-transform">▼</span>
            </summary>
            <div class="px-6 pb-4 text-gray-700 leading-relaxed border-t border-gray-100 pt-4 text-sm">
              A typical home AC recharge requires 3 to 6 pounds of refrigerant. Including the service call and labor, a standard R-410A recharge costs between $450 and $900. An R-22 recharge can easily exceed $1,200.
            </div>
          </details>

          <details class="group bg-gray-50 rounded-sm border border-gray-200 overflow-hidden cursor-pointer open:bg-white open:ring-2 open:ring-cyan-500 open:shadow-md transition-all">
            <summary class="px-6 py-4 font-bold text-gray-900 flex justify-between items-center select-none">
              How often should my AC need freon?
              <span class="text-cyan-500 group-open:rotate-180 transition-transform">▼</span>
            </summary>
            <div class="px-6 pb-4 text-gray-700 leading-relaxed border-t border-gray-100 pt-4 text-sm">
              Never. Air conditioners are hermetically sealed systems. They do not burn or consume refrigerant like a car consumes gas. If your system is low on freon, it means you have a physical leak in the copper lines or coils that must be found and repaired.
            </div>
          </details>

          <details class="group bg-gray-50 rounded-sm border border-gray-200 overflow-hidden cursor-pointer open:bg-white open:ring-2 open:ring-cyan-500 open:shadow-md transition-all">
            <summary class="px-6 py-4 font-bold text-gray-900 flex justify-between items-center select-none">
              Can I buy Freon and recharge my AC myself?
              <span class="text-cyan-500 group-open:rotate-180 transition-transform">▼</span>
            </summary>
            <div class="px-6 pb-4 text-gray-700 leading-relaxed border-t border-gray-100 pt-4 text-sm">
              No. Under Section 608 of the Clean Air Act, it is illegal to purchase or handle regulated refrigerants like R-410A and R-22 without an EPA certification. Only a licensed HVAC technician can legally recharge your home AC.
            </div>
          </details>

          <details class="group bg-gray-50 rounded-sm border border-gray-200 overflow-hidden cursor-pointer open:bg-white open:ring-2 open:ring-cyan-500 open:shadow-md transition-all">
            <summary class="px-6 py-4 font-bold text-gray-900 flex justify-between items-center select-none">
              Is it worth recharging an old R-22 AC unit?
              <span class="text-cyan-500 group-open:rotate-180 transition-transform">▼</span>
            </summary>
            <div class="px-6 pb-4 text-gray-700 leading-relaxed border-t border-gray-100 pt-4 text-sm">
              In most cases, no. R-22 was completely banned from production in 2020. Because supplies are strictly limited to reclaimed stock, the price per pound is astronomical. Spending $1,500 to recharge a 15-year-old system that will likely leak again is a poor financial decision compared to replacing the unit.
            </div>
          </details>

          <details class="group bg-gray-50 rounded-sm border border-gray-200 overflow-hidden cursor-pointer open:bg-white open:ring-2 open:ring-cyan-500 open:shadow-md transition-all">
            <summary class="px-6 py-4 font-bold text-gray-900 flex justify-between items-center select-none">
              How do I know if my AC has a freon leak?
              <span class="text-cyan-500 group-open:rotate-180 transition-transform">▼</span>
            </summary>
            <div class="px-6 pb-4 text-gray-700 leading-relaxed border-t border-gray-100 pt-4 text-sm">
              Common signs of a freon leak include the AC blowing lukewarm air, ice building up on the indoor evaporator coil or the outdoor refrigerant lines, a hissing sound near the unit, and unexpectedly high energy bills due to the system running constantly.
            </div>
          </details>
        </div>
      </div>

    </div>
  </section>

  <!-- Interactive Logic -->
  <script>
    const btns = document.querySelectorAll('.ref-btn');
    const lbsSlider = document.getElementById('lbsSlider') as HTMLInputElement;
    const lbsDisplay = document.getElementById('lbsDisplay')!;
    const matDetail = document.getElementById('matDetail')!;
    const matCost = document.getElementById('matCost')!;
    const totalCost = document.getElementById('totalCost')!;
    const epaStatusContainer = document.getElementById('epaStatusContainer')!;

    const laborCostLow = 150;
    const laborCostHigh = 300;
    let currentCostLow = 60;
    let currentCostHigh = 120;
    let currentType = 'r410a';

    const epaData = {
      'r410a': `
        <div class="bg-yellow-500/10 border border-yellow-500/30 rounded-sm p-4">
          <h4 class="text-yellow-400 font-bold text-sm mb-1 uppercase tracking-wider flex items-center gap-2">
            <span>️</span> EPA Phase-Down
          </h4>
          <p class="text-gray-300 text-sm leading-relaxed">
            <strong>R-410A:</strong> Manufacturing banned in 2025. It is 100% legal to repair your system, but expect prices to double as supplies tighten.
          </p>
        </div>
      `,
      'r22': `
        <div class="bg-red-500/10 border border-red-500/30 rounded-sm p-4">
          <h4 class="text-red-400 font-bold text-sm mb-1 uppercase tracking-wider flex items-center gap-2">
            <span></span> Completely Banned
          </h4>
          <p class="text-gray-300 text-sm leading-relaxed">
            <strong>R-22:</strong> Illegal to import or manufacture. Extreme scarcity drives prices up. Replacing this much R-22 is often financially irresponsible.
          </p>
        </div>
      `,
      'r454b': `
        <div class="bg-green-500/10 border border-green-500/30 rounded-sm p-4">
          <h4 class="text-green-400 font-bold text-sm mb-1 uppercase tracking-wider flex items-center gap-2">
            <span></span> Current Standard
          </h4>
          <p class="text-gray-300 text-sm leading-relaxed">
            <strong>R-454B (A2L):</strong> The new legal standard for systems built after Jan 1, 2025. 100% legal and fully supported.
          </p>
        </div>
      `
    };

    function calculate() {
      const lbs = parseInt(lbsSlider.value);
      lbsDisplay.textContent = lbs.toString();
      
      const materialLow = lbs * currentCostLow;
      const materialHigh = lbs * currentCostHigh;
      
      const totalLow = materialLow + laborCostLow;
      const totalHigh = materialHigh + laborCostHigh;

      matDetail.textContent = `($${currentCostLow} - $${currentCostHigh}/lb)`;
      matCost.textContent = `$${materialLow.toLocaleString()} - $${materialHigh.toLocaleString()}`;
      totalCost.textContent = `${totalLow.toLocaleString()} - ${totalHigh.toLocaleString()}`;
    }

    lbsSlider.addEventListener('input', calculate);

    btns.forEach(btn => {
      btn.addEventListener('click', () => {
        // Reset styles
        btns.forEach(b => {
          b.classList.remove('ring-4', 'ring-cyan-200', 'bg-cyan-50', 'border-cyan-500');
        });
        
        // Active styles
        btn.classList.add('ring-4', 'ring-cyan-200', 'bg-cyan-50', 'border-cyan-500');

        currentCostLow = parseInt(btn.getAttribute('data-cost-low')!);
        currentCostHigh = parseInt(btn.getAttribute('data-cost-high')!);
        currentType = btn.getAttribute('data-type')!;
        
        epaStatusContainer.innerHTML = epaData[currentType as keyof typeof epaData];
        
        calculate();
      });
    });

    // Init
    calculate();
  </script>
</Layout>
