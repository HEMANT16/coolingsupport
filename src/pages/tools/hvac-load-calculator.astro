---
import Layout from '../../layouts/Layout.astro';

const title = "Free HVAC Load Calculator | Find Exact AC Tonnage";
const description = "Use our free HVAC load calculator to find the exact Tonnage and BTUs required to cool your home based on climate, insulation, ceiling height, and square footage.";
import AuthorBadge from '../../components/AuthorBadge.astro';
---

<Layout title={title} description={description}>
  
  <!-- Schema Injection -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "Free HVAC Load Calculator",
    "author": { "@type": "Person", "name": "Mike Reynolds" },
    "description": description,
    "applicationCategory": "Utility",
    "operatingSystem": "All",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD"
    }
  })} />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "What is a Manual J calculation?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Manual J is the official protocol created by the Air Conditioning Contractors of America (ACCA) to determine exactly how much heating and cooling a house needs. It factors in square footage, climate, insulation, and windows."
        }
      },
      {
        "@type": "Question",
        "name": "Can I use the square footage rule of thumb to size an AC?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "No, the old rule of '1 Ton for every 500 square feet' is outdated and usually results in buying an oversized AC, which causes short-cycling and humidity problems."
        }
      }
    ]
  })} />

  <!-- Hero Section -->
  <section class="bg-blue-900 text-white py-16 px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl mx-auto text-center">
      <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight mb-6">
        Free <span class="text-blue-300">HVAC Load</span> Calculator
      </h1>
      <div class="mt-8 mb-4 max-w-2xl mx-auto"><AuthorBadge name="Mike Reynolds" role="HVAC Expert" image="/images/mike-reynolds.png" date="June 14, 2026" /></div>
      <div class="text-lg text-blue-100 max-w-3xl mx-auto space-y-4 text-left bg-blue-950/50 p-6 rounded-sm border border-blue-800/50">
        <p>
          This free estimator helps you quickly determine the cooling capacity (BTUs) required for your home. While it uses the foundational square footage method, we've upgraded the math to account for critical variables like insulation quality, sun exposure, and vaulted ceilings.
        </p>
        <p>
          The calculations assume standard operating conditions: an indoor target of 72°F during a 95°F summer peak. Just select your region, enter your home's footprint, and choose your ceiling height.
        </p>
        <p>
          Because manufacturers build residential ACs in half-ton increments (every 6,000 BTUs), our engine automatically rounds your results to match the real-world equipment sizes you'll actually find on the market.
        </p>
        <p class="text-sm text-blue-300 italic">
          Note: This estimator is designed for quick, preliminary sizing. Any square footage-based tool is ultimately a rule of thumb. For exact engineering specifications, a licensed contractor must perform an in-home ACCA Manual J block load calculation.
        </p>
      </div>
    </div>
  </section>

  <!-- Interactive Diagnostic Tool -->
  <section class="py-12 px-4 sm:px-6 lg:px-8 bg-gray-50 relative z-10 -mt-6">
    <div class="max-w-4xl mx-auto bg-white rounded-sm shadow-md border border-gray-200 overflow-hidden">
      
      <!-- App Header -->
      <div class="bg-gray-900 px-6 py-4 flex items-center justify-between">
        <div class="flex items-center gap-3">
          <h2 class="text-white font-bold text-lg">Load Calculation Engine</h2>
        </div>
        <div class="flex gap-1.5">
          <div class="w-3 h-3 rounded-md bg-red-500"></div>
          <div class="w-3 h-3 rounded-md bg-yellow-500"></div>
          <div class="w-3 h-3 rounded-md bg-green-500"></div>
        </div>
      </div>

      <div class="p-6 sm:p-10">
        
        <!-- Dashboard Outputs -->
        <div class="mb-10 p-8 bg-slate-800 rounded-sm border border-slate-700 shadow-inner text-center">
          <h3 class="text-sm font-bold text-cyan-400 uppercase tracking-wider mb-2">Required AC Size</h3>
          <div class="flex flex-col md:flex-row justify-center items-center gap-4 md:gap-12 mt-4">
            <div>
              <span id="tonnageResult" class="text-5xl font-black text-white tracking-tight">3.0</span>
              <span class="text-xl text-slate-400 ml-2 font-bold">Tons</span>
            </div>
            <div class="hidden md:block w-px h-16 bg-slate-700"></div>
            <div>
              <span id="btuResult" class="text-4xl font-black text-white tracking-tight">36,000</span>
              <span class="text-lg text-slate-400 ml-2 font-bold">BTUs</span>
            </div>
          </div>
        </div>

        <!-- Inputs Grid -->
        <div class="space-y-8">
          
          <!-- Square Footage Input -->
          <div>
            <label class="block text-sm font-bold text-gray-700 mb-3 uppercase tracking-wide">1. Home Square Footage</label>
            <div class="relative">
              <input type="number" id="sqftInput" value="2000" min="400" max="10000" class="w-full text-2xl font-bold text-gray-900 py-4 px-6 rounded-sm border-2 border-cyan-500 bg-cyan-50 focus:outline-none focus:ring-4 focus:ring-cyan-500/20 transition-all shadow-sm">
              <div class="absolute inset-y-0 right-0 pr-6 flex items-center pointer-events-none">
                <span class="text-gray-500 font-bold">sq ft</span>
              </div>
            </div>
            <p class="text-xs text-gray-500 mt-2">Enter the square footage of the area you want to cool.</p>
          </div>

          <hr class="border-gray-100">

          <!-- Climate Input -->
          <div>
            <label class="block text-sm font-bold text-gray-700 mb-3 uppercase tracking-wide">2. Climate Zone</label>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
              <button class="climate-btn active py-3 px-4 font-bold rounded-sm border-2 border-cyan-500 bg-cyan-50 text-cyan-700 transition-all shadow-sm" data-val="hot">
                Hot (South/Desert)
              </button>
              <button class="climate-btn py-3 px-4 font-bold rounded-sm border border-gray-200 text-gray-500 hover:border-cyan-500 hover:text-cyan-600 transition-all" data-val="moderate">
                Moderate (Central)
              </button>
              <button class="climate-btn py-3 px-4 font-bold rounded-sm border border-gray-200 text-gray-500 hover:border-cyan-500 hover:text-cyan-600 transition-all" data-val="cold">
                Cold (North)
              </button>
            </div>
            <input type="hidden" id="climateVal" value="hot" />
          </div>

          <!-- Insulation Input -->
          <div>
            <label class="block text-sm font-bold text-gray-700 mb-3 uppercase tracking-wide">3. Insulation Quality</label>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
              <button class="insul-btn py-3 px-4 font-bold rounded-sm border border-gray-200 text-gray-500 hover:border-cyan-500 hover:text-cyan-600 transition-all" data-val="poor">
                Poor (Older Home)
              </button>
              <button class="insul-btn active py-3 px-4 font-bold rounded-sm border-2 border-cyan-500 bg-cyan-50 text-cyan-700 transition-all shadow-sm" data-val="average">
                Average (Standard)
              </button>
              <button class="insul-btn py-3 px-4 font-bold rounded-sm border border-gray-200 text-gray-500 hover:border-cyan-500 hover:text-cyan-600 transition-all" data-val="excellent">
                Excellent (New Build)
              </button>
            </div>
            <input type="hidden" id="insulVal" value="average" />
          </div>

          <!-- Sun Input -->
          <div>
            <label class="block text-sm font-bold text-gray-700 mb-3 uppercase tracking-wide">4. Sun Exposure</label>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
              <button class="sun-btn py-3 px-4 font-bold rounded-sm border border-gray-200 text-gray-500 hover:border-cyan-500 hover:text-cyan-600 transition-all" data-val="shaded">
                Heavy Shade
              </button>
              <button class="sun-btn active py-3 px-4 font-bold rounded-sm border-2 border-cyan-500 bg-cyan-50 text-cyan-700 transition-all shadow-sm" data-val="average">
                Average Windows
              </button>
              <button class="sun-btn py-3 px-4 font-bold rounded-sm border border-gray-200 text-gray-500 hover:border-cyan-500 hover:text-cyan-600 transition-all" data-val="sunny">
                Heavy Sun / Big Windows
              </button>
            </div>
            <input type="hidden" id="sunVal" value="average" />
          </div>

          <!-- Ceiling Height Input -->
          <div>
            <label class="block text-sm font-bold text-gray-700 mb-3 uppercase tracking-wide">5. Ceiling Height</label>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
              <button class="ceiling-btn active py-3 px-4 font-bold rounded-sm border-2 border-cyan-500 bg-cyan-50 text-cyan-700 transition-all shadow-sm" data-val="standard">
                Standard (8 ft)
              </button>
              <button class="ceiling-btn py-3 px-4 font-bold rounded-sm border border-gray-200 text-gray-500 hover:border-cyan-500 hover:text-cyan-600 transition-all" data-val="high">
                High / Vaulted (10+ ft)
              </button>
            </div>
            <input type="hidden" id="ceilingVal" value="standard" />
          </div>

        </div>

      </div>
    </div>
  </section>

  <!-- Skyscraper Content -->
  <section class="py-16 px-4 sm:px-6 lg:px-8 bg-white border-t border-gray-100">
    <div class="max-w-4xl mx-auto space-y-16">
      
      <!-- Section 1: What is an HVAC Load Calculation? -->
      <div>
        <h2 class="text-3xl font-bold text-gray-900 mb-6 flex items-center gap-3">
          What is an HVAC Load Calculation?
        </h2>
        <p class="text-lg text-gray-700 leading-relaxed mb-6">
          An <strong>HVAC Load Calculation</strong> is a mathematical process used to determine the exact heating and cooling capacity (measured in BTUs or Tonnage) required to maintain a comfortable temperature in a building. If you want to know exactly how big your AC needs to be, a formal calculation—often referred to in the industry as a "Manual J"—is the only proven way to find out.
        </p>
        <p class="text-lg text-gray-700 leading-relaxed">
          While professional software requires hundreds of data points (exact wall R-values, duct leakage CFM, etc.), our free HVAC load calculator uses standard industry base multipliers combined with modifiers for insulation, solar load, and ceiling height to give you a highly accurate estimate in seconds.
        </p>
      </div>

      <!-- Section 2: Rule of Thumb vs Manual J -->
      <div>
        <h2 class="text-3xl font-bold text-gray-900 mb-6 flex items-center gap-3">
          Why the "Rule of Thumb" is Terrible
        </h2>
        <div class="bg-red-50 rounded-sm border border-red-200 p-6 mb-6">
          <p class="text-red-900 leading-relaxed font-medium">
            For decades, lazy contractors have used the rule of thumb: <em>"1 Ton of AC for every 500 square feet."</em> This is a terrible method for modern homes.
          </p>
        </div>
        <p class="text-lg text-gray-700 leading-relaxed mb-6">
          A home built in 1960 with single-pane windows in Florida might need 1 Ton per 400 sq ft. But a modern home built in 2024 with spray-foam insulation and double-pane Low-E windows might only need 1 Ton per 800 sq ft. Sizing by square footage alone guarantees you will buy the wrong AC.
        </p>
      </div>

      <!-- Section 3: The Danger of Oversizing -->
      <div>
        <h2 class="text-3xl font-bold text-gray-900 mb-6 flex items-center gap-3">
          <span class="text-cyan-500">️</span> The Dangers of an Oversized AC
        </h2>
        <p class="text-lg text-gray-700 leading-relaxed mb-6">
          Many homeowners think "Bigger is Better" and buy a 5-Ton AC for a home that only needs 3.5 Tons. This is a massive mistake that leads to <strong>Short Cycling</strong>.
        </p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="bg-white p-6 rounded-sm border border-gray-200 shadow-sm">
            <h3 class="text-xl font-bold text-gray-900 mb-2 text-cyan-700">1. The Swamp Effect</h3>
            <p class="text-gray-700 leading-relaxed">An oversized AC blasts cold air so fast that it reaches the set temperature and shuts off in 5 minutes. Because it didn't run long enough to pull humidity out of the air, your house feels like a cold, clammy swamp.</p>
          </div>
          <div class="bg-white p-6 rounded-sm border border-gray-200 shadow-sm">
            <h3 class="text-xl font-bold text-gray-900 mb-2 text-cyan-700">2. Premature Failure</h3>
            <p class="text-gray-700 leading-relaxed">The compressor takes the most damage when it starts up. An AC that turns on and off 10 times an hour will destroy its compressor years before an AC that turns on and runs steadily for 45 minutes.</p>
          </div>
        </div>
      </div>

      <!-- Section 4: FAQs -->
      <div>
        <h2 class="text-3xl font-bold text-gray-900 mb-8 flex items-center gap-3">
          Frequently Asked Questions
        </h2>
        <div class="space-y-4">
          <details class="group bg-gray-50 rounded-sm border border-gray-200 overflow-hidden cursor-pointer open:bg-white open:ring-2 open:ring-cyan-500 open:shadow-md transition-all">
            <summary class="px-6 py-4 font-bold text-gray-900 flex justify-between items-center select-none">
              Is this calculator approved for building permits?
              <span class="text-cyan-500 group-open:rotate-180 transition-transform">▼</span>
            </summary>
            <div class="px-6 pb-4 text-gray-700 leading-relaxed border-t border-gray-100 pt-4">
              No. If you are pulling a permit for new construction or a major remodel, building departments require a strict, code-compliant ACCA Manual J report generated by approved software (like Wrightsoft or Cool Calc). This tool is a simplified estimator designed for homeowners looking for a highly accurate ballpark figure before calling contractors.
            </div>
          </details>

          <details class="group bg-gray-50 rounded-sm border border-gray-200 overflow-hidden cursor-pointer open:bg-white open:ring-2 open:ring-cyan-500 open:shadow-md transition-all">
            <summary class="px-6 py-4 font-bold text-gray-900 flex justify-between items-center select-none">
              Why did two HVAC companies give me different AC sizes?
              <span class="text-cyan-500 group-open:rotate-180 transition-transform">▼</span>
            </summary>
            <div class="px-6 pb-4 text-gray-700 leading-relaxed border-t border-gray-100 pt-4">
              If one company says you need 3 Tons and another says 4 Tons, ask to see their Manual J load calculation. If they didn't do one, they are just guessing based on square footage. Always trust the company that actually takes the time to measure your windows and inspect your insulation.
            </div>
          </details>
        </div>
      </div>

      <!-- Disclaimer Statement -->
      <div class="bg-gray-100 p-6 rounded-sm border border-gray-200 mt-12 text-sm text-gray-500 leading-relaxed">
        <strong>Legal Disclaimer:</strong> The BTU and Tonnage recommendations provided by this tool are estimates intended for educational and preliminary planning purposes. We make no guarantees regarding the absolute accuracy or completeness of these figures for your specific home. Real-world thermal loads are affected by hundreds of hyper-local variables—from duct leakage to specific window U-factors—that an online calculator cannot measure. Before purchasing equipment or modifying your HVAC system, you must consult a licensed HVAC contractor or mechanical engineer to perform an on-site, code-compliant load analysis.
      </div>

    </div>
  </section>

  <!-- Interactive Logic -->
  <script>
    // Elements
    const sqftInput = document.getElementById('sqftInput') as HTMLInputElement;
    const climateBtns = document.querySelectorAll('.climate-btn');
    const insulBtns = document.querySelectorAll('.insul-btn');
    const sunBtns = document.querySelectorAll('.sun-btn');
    const ceilingBtns = document.querySelectorAll('.ceiling-btn');
    
    const climateVal = document.getElementById('climateVal') as HTMLInputElement;
    const insulVal = document.getElementById('insulVal') as HTMLInputElement;
    const sunVal = document.getElementById('sunVal') as HTMLInputElement;
    const ceilingVal = document.getElementById('ceilingVal') as HTMLInputElement;
    
    const tonnageResult = document.getElementById('tonnageResult')!;
    const btuResult = document.getElementById('btuResult')!;

    // Math Constants
    const baseMultipliers = {
      hot: 30,
      moderate: 25,
      cold: 20
    };

    const insulModifiers = {
      poor: 1.15,
      average: 1.0,
      excellent: 0.85
    };

    const sunModifiers = {
      shaded: 0.90,
      average: 1.0,
      sunny: 1.10
    };

    const ceilingModifiers = {
      standard: 1.0,
      high: 1.15
    };

    function calculateLoad() {
      let sqft = parseFloat(sqftInput.value) || 0;
      if (sqft < 0) sqft = 0;

      let cVal = climateVal.value as 'hot' | 'moderate' | 'cold';
      let iVal = insulVal.value as 'poor' | 'average' | 'excellent';
      let sVal = sunVal.value as 'shaded' | 'average' | 'sunny';
      let ceilVal = ceilingVal.value as 'standard' | 'high';

      // Base BTUs based on square footage and climate
      let baseBtu = sqft * baseMultipliers[cVal];

      // Apply modifiers
      let totalBtu = baseBtu * insulModifiers[iVal] * sunModifiers[sVal] * ceilingModifiers[ceilVal];

      // Round BTUs to nearest 100
      let finalBtu = Math.round(totalBtu / 100) * 100;

      // Calculate Tonnage (1 Ton = 12,000 BTUs)
      let rawTonnage = finalBtu / 12000;

      // Standard AC units come in 1.5, 2.0, 2.5, 3.0, 3.5, 4.0, 5.0 sizes
      // We will round to the nearest 0.5
      let roundedTonnage = Math.ceil(rawTonnage * 2) / 2;

      // Min size is usually 1.5 tons for central air
      if (roundedTonnage < 1.5 && sqft > 0) {
        roundedTonnage = 1.5;
      }
      if (sqft === 0) {
        roundedTonnage = 0;
        finalBtu = 0;
      }

      // Update UI
      btuResult.textContent = finalBtu.toLocaleString();
      tonnageResult.textContent = roundedTonnage.toFixed(1);
    }

    // Event Listeners for Pills
    function setupPillGroup(btns: NodeListOf<Element>, hiddenInput: HTMLInputElement) {
      btns.forEach(btn => {
        btn.addEventListener('click', (e) => {
          const target = e.currentTarget as HTMLButtonElement;
          hiddenInput.value = target.getAttribute('data-val') || '';
          
          // Reset styles
          btns.forEach(b => {
            b.className = b.className.replace('active', '').replace('border-2', 'border').replace('border-cyan-500', 'border-gray-200').replace('bg-cyan-50', '').replace('text-cyan-700', 'text-gray-500').replace('shadow-sm', '');
            if(!b.classList.contains('hover:border-cyan-500')) {
                b.classList.add('hover:border-cyan-500', 'hover:text-cyan-600');
            }
          });
          
          // Apply active style
          target.className = target.className.replace('border border-gray-200', 'border-2 border-cyan-500').replace('text-gray-500', 'text-cyan-700').replace('hover:border-cyan-500 hover:text-cyan-600', '');
          target.classList.add('active', 'bg-cyan-50', 'shadow-sm');
          
          calculateLoad();
        });
      });
    }

    setupPillGroup(climateBtns, climateVal);
    setupPillGroup(insulBtns, insulVal);
    setupPillGroup(sunBtns, sunVal);
    setupPillGroup(ceilingBtns, ceilingVal);

    // Event Listener for Number Input
    sqftInput.addEventListener('input', calculateLoad);

    // Initial Calculation
    calculateLoad();
  </script>
</Layout>
