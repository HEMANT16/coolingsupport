---
import Layout from '../../layouts/Layout.astro';
import SEO from '../../components/SEO.astro';

const title = "HVAC Proposal Template | Free PDF Generator & Blank Download";
const description = "Download our free HVAC Proposal template, present Good/Better/Best options, and learn how to streamline your HVAC proposal process to close more deals.";

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "HVAC Proposal Generator",
    "author": { "@type": "Person", "name": "Mike Reynolds" },
    "applicationCategory": "BusinessApplication",
    "operatingSystem": "All",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD"
    },
    "description": "A free interactive tool for HVAC contractors to generate Good, Better, Best sales proposals."
  },
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": "HVAC Proposal Template: How to Present Options & Streamline Your Process",
    "author": {
      "@type": "Organization",
      "name": "Cooling Support"
    },
    "publisher": {
      "@type": "Organization",
      "name": "Cooling Support",
      "logo": {
        "@type": "ImageObject",
        "url": "https://coolingsupport.com/logo.png"
      }
    }
  }
];
import AuthorBadge from '../../components/AuthorBadge.astro';
---

<Layout title={title}>
  <SEO 
    slot="head"
    title={title}
    description={description}
    schema={schema}
  />

  <main class="bg-gray-50 min-h-screen no-print pb-20">
    <!-- Hero Section -->
    <header class="bg-blue-900 text-white py-16 px-4">
      <div class="max-w-6xl mx-auto text-center">
        <span class="text-cyan-400 font-bold tracking-wider uppercase text-sm mb-4 block">B2B Contractor Tools</span>
        <h1 class="text-4xl md:text-6xl font-extrabold mb-6">HVAC Proposal Template</h1>
      <div class="mt-8 mb-4 max-w-2xl mx-auto"><AuthorBadge name="Mike Reynolds" role="HVAC Expert" image="/images/mike-reynolds.png" date="June 14, 2026" /></div>
        <p class="text-xl text-blue-100 max-w-3xl mx-auto mb-8">
          Present professional "Good, Better, Best" options to your clients. Download a blank PDF or fill it out online to generate a branded, customized quote.
        </p>

        <!-- Mode Toggle -->
        <div class="inline-flex bg-white/10 backdrop-blur-sm p-1 rounded-sm shadow-inner mx-auto">
          <button id="btn_mode_online" onclick="setMode('online')" class="px-8 py-3 rounded-sm font-bold text-lg transition-all bg-white text-blue-900 shadow">
             Fill Online & Generate
          </button>
          <button id="btn_mode_blank" onclick="setMode('blank')" class="px-8 py-3 rounded-sm font-bold text-lg transition-all text-white hover:bg-white/10">
             Download Blank PDF
          </button>
        </div>
      </div>
    </header>

    <div class="max-w-7xl mx-auto px-4 py-12">
      
      <!-- BLANK PDF CONTAINER -->
      <div id="blank_container" class="hidden text-center py-24 bg-white rounded-sm shadow-md border border-gray-200">
        <div class="max-w-2xl mx-auto">
          <span class="text-7xl block mb-6"></span>
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Printable Blank Proposal Form</h2>
          <p class="text-gray-600 text-lg mb-10">
            Click below to instantly open the blank, print-ready PDF. Perfect for technicians who prefer to write out their quotes by hand on a clipboard in the field.
          </p>
          <button onclick="printProposal(true)" class="bg-blue-600 hover:bg-blue-700 text-white px-10 py-5 rounded-sm font-bold text-xl shadow-lg transition-transform active:scale-95 flex items-center justify-center gap-3 mx-auto">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
            Download / Print Blank PDF
          </button>
        </div>
      </div>

      <!-- APP CONTAINER -->
      <div id="app_grid" class="grid grid-cols-1 lg:grid-cols-12 gap-8">
        
        <!-- LEFT COLUMN: Editor Form -->
        <div class="lg:col-span-4 bg-white rounded-sm shadow-md p-6 border border-gray-100 h-fit max-h-[1200px] overflow-y-auto no-print">
          <h2 class="text-2xl font-bold text-gray-900 flex items-center gap-2 sticky top-0 bg-white pt-6 pb-4 -mt-6 -mx-6 px-6 z-10 border-b border-gray-200 mb-6 shadow-sm">
            <span></span> Proposal Details
          </h2>
          
          <div class="space-y-6">
            <!-- Company Info -->
            <div class="bg-gray-50 p-4 rounded-sm border border-gray-200">
              <h3 class="font-bold text-gray-700 mb-4">Company Information</h3>
              <div class="space-y-4">
                <div>
                  <label class="block text-sm font-medium text-gray-700 mb-1">Company Logo</label>
                  <input type="file" id="i_logo" accept="image/*" class="w-full border-gray-300 rounded-lg p-1.5 border focus:ring-2 focus:ring-blue-500 text-sm bg-white">
                </div>
                <div>
                  <label class="block text-sm font-medium text-gray-700 mb-1">Company Name</label>
                  <input type="text" id="i_company" class="w-full border-gray-300 rounded-lg p-2 border focus:ring-2 focus:ring-blue-500" placeholder="e.g. Ace Heating & Cooling" value="Ace Heating & Cooling">
                </div>
                <div>
                  <label class="block text-sm font-medium text-gray-700 mb-1">Company Phone</label>
                  <input type="text" id="i_phone" class="w-full border-gray-300 rounded-lg p-2 border focus:ring-2 focus:ring-blue-500" placeholder="(555) 123-4567" value="(555) 123-4567">
                </div>
                <div>
                  <label class="block text-sm font-medium text-gray-700 mb-1">Company Email</label>
                  <input type="email" id="i_email" class="w-full border-gray-300 rounded-lg p-2 border focus:ring-2 focus:ring-blue-500" placeholder="info@acehvac.com" value="info@acehvac.com">
                </div>
                <div>
                  <label class="block text-sm font-medium text-gray-700 mb-1">Date</label>
                  <input type="date" id="i_date" class="w-full border-gray-300 rounded-lg p-2 border focus:ring-2 focus:ring-blue-500">
                </div>
              </div>
            </div>

            <!-- Customer Info -->
            <div class="bg-gray-50 p-4 rounded-sm border border-gray-200">
              <h3 class="font-bold text-gray-700 mb-4">Customer Information</h3>
              <div class="space-y-4">
                <div>
                  <label class="block text-sm font-medium text-gray-700 mb-1">Customer Name</label>
                  <input type="text" id="i_customer" class="w-full border-gray-300 rounded-lg p-2 border focus:ring-2 focus:ring-blue-500" placeholder="John Doe">
                </div>
                <div>
                  <label class="block text-sm font-medium text-gray-700 mb-1">Job Address</label>
                  <input type="text" id="i_address" class="w-full border-gray-300 rounded-lg p-2 border focus:ring-2 focus:ring-blue-500" placeholder="123 Main St, City, ST">
                </div>
              </div>
            </div>

            <!-- Scope of Work -->
            <div class="bg-gray-50 p-4 rounded-sm border border-gray-200">
              <h3 class="font-bold text-gray-700 mb-4">General Scope of Work</h3>
              <textarea id="i_scope" class="w-full border-gray-300 rounded-lg p-2 border text-sm h-24" placeholder="General overview of the project...">Removal and disposal of existing HVAC equipment. Installation of new split system including required electrical whips, disconnects, and condensate piping modifications as required by local code.</textarea>
            </div>

            <!-- Option 1: GOOD -->
            <div class="bg-blue-50 p-4 rounded-sm border border-blue-200">
              <h3 class="font-bold text-blue-900 mb-4">Option 1: GOOD (Budget)</h3>
              <div class="space-y-3">
                <input type="text" id="i_g_name" class="w-full border-gray-300 rounded-lg p-2 border text-sm" placeholder="System Model" value="14 SEER Single-Stage AC">
                <textarea id="i_g_desc" class="w-full border-gray-300 rounded-lg p-2 border text-sm h-16" placeholder="Inclusions...">Includes new condenser pad and 1-year labor warranty.</textarea>
                <div class="flex gap-2">
                  <input type="text" id="i_g_price" class="w-1/2 border-gray-300 rounded-lg p-2 border font-bold" placeholder="Total Price" value="$5,200.00">
                  <input type="text" id="i_g_finance" class="w-1/2 border-gray-300 rounded-lg p-2 border text-sm" placeholder="Financing" value="or $85/mo for 72m">
                </div>
              </div>
            </div>

            <!-- Option 2: BETTER -->
            <div class="bg-cyan-50 p-4 rounded-sm border border-cyan-200">
              <h3 class="font-bold text-cyan-900 mb-4">Option 2: BETTER (Mid-Tier)</h3>
              <div class="space-y-3">
                <input type="text" id="i_b_name" class="w-full border-gray-300 rounded-lg p-2 border text-sm" placeholder="System Model" value="16 SEER Two-Stage AC">
                <textarea id="i_b_desc" class="w-full border-gray-300 rounded-lg p-2 border text-sm h-16" placeholder="Inclusions...">Includes smart thermostat, high-MERV filter cabinet, and 3-year labor warranty.</textarea>
                <div class="flex gap-2">
                  <input type="text" id="i_b_price" class="w-1/2 border-gray-300 rounded-lg p-2 border font-bold" placeholder="Total Price" value="$7,400.00">
                  <input type="text" id="i_b_finance" class="w-1/2 border-gray-300 rounded-lg p-2 border text-sm" placeholder="Financing" value="or $115/mo for 72m">
                </div>
              </div>
            </div>

            <!-- Option 3: BEST -->
            <div class="bg-indigo-50 p-4 rounded-sm border border-indigo-200">
              <h3 class="font-bold text-indigo-900 mb-4">Option 3: BEST (Premium)</h3>
              <div class="space-y-3">
                <input type="text" id="i_p_name" class="w-full border-gray-300 rounded-lg p-2 border text-sm" placeholder="System Model" value="20 SEER Variable Speed Inverter">
                <textarea id="i_p_desc" class="w-full border-gray-300 rounded-lg p-2 border text-sm h-16" placeholder="Inclusions...">Includes 10-year labor warranty, surge protector, and UV light purifier.</textarea>
                <div class="flex gap-2">
                  <input type="text" id="i_p_price" class="w-1/2 border-gray-300 rounded-lg p-2 border font-bold" placeholder="Total Price" value="$10,500.00">
                  <input type="text" id="i_p_finance" class="w-1/2 border-gray-300 rounded-lg p-2 border text-sm" placeholder="Financing" value="or $165/mo for 72m">
                </div>
              </div>
            </div>

            <!-- Terms & Conditions -->
            <div class="bg-gray-50 p-4 rounded-sm border border-gray-200">
              <h3 class="font-bold text-gray-700 mb-4">Terms & Conditions</h3>
              <textarea id="i_terms" class="w-full border-gray-300 rounded-lg p-2 border text-xs h-24" placeholder="Standard terms...">Proposal is valid for 30 days. Payment is due upon completion. Any unforeseen electrical or ductwork repairs discovered during installation will be billed additionally upon customer approval.</textarea>
            </div>

            <div class="pt-4 pb-8">
              <button onclick="printProposal(false)" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-bold py-4 px-6 rounded-sm shadow-lg transition-transform active:scale-95 flex items-center justify-center gap-2">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"></path></svg>
                Print Completed Proposal
              </button>
            </div>

          </div>
        </div>

        <!-- RIGHT COLUMN: Live Preview (Turns into the actual printed page) -->
        <div class="lg:col-span-8 overflow-x-auto">
          <div class="bg-gray-200 p-4 md:p-8 rounded-sm h-fit">
            <p class="text-center text-gray-500 font-medium mb-4 no-print">Live Print Preview (8.5" x 11")</p>
            
            <!-- THE PRINTABLE AREA -->
            <div id="print-area" class="bg-white shadow-md mx-auto w-[800px] min-h-[1050px] p-10 text-gray-900 border border-gray-300 relative text-sm">
              
              <!-- Proposal Header -->
              <div class="flex justify-between items-start border-b-2 border-gray-800 pb-4 mb-6">
                <div class="flex gap-4 items-center">
                  <!-- Logo Placeholder -->
                  <div id="p_logo_container" class="w-16 h-16 bg-gray-200 rounded flex items-center justify-center text-gray-400 font-bold border-2 border-dashed border-gray-300 overflow-hidden">
                    <span id="p_logo_text">LOGO</span>
                    <img id="p_logo_img" src="" class="hidden w-full h-full object-contain" />
                  </div>
                  <div>
                    <h2 id="p_company" class="text-2xl font-black text-blue-900 min-h-[32px]"></h2>
                    <p class="text-gray-600 font-medium text-xs min-h-[16px]">
                      <span id="p_phone"></span> <span class="mx-2">|</span> <span id="p_email"></span>
                    </p>
                  </div>
                </div>
                <div class="text-right">
                  <div class="text-3xl font-black tracking-widest text-gray-800 mb-2">PROPOSAL</div>
                  <p class="font-bold text-gray-600">Date: <span id="p_date" class="font-normal inline-block border-b border-gray-300 min-w-[120px] pb-1 text-center"></span></p>
                </div>
              </div>

              <!-- Customer Info -->
              <div class="grid grid-cols-2 gap-6 mb-6 bg-gray-50 p-4 rounded border border-gray-200">
                <div>
                  <p class="text-xs font-bold text-gray-500 uppercase tracking-wide mb-1">Prepared For</p>
                  <p id="p_customer" class="font-medium h-6 border-b border-gray-300"></p>
                </div>
                <div>
                  <p class="text-xs font-bold text-gray-500 uppercase tracking-wide mb-1">Job Address</p>
                  <p id="p_address" class="font-medium h-6 border-b border-gray-300"></p>
                </div>
              </div>

              <!-- Scope of Work -->
              <div class="mb-6">
                <h3 class="text-sm font-bold bg-gray-800 text-white px-2 py-1 inline-block mb-2 rounded-t">Scope of Work</h3>
                <div class="border border-gray-800 p-3 rounded-b rounded-tr">
                  <p id="p_scope" class="whitespace-pre-wrap text-gray-800 min-h-[40px]"></p>
                </div>
              </div>

              <div class="mb-4">
                <p class="text-gray-700 italic">We are pleased to offer the following options for your HVAC system replacement. Please review and select the option that best fits your comfort needs and budget.</p>
              </div>

              <!-- Options Grid -->
              <div class="space-y-4">
                <!-- Good -->
                <div class="border-2 border-blue-900 rounded overflow-hidden print-avoid-break">
                  <div class="bg-blue-900 text-white px-3 py-2 flex justify-between items-center">
                    <h3 class="font-bold">OPTION 1: GOOD (Budget)</h3>
                    <div class="w-5 h-5 rounded-md border-2 border-white"></div>
                  </div>
                  <div class="p-4">
                    <p id="p_g_name" class="font-bold text-lg mb-1 border-b border-gray-200 pb-1 min-h-[28px]"></p>
                    <p id="p_g_desc" class="text-gray-700 whitespace-pre-wrap min-h-[40px] text-sm"></p>
                    <div class="mt-3 flex justify-between items-end">
                      <p id="p_g_finance" class="text-blue-700 font-medium text-sm italic min-h-[20px]"></p>
                      <div class="text-right">
                        <p class="text-gray-500 text-xs font-bold uppercase">Total Investment</p>
                        <p id="p_g_price" class="text-2xl font-black text-blue-900 min-h-[32px]"></p>
                      </div>
                    </div>
                  </div>
                </div>

                <!-- Better -->
                <div class="border-2 border-cyan-700 rounded overflow-hidden print-avoid-break">
                  <div class="bg-cyan-700 text-white px-3 py-2 flex justify-between items-center">
                    <h3 class="font-bold">OPTION 2: BETTER (Mid-Tier)</h3>
                    <div class="w-5 h-5 rounded-md border-2 border-white"></div>
                  </div>
                  <div class="p-4">
                    <p id="p_b_name" class="font-bold text-lg mb-1 border-b border-gray-200 pb-1 min-h-[28px]"></p>
                    <p id="p_b_desc" class="text-gray-700 whitespace-pre-wrap min-h-[40px] text-sm"></p>
                    <div class="mt-3 flex justify-between items-end">
                      <p id="p_b_finance" class="text-cyan-700 font-medium text-sm italic min-h-[20px]"></p>
                      <div class="text-right">
                        <p class="text-gray-500 text-xs font-bold uppercase">Total Investment</p>
                        <p id="p_b_price" class="text-2xl font-black text-cyan-800 min-h-[32px]"></p>
                      </div>
                    </div>
                  </div>
                </div>

                <!-- Best -->
                <div class="border-2 border-indigo-900 rounded overflow-hidden print-avoid-break">
                  <div class="bg-indigo-900 text-white px-3 py-2 flex justify-between items-center">
                    <h3 class="font-bold">OPTION 3: BEST (Premium)</h3>
                    <div class="w-5 h-5 rounded-md border-2 border-white"></div>
                  </div>
                  <div class="p-4">
                    <p id="p_p_name" class="font-bold text-lg mb-1 border-b border-gray-200 pb-1 min-h-[28px]"></p>
                    <p id="p_p_desc" class="text-gray-700 whitespace-pre-wrap min-h-[40px] text-sm"></p>
                    <div class="mt-3 flex justify-between items-end">
                      <p id="p_p_finance" class="text-indigo-700 font-medium text-sm italic min-h-[20px]"></p>
                      <div class="text-right">
                        <p class="text-gray-500 text-xs font-bold uppercase">Total Investment</p>
                        <p id="p_p_price" class="text-2xl font-black text-indigo-900 min-h-[32px]"></p>
                      </div>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Terms & Conditions -->
              <div class="mt-6 print-avoid-break">
                <p class="text-xs font-bold text-gray-500 uppercase mb-1">Terms & Conditions</p>
                <div class="bg-gray-50 border border-gray-200 p-2 text-xs text-gray-600 rounded">
                  <p id="p_terms" class="whitespace-pre-wrap min-h-[30px]"></p>
                </div>
              </div>

              <!-- Signature Area -->
              <div class="mt-8 grid grid-cols-2 gap-12 print-avoid-break">
                <div>
                  <p class="text-xs font-bold text-gray-500 mb-6">Customer Acceptance Signature</p>
                  <div class="border-b-2 border-gray-800 h-6 mb-2"></div>
                  <p class="text-[10px] text-gray-500">I accept the terms and select the option checked above.</p>
                </div>
                <div>
                  <p class="text-xs font-bold text-gray-500 mb-6">Date</p>
                  <div class="border-b-2 border-gray-800 h-6"></div>
                </div>
              </div>

            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- SEO Skyscraper Content -->
    <article class="max-w-4xl mx-auto px-4 py-16 prose prose-blue lg:prose-lg no-print border-t border-gray-200 mt-12">
      <h2>HVAC Proposal Template: How to Present Options & Streamline Your Process</h2>
      <p>
        First impressions are critically important. In most residential replacements, a project proposal is the first formalized, written communication between your HVAC company and the homeowner. 
      </p>
      <p>
        To consistently create and deliver professionally designed bids that win jobs, we built this free HVAC proposal template. A modern, clean presentation builds instant trust and separates you from "Chuck in a truck" competitors who provide handwritten notes on the back of a business card.
      </p>

      <h3>How to Download and Use Our HVAC Proposal Template</h3>
      <p>
        We offer two ways to use this tool, depending on your workflow:
      </p>
      <ul>
        <li><strong>Download Blank PDF:</strong> If you are old-school and prefer to write out your quotes while sitting in the truck or at the kitchen table, click the "Download Blank PDF" button at the top. This gives you a clean clipboard-ready form.</li>
        <li><strong>Fill Online & Generate:</strong> For a high-end presentation, use the interactive editor. Enter your company information, customer details, and your three pricing tiers. The system automatically injects your data into a beautiful layout. Click "Print Completed Proposal" to save the customized PDF to email to the client.</li>
      </ul>

      <h3>How Presenting Multiple Options Helps Drive HVAC Sales</h3>
      <p>
        If you only provide a homeowner with a single choice, you force them into a rigid "Yes or No" corner. If the single system you quote is out of their budget, their only option is to say "No" and call a competitor.
      </p>
      <p>
        Using a <strong>Good, Better, Best</strong> approach completely changes the psychology of the kitchen-table close. Instead of asking "Do you want this?", you are asking "Which of these three options fits your comfort needs and budget?". 
      </p>
      <p>
        Offering options is a chance to <em>educate</em> rather than <em>sell</em>. It removes the high-pressure sales feeling and empowers the customer to choose.
      </p>

      <h3>How to Create and Present HVAC Proposals</h3>
      <p>
        When building out the tiers in your proposal, make sure the distinction between the options is clear and tangible to the customer:
      </p>
      <ul>
        <li><strong>The Good Option (Budget):</strong> A baseline 14-15 SEER single-stage system. It cools the house reliably but lacks advanced humidity control or smart features.</li>
        <li><strong>The Better Option (Mid-Tier):</strong> A 16-17 SEER two-stage system. This is your "sweet spot." Show the value by including a smart thermostat, a media filter cabinet, and extended labor warranties.</li>
        <li><strong>The Best Option (Premium):</strong> An 18+ SEER variable-speed inverter. Frame this as the ultimate comfort package. Include UV lights, surge protectors, and a 10-year comprehensive warranty.</li>
      </ul>

      <h3>Incorporate Financing Options</h3>
      <p>
        HVAC replacement is expensive. You can drastically ease sticker shock by including monthly financing estimates right on the proposal. Our interactive template includes a dedicated "Financing" sub-field under the total price of each tier. Seeing "$115/month" next to an $8,000 system makes the investment feel significantly more attainable to the average family.
      </p>

      <h3>An Electronic Paper Trail</h3>
      <p>
        Using our digital generator ensures you never lose a handwritten quote again. Simply save the generated PDF to your computer, name it with the customer's address, and you have a permanent digital paper trail that you can easily email, text, or store in your CRM.
      </p>
    </article>
  </main>
</Layout>

<!-- Print Styling & Logic -->
<style>
  .print-avoid-break {
    page-break-inside: avoid;
  }
</style>

<script is:inline>
  // UI Toggle Logic
  function setMode(mode) {
    const btnOnline = document.getElementById('btn_mode_online');
    const btnBlank = document.getElementById('btn_mode_blank');
    const containerBlank = document.getElementById('blank_container');
    const containerApp = document.getElementById('app_grid');

    if (mode === 'online') {
      btnOnline.classList.add('bg-white', 'text-blue-900', 'shadow');
      btnOnline.classList.remove('text-white', 'hover:bg-white/10');
      
      btnBlank.classList.remove('bg-white', 'text-blue-900', 'shadow');
      btnBlank.classList.add('text-white', 'hover:bg-white/10');

      containerBlank.classList.add('hidden');
      containerApp.classList.remove('hidden');
    } else {
      btnBlank.classList.add('bg-white', 'text-blue-900', 'shadow');
      btnBlank.classList.remove('text-white', 'hover:bg-white/10');
      
      btnOnline.classList.remove('bg-white', 'text-blue-900', 'shadow');
      btnOnline.classList.add('text-white', 'hover:bg-white/10');

      containerApp.classList.add('hidden');
      containerBlank.classList.remove('hidden');
    }
  }

  // DOM Elements mapping
  const bindings = [
    { input: 'i_company', display: 'p_company' },
    { input: 'i_phone', display: 'p_phone' },
    { input: 'i_email', display: 'p_email' },
    { input: 'i_date', display: 'p_date' },
    { input: 'i_customer', display: 'p_customer' },
    { input: 'i_address', display: 'p_address' },
    { input: 'i_scope', display: 'p_scope' },
    { input: 'i_terms', display: 'p_terms' },
    
    { input: 'i_g_name', display: 'p_g_name' },
    { input: 'i_g_desc', display: 'p_g_desc' },
    { input: 'i_g_price', display: 'p_g_price' },
    { input: 'i_g_finance', display: 'p_g_finance' },
    
    { input: 'i_b_name', display: 'p_b_name' },
    { input: 'i_b_desc', display: 'p_b_desc' },
    { input: 'i_b_price', display: 'p_b_price' },
    { input: 'i_b_finance', display: 'p_b_finance' },
    
    { input: 'i_p_name', display: 'p_p_name' },
    { input: 'i_p_desc', display: 'p_p_desc' },
    { input: 'i_p_price', display: 'p_p_price' },
    { input: 'i_p_finance', display: 'p_p_finance' }
  ];

  // Set today's date by default
  document.getElementById('i_date').valueAsDate = new Date();
  document.getElementById('p_date').innerText = new Date().toLocaleDateString();

  // Handle Logo Upload
  const logoInput = document.getElementById('i_logo');
  const logoImg = document.getElementById('p_logo_img');
  const logoText = document.getElementById('p_logo_text');
  const logoContainer = document.getElementById('p_logo_container');

  if(logoInput) {
    logoInput.addEventListener('change', function(e) {
      const file = e.target.files[0];
      if (file) {
        const reader = new FileReader();
        reader.onload = function(event) {
          logoImg.src = event.target.result;
          logoImg.classList.remove('hidden');
          logoText.classList.add('hidden');
          logoContainer.classList.remove('bg-gray-200', 'border-2', 'border-dashed', 'border-gray-300');
        }
        reader.readAsDataURL(file);
      } else {
        logoImg.src = "";
        logoImg.classList.add('hidden');
        logoText.classList.remove('hidden');
        logoContainer.classList.add('bg-gray-200', 'border-2', 'border-dashed', 'border-gray-300');
      }
    });
  }

  // Real-time syncing
  bindings.forEach(b => {
    const elIn = document.getElementById(b.input);
    const elOut = document.getElementById(b.display);
    
    if(elIn && elOut) {
      // Sync on init
      if(b.input !== 'i_date') {
        elOut.innerText = elIn.value;
      }

      // Sync on type
      elIn.addEventListener('input', (e) => {
        // Formats date properly
        if(b.input === 'i_date') {
          const d = new Date(e.target.value);
          const userTimezoneOffset = d.getTimezoneOffset() * 60000;
          elOut.innerText = new Date(d.getTime() + userTimezoneOffset).toLocaleDateString();
        } else {
          elOut.innerText = e.target.value;
        }
      });
    }
  });

  // Print function handling both states
  window.printProposal = function(isBlank) {
    const printArea = document.getElementById('print-area');
    
    if (isBlank) {
      printArea.classList.add('is-blank');
      // Temporarily clear the preview DOM elements
      bindings.forEach(b => {
        const elOut = document.getElementById(b.display);
        if(elOut) {
          elOut.setAttribute('data-original', elOut.innerText);
          elOut.innerText = "";
        }
      });
    }

    // Inject bulletproof print CSS
    const style = document.createElement('style');
    style.innerHTML = `
      @media print {
        body > *:not(#print-container) { display: none !important; }
        #print-container { display: block !important; width: 100%; margin: 0; padding: 0; }
        #print-area { box-shadow: none !important; border: none !important; padding: 0 !important; margin: 0 !important; width: 100% !important; }
        
        .is-blank p[id^="p_"] {
          border-bottom: 1px solid #cbd5e1 !important;
          min-height: 1.5rem;
          display: inline-block;
          width: 100%;
        }
        .is-blank p#p_scope, .is-blank p[id$="_desc"], .is-blank p#p_terms {
          border: 1px dashed #cbd5e1 !important;
          min-height: 4rem;
        }
        /* Hide the logo box */
        .is-blank #p_logo_container.bg-gray-200 {
          border: none !important;
          background-color: transparent !important;
        }
        .is-blank #p_logo_container.bg-gray-200 span {
          display: none !important;
        }
        * {
          -webkit-print-color-adjust: exact !important;
          print-color-adjust: exact !important;
        }
      }
    `;
    document.head.appendChild(style);

    // Create a temporary container at the body root
    const printContainer = document.createElement('div');
    printContainer.id = 'print-container';
    
    // Move printArea to the container
    const originalParent = printArea.parentNode;
    const originalNextSibling = printArea.nextSibling;
    printContainer.appendChild(printArea);
    document.body.appendChild(printContainer);

    // Trigger print
    window.print();
    
    // Restore DOM immediately after print dialog opens/closes
    setTimeout(() => {
      if (originalNextSibling) {
        originalParent.insertBefore(printArea, originalNextSibling);
      } else {
        originalParent.appendChild(printArea);
      }
      document.body.removeChild(printContainer);
      document.head.removeChild(style);

      if (isBlank) {
        printArea.classList.remove('is-blank');
        bindings.forEach(b => {
          const elOut = document.getElementById(b.display);
          if(elOut) {
            elOut.innerText = elOut.getAttribute('data-original');
          }
        });
      }
    }, 500);
  }
</script>
